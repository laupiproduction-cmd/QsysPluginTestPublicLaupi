--[[
  Show Control ~ Cue Engine
  ---------------------------------------------------------------------------
  A live-show cue engine for Q-SYS Designer. Up to 30 operator-programmable
  cues, each firing an ORDERED list of actions (reorderable with Move Up/
  Down on the Show Editor page -- array position IS firing order):
    - player_trigger      : invoke a control (e.g. Play/Stop/Cue) on a named
                             Media/Stream Player (or any) component
    - udp_send             : send an ASCII payload to a configured UDP target
    - named_control_set    : set .Value / .Position / .String or :Trigger()
                             on any Named Control of any component
    - wait                 : pause the REST of this cue's actions for a
                             number of seconds (its Value field) before
                             continuing -- everything before it has already
                             fired by the time it's reached; with no wait
                             actions, a cue's actions still dispatch back to
                             back as fast as Lua can loop through them.
    - group                 : invoke a freely-named, reusable bundle of
                             actions defined on the Action Groups page (its
                             Target is the group's name) -- expanded inline,
                             recursively (a group may invoke other groups),
                             with a circular-reference guard at fire time.

  Four pages:
    - Live Show    : status bar, transport, quick-fire cue grid, activity log
    - Devices      : curated list of Q-SYS components ("Devices") and UDP
                     targets -- the ONLY things offered in the Show Editor's/
                     Action Groups' action Target dropdowns (instead of
                     every component in the whole design)
    - Action Groups: pick one reusable group from a dropdown and edit its
                     actions -- same editor as a cue's own actions, in its
                     own bank of controls, invoked from any cue (or another
                     group) via a "group" action
    - Show Editor  : pick one cue from a dropdown and edit it -- name/notes/
                     color/armed/confirm plus its actions, added one at a
                     time via "+ Add Action" -- rather than showing all
                     cues x actions on screen at once

  Also: a latching E-Stop (Toggle, with a schematic input pin) that can
  only be cleared with a separate Clear E-Stop button; an optional design-
  time logo (paste base64 SVG in Properties); a runtime Light/Dark Mode
  toggle that re-skins the transport buttons, cue grid, and status LEDs
  (page/card backgrounds are fixed at design time -- see README); and a
  fifth page, Timecode Show, running a SECOND, independent show driven by
  timecode instead of GO/the cue grid -- a soft-sync clock only (no
  drop-frame, not frame-accurate) -- see README before relying on it for
  anything frame-critical.

  Only documented Q-SYS Lua extensions are used: UdpSocket, Component,
  Controls, Timer, rapidjson, Ping. See README.md for install/config notes
  and a list of flagged assumptions (search this file for "ASSUMPTION").
---------------------------------------------------------------------------]]

PluginInfo = {
  Name = "Show Control~CueEngine",
  Version = "1.8.0",
  Id = "com.yourcompany.showcontrol.cueengine",
  Description = "Live-show cue engine: up to 30 cues, each firing a reorderable, optionally-delayed sequence of actions (player triggers, UDP, named controls, wait, reusable action groups).",
  ShowDebug = true,
}

-- Hard ceilings so a mis-typed Property can never blow the control set up
-- to an unreasonable size.
local HARD_MAX_CUES = 30
local HARD_MAX_ACTIONS = 25
local HARD_MAX_DEVICES = 24
local HARD_MAX_UDP = 12
local HARD_MAX_ACTION_GROUPS = 24
local HARD_MAX_TC_CUES = 30

--=============================================================================
-- Theme: the ONE place to edit this plugin's colors, split into a Light and
-- a Dark palette.
--
-- These RGB triplets feed GetControlLayout (design time): the page
-- background, cards, and every Control's placeholder Color/OffColor. The
-- runtime Dark Mode button (see "if Controls" below) re-skins live Controls
-- with its own hex-string palette derived from these same triplets via
-- RgbToHex, so there's still only one set of numbers to edit -- see the note
-- on ThemeDark below for why the background needs a second, separate switch.
--=============================================================================
local function RgbToHex(rgb)
  return string.format("#%02X%02X%02X", rgb[1], rgb[2], rgb[3])
end

local ThemeLight = {
  PageBg        = { 235, 238, 242 },
  Card          = { 255, 255, 255 },
  Border        = { 213, 219, 226 },
  Muted         = { 226, 230, 235 }, -- subtle row banding
  Text          = { 30, 33, 38 },    -- text sitting directly on PageBg (page titles, etc.)
  Accent        = { 41, 98, 255 },
  Success       = { 24, 160, 90 },
  Warning       = { 214, 140, 20 },
  Danger        = { 206, 42, 51 },
  Neutral       = { 90, 98, 112 },   -- Reset Show / Clear E-Stop button faces
  StatusNeutral = { 110, 118, 128 }, -- status/error LED at rest
  Played        = { 38, 40, 45 },    -- a superseded cue, dimmed well below idle
  CueIdle       = { 70, 82, 97 },    -- a cue button's placeholder color before Init() runs
  TextBoxBg     = { 255, 255, 255 }, -- log/notes/export TextBoxes -- see "NoBackground" note below
}

-- Q-SYS plugin graphics (the page background and card borders) are only
-- ever drawn when GetControlLayout(props) runs at DESIGN TIME -- there is
-- no runtime API for a running plugin to redraw them (see README). So this
-- palette is picked by the "Dark Background (design-time)" Property, not by
-- the runtime DARK MODE button: flip the Property in Designer to actually
-- darken the page background; the button still only re-skins live Controls
-- (transport buttons, cue grid, status LEDs), same as before. Card interiors
-- deliberately stay light in both themes -- every piece of on-card text in
-- this plugin relies on the default (dark) text color, and keeping cards
-- light means none of those ~50 individual Text elements need per-element
-- recoloring. Only the page background, plus the couple of text elements
-- that sit directly on it (page titles, the Action Groups intro line), go
-- dark.
--
-- TextBoxBg is a partial exception: Style="TextBox" controls (the Cue Log,
-- notes views, Export/Import JSON) have NO background-fill property of
-- their own at all (Q-SYS's `Fill` only exists on GroupBox graphics) --
-- only `TextBoxStyle = "NoBackground"` (transparent) or the default opaque
-- style. So each of these is set to NoBackground and given its own GroupBox
-- Fill rectangle placed exactly behind it (the same proven mechanism as
-- card()/pageBackground() -- graphics always render behind every Control,
-- so this is not a new technique). This IS still design-time-only, same as
-- the rest of ThemeDark -- it changes with the Property, not live with the
-- DARK MODE button.
local ThemeDark = {
  PageBg        = { 24, 26, 30 },
  Card          = ThemeLight.Card,
  Border        = { 58, 63, 71 },
  Muted         = ThemeLight.Muted,
  Text          = { 232, 234, 238 },
  Accent        = ThemeLight.Accent,
  Success       = ThemeLight.Success,
  Warning       = ThemeLight.Warning,
  Danger        = ThemeLight.Danger,
  Neutral       = ThemeLight.Neutral,
  StatusNeutral = ThemeLight.StatusNeutral,
  Played        = ThemeLight.Played,
  CueIdle       = ThemeLight.CueIdle,
  TextBoxBg     = { 34, 37, 42 }, -- a touch lighter than PageBg so it reads as its own panel
}

--=============================================================================
-- Design time: Properties
--=============================================================================
function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "Max Cues",
    Type = "integer",
    Min = 1,
    Max = HARD_MAX_CUES,
    Value = HARD_MAX_CUES,
  })
  table.insert(props, {
    Name = "Max Actions Per Cue",
    Type = "integer",
    Min = 1,
    Max = HARD_MAX_ACTIONS,
    Value = 4,
  })
  table.insert(props, {
    Name = "Max Devices",
    Type = "integer",
    Min = 0,
    Max = HARD_MAX_DEVICES,
    Value = 12,
  })
  table.insert(props, {
    Name = "Max Action Groups",
    Type = "integer",
    Min = 0,
    Max = HARD_MAX_ACTION_GROUPS,
    Value = 8,
  })
  table.insert(props, {
    Name = "UDP Targets",
    Type = "integer",
    Min = 0,
    Max = HARD_MAX_UDP,
    Value = 6,
  })
  table.insert(props, {
    Name = "Show Debug",
    Type = "boolean",
    Value = false,
  })
  table.insert(props, {
    Name = "Logo SVG (base64, optional)",
    Type = "string",
    Value = "",
  })
  table.insert(props, {
    Name = "Dark Background (design-time)",
    Type = "boolean",
    Value = false,
  })
  table.insert(props, {
    Name = "Max TC Cues",
    Type = "integer",
    Min = 0,
    Max = HARD_MAX_TC_CUES,
    Value = 16,
  })
  return props
end

--=============================================================================
-- Design time: Controls
--
-- This is a STATIC, fixed-size control set sized only from the Properties
-- above. It never changes at runtime. Note there is no longer a MaxCues x
-- MaxActions grid of action controls -- the Show Editor now has ONE bank of
-- MaxActions action rows that gets repointed at whichever cue is selected,
-- so the control count no longer explodes with cue count.
--=============================================================================
function GetControls(props)
  local maxCues = props["Max Cues"].Value
  local maxActions = props["Max Actions Per Cue"].Value
  local maxDevices = props["Max Devices"].Value
  local maxActionGroups = props["Max Action Groups"].Value
  local numUdp = props["UDP Targets"].Value
  local maxTcCues = props["Max TC Cues"].Value

  local ctrls = {}
  local function add(t) table.insert(ctrls, t) end

  -- Transport / global status -------------------------------------------------
  add({ Name = "GoButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "StopAllButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  -- E-Stop: a latching Toggle (not a momentary Trigger) with a schematic
  -- input pin so it can be driven from outside the plugin (a hardware
  -- E-stop relay, another block's logic, etc). Once engaged it can only be
  -- cleared via ResetPanicButton -- see the runtime EventHandlers below.
  add({ Name = "PanicButton", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Input" })
  add({ Name = "ResetPanicButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "ResetShowButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "DarkModeToggle", ControlType = "Button", ButtonType = "Toggle", Count = 1 })

  add({ Name = "StatusLed", ControlType = "Indicator", IndicatorType = "Status", Count = 1 })
  add({ Name = "StatusText", ControlType = "Text", Count = 1 })
  add({ Name = "StatusStateText", ControlType = "Text", Count = 1 })
  add({ Name = "NextCueText", ControlType = "Text", Count = 1 })
  add({ Name = "ErrorLed", ControlType = "Indicator", IndicatorType = "Status", Count = 1 })
  add({ Name = "ErrorText", ControlType = "Text", Count = 1 })
  add({ Name = "CurrentCueNotesText", ControlType = "Text", Count = 1 })
  add({ Name = "NextCueNotesText", ControlType = "Text", Count = 1 })

  add({ Name = "ShowNameText", ControlType = "Text", Count = 1 })
  add({ Name = "LastModifiedText", ControlType = "Text", Count = 1 })
  add({ Name = "UnsavedLed", ControlType = "Indicator", IndicatorType = "Status", Count = 1 })
  add({ Name = "LockToggle", ControlType = "Button", ButtonType = "Toggle", Count = 1 })

  add({ Name = "GlobalStopControlName", ControlType = "Text", Count = 1 })
  add({ Name = "PanicUdpPayload", ControlType = "Text", Count = 1 })

  -- Optional global fire condition -- applies to every cue in addition to
  -- any per-cue condition. Disabled (not configured) by default.
  add({ Name = "GlobalConditionEnable", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "GlobalConditionTarget", ControlType = "Text", Count = 1 })
  add({ Name = "GlobalConditionControl", ControlType = "Text", Count = 1 })
  add({ Name = "GlobalConditionRequired", ControlType = "Button", ButtonType = "Toggle", Count = 1 })

  -- Hidden persistence control (never placed in GetControlLayout) -------------
  add({ Name = "ShowData", ControlType = "Text", Count = 1 })

  -- Export / Import / Log ------------------------------------------------------
  add({ Name = "ExportData", ControlType = "Text", Count = 1 })
  add({ Name = "ExportButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "ImportData", ControlType = "Text", Count = 1 })
  add({ Name = "ImportButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "ImportErrorText", ControlType = "Text", Count = 1 })
  add({ Name = "CueLogText", ControlType = "Text", Count = 1 })

  -- Devices page: curated component references + UDP targets. These are the
  -- ONLY entries offered in the Show Editor's action Target dropdowns.
  if maxDevices > 0 then
    add({ Name = "DeviceName", ControlType = "Text", Count = maxDevices })
    add({ Name = "DeviceComponent", ControlType = "Text", Count = maxDevices })
  end
  if numUdp > 0 then
    add({ Name = "UdpTargetName", ControlType = "Text", Count = numUdp })
    add({ Name = "UdpTargetIp", ControlType = "Text", Count = numUdp })
    add({ Name = "UdpTargetPort", ControlType = "Knob", ControlUnit = "Integer", Min = 1, Max = 65535, Count = numUdp })
    add({ Name = "UdpTargetStatus", ControlType = "Text", Count = numUdp })
  end

  -- Cue quick-fire grid (Live Show page) ---------------------------------------
  add({ Name = "CueButton", ControlType = "Button", ButtonType = "Trigger", Count = maxCues })

  -- Show Editor: single "currently selected cue" authoring bank ---------------
  add({ Name = "SelectedCue", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditName", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditNotes", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditColor", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditArm", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "CueEditConfirm", ControlType = "Button", ButtonType = "Toggle", Count = 1 })

  -- Optional per-cue fire condition -- OFF by default, never required. When
  -- enabled, the cue only fires if the referenced control's Boolean state
  -- matches the required state (e.g. a Block Controller toggle pressed/not).
  add({ Name = "CueConditionEnable", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "CueConditionTarget", ControlType = "Text", Count = 1 })
  add({ Name = "CueConditionControl", ControlType = "Text", Count = 1 })
  add({ Name = "CueConditionRequired", ControlType = "Button", ButtonType = "Toggle", Count = 1 })

  add({ Name = "AddActionButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })

  add({ Name = "ActionType", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionTarget", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionControl", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionValue", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionValueBool", ControlType = "Button", ButtonType = "Toggle", Count = maxActions })
  add({ Name = "ActionMoveUp", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
  add({ Name = "ActionMoveDown", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
  add({ Name = "ActionRemove", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })

  -- Action Groups: reusable, freely-named bundles of actions (e.g. "Gain
  -- Reset", "Mute All") that a cue can invoke via a "group" action. Same
  -- select-one-and-edit-its-actions pattern as cues, with its own (smaller)
  -- action-editor bank so it never shares controls with the cue editor.
  if maxActionGroups > 0 then
    add({ Name = "SelectedGroup", ControlType = "Text", Count = 1 })
    add({ Name = "GroupEditName", ControlType = "Text", Count = 1 })
    add({ Name = "AddGroupActionButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })

    add({ Name = "GroupActionType", ControlType = "Text", Count = maxActions })
    add({ Name = "GroupActionTarget", ControlType = "Text", Count = maxActions })
    add({ Name = "GroupActionControl", ControlType = "Text", Count = maxActions })
    add({ Name = "GroupActionValue", ControlType = "Text", Count = maxActions })
    add({ Name = "GroupActionValueBool", ControlType = "Button", ButtonType = "Toggle", Count = maxActions })
    add({ Name = "GroupActionMoveUp", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
    add({ Name = "GroupActionMoveDown", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
    add({ Name = "GroupActionRemove", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
  end

  -- Timecode Show: a second, independent show driven by TC instead of GO/the
  -- cue grid -- see the "Timecode Show" page. Still uses the same Devices
  -- and Action Groups as the Live Show. This is a SOFT-SYNC clock (see
  -- README) -- not frame-accurate, no drop-frame support.
  add({ Name = "TcCurrentText", ControlType = "Text", Count = 1 })
  add({ Name = "TcFrameRate", ControlType = "Text", Count = 1 })
  add({ Name = "TcSourceToggle", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "TcRunToggle", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "TcResetClockButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "TcRearmButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "TcStatusText", ControlType = "Text", Count = 1 })
  -- External TC in / out -- schematic pins so another component (a real LTC/
  -- MTC decoder, an external show-control system) can drive this plugin's
  -- clock, or read it back out. Both are plain "HH:MM:SS:FF" strings; see
  -- README for exactly what these pins can and can't do reliably. Never
  -- placed in GetControlLayout (like ShowData) -- a pin needs no on-canvas
  -- widget; UserPin/PinStyle alone puts it on the schematic block.
  add({ Name = "TcInput", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Input" })
  add({ Name = "TcOutput", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })

  if maxTcCues > 0 then
    add({ Name = "TcCueButton", ControlType = "Button", ButtonType = "Trigger", Count = maxTcCues })
    add({ Name = "TcCueLogText", ControlType = "Text", Count = 1 })

    add({ Name = "SelectedTcCue", ControlType = "Text", Count = 1 })
    add({ Name = "TcCueEditName", ControlType = "Text", Count = 1 })
    add({ Name = "TcCueEditTime", ControlType = "Text", Count = 1 })
    add({ Name = "TcCueEditEnabled", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
    add({ Name = "AddTcActionButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })

    add({ Name = "TcActionType", ControlType = "Text", Count = maxActions })
    add({ Name = "TcActionTarget", ControlType = "Text", Count = maxActions })
    add({ Name = "TcActionControl", ControlType = "Text", Count = maxActions })
    add({ Name = "TcActionValue", ControlType = "Text", Count = maxActions })
    add({ Name = "TcActionValueBool", ControlType = "Button", ButtonType = "Toggle", Count = maxActions })
    add({ Name = "TcActionMoveUp", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
    add({ Name = "TcActionMoveDown", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
    add({ Name = "TcActionRemove", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })
  end

  return ctrls
end

--=============================================================================
-- Design time: Pages, icon color/name, and Layout
--=============================================================================
local PageNames = { "Live Show", "Devices", "Action Groups", "Show Editor", "Timecode Show" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetColor(props)
  return { 41, 98, 255 } -- accent blue, shown on the component's schematic icon
end

function GetPrettyName(props)
  return string.format("Show Cue Engine (%d cues)", props["Max Cues"].Value)
end

function GetControlLayout(props)
  local maxCues = props["Max Cues"].Value
  local maxActions = props["Max Actions Per Cue"].Value
  local maxDevices = props["Max Devices"].Value
  local maxActionGroups = props["Max Action Groups"].Value
  local numUdp = props["UDP Targets"].Value
  local maxTcCues = props["Max TC Cues"].Value
  local currentPage = PageNames[props["page_index"].Value]

  local layout = {}
  local graphics = {}

  -- Q-SYS addresses arrayed controls in the layout table as "Name" (Count==1)
  -- or "Name N" (Count>1, 1-based, space-separated) -- NOT "Name[N]".
  local function key(name, count, i)
    if count <= 1 then return name end
    return name .. " " .. i
  end

  -- Shared palette -- sourced from ThemeLight/ThemeDark above (see the
  -- "Dark Background (design-time)" Property), so there's exactly one place
  -- to edit these colors.
  local darkBg = props["Dark Background (design-time)"] and props["Dark Background (design-time)"].Value or false
  local T = darkBg and ThemeDark or ThemeLight
  local PageBg, Card, Border, Muted = T.PageBg, T.Card, T.Border, T.Muted
  local Accent, Success, Warning, Danger = T.Accent, T.Success, T.Warning, T.Danger

  local function pageBackground(w, h)
    graphics[#graphics + 1] = { Type = "GroupBox", Fill = PageBg, StrokeColor = PageBg, StrokeWidth = 0, CornerRadius = 0, Position = { 0, 0 }, Size = { w, h } }
  end

  local function title(text, x, y, w)
    graphics[#graphics + 1] = { Type = "Header", Text = text, Color = T.Text, HTextAlign = "Left", Position = { x, y }, Size = { w, 18 } }
  end

  local function card(x, y, w, h, heading)
    graphics[#graphics + 1] = {
      Type = "GroupBox", Text = heading or "", HTextAlign = "Left",
      Fill = Card, StrokeColor = Border, StrokeWidth = 1, CornerRadius = 8,
      Position = { x, y }, Size = { w, h },
    }
  end

  -- A Style="TextBox" control has no background-fill property of its own
  -- (Fill only exists on GroupBox graphics) -- call this at the SAME
  -- Position/Size as a TextBox layout entry (and set that entry's
  -- TextBoxStyle = "NoBackground") to give it a themed fill, the same way
  -- card() gives its Controls a background.
  local function textBoxBg(x, y, w, h)
    graphics[#graphics + 1] = { Type = "GroupBox", Fill = T.TextBoxBg, StrokeColor = Border, StrokeWidth = 1, CornerRadius = 4, Position = { x, y }, Size = { w, h } }
  end

  if currentPage == "Live Show" then
    ------------------------------------------------------------------------
    -- Page 1: compact operator view -- status, transport, quick-fire grid.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Live", M, 6, 500)

    -- Show strip ------------------------------------------------------------
    card(M, 30, W - 2 * M, 52, "SHOW")
    textBoxBg(28, 48, 260, 20)
    layout["ShowNameText"] = { PrettyName = "Show Name", Style = "Text", Color = T.Text, Position = { 28, 48 }, Size = { 260, 20 } }
    textBoxBg(300, 48, 170, 20)
    layout["LastModifiedText"] = { PrettyName = "Last Modified", Style = "Text", Color = T.Text, Position = { 300, 48 }, Size = { 170, 20 } }
    layout["UnsavedLed"] = { PrettyName = "Unsaved Changes", Style = "Indicator", Position = { 482, 50 }, Size = { 16, 16 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Unsaved", Color = T.Text, FontSize = 9, Position = { 502, 48 }, Size = { 64, 20 } }
    layout["LockToggle"] = {
      PrettyName = "Lock Edits", Style = "Button", ButtonStyle = "Toggle", Legend = "LOCK",
      Color = Warning, CornerRadius = 4, Position = { 800, 46 }, Size = { 88, 24 },
    }

    -- Status ------------------------------------------------------------------
    card(M, 94, W - 2 * M, 56, "STATUS")
    layout["StatusLed"] = { PrettyName = "Status", Style = "Indicator", Position = { 28, 112 }, Size = { 20, 20 } }
    textBoxBg(54, 114, 230, 18)
    layout["StatusText"] = { PrettyName = "Status Text (Cue N: Name)", Style = "Text", Color = T.Text, Position = { 54, 114 }, Size = { 230, 18 } }
    textBoxBg(294, 114, 110, 18)
    layout["StatusStateText"] = { PrettyName = "Status State (Ready/Firing/Error)", Style = "Text", Color = T.Text, Position = { 294, 114 }, Size = { 110, 18 } }
    textBoxBg(414, 114, 220, 18)
    layout["NextCueText"] = { PrettyName = "Next Cue", Style = "Text", Color = T.Text, Position = { 414, 114 }, Size = { 220, 18 } }
    layout["ErrorLed"] = { PrettyName = "Error", Style = "Indicator", Position = { 644, 112 }, Size = { 20, 20 } }
    textBoxBg(670, 114, 218, 18)
    layout["ErrorText"] = { PrettyName = "Error Text", Style = "Text", Color = T.Text, Position = { 670, 114 }, Size = { 218, 18 } }

    -- Transport -----------------------------------------------------------------
    card(M, 162, W - 2 * M, 54, "TRANSPORT")
    layout["GoButton"] = { PrettyName = "Go", Style = "Button", ButtonStyle = "Trigger", Legend = "GO", Color = Success, CornerRadius = 6, Position = { 28, 178 }, Size = { 100, 30 } }
    layout["StopAllButton"] = { PrettyName = "Stop All", Style = "Button", ButtonStyle = "Trigger", Legend = "STOP ALL", Color = Warning, CornerRadius = 6, Position = { 138, 178 }, Size = { 110, 30 } }
    layout["PanicButton"] = {
      PrettyName = "E-Stop (also has an input pin -- see schematic)", Style = "Button", ButtonStyle = "Toggle",
      Legend = "E-STOP", Color = Danger, OffColor = T.Neutral, CornerRadius = 6,
      Position = { 258, 178 }, Size = { 112, 30 },
    }
    layout["ResetPanicButton"] = { PrettyName = "Clear E-Stop", Style = "Button", ButtonStyle = "Trigger", Legend = "CLEAR E-STOP", Color = T.Neutral, CornerRadius = 6, Position = { 380, 178 }, Size = { 118, 30 } }
    layout["ResetShowButton"] = { PrettyName = "Reset Show", Style = "Button", ButtonStyle = "Trigger", Legend = "RESET", Color = T.Neutral, CornerRadius = 6, Position = { 508, 178 }, Size = { 90, 30 } }
    layout["DarkModeToggle"] = {
      PrettyName = "Dark Mode (runtime)", Style = "Button", ButtonStyle = "Toggle",
      Legend = "DARK MODE", Color = { 30, 34, 40 }, OffColor = { 214, 218, 224 }, CornerRadius = 6,
      Position = { 630, 178 }, Size = { 110, 30 },
    }

    -- Current / Next cue notes -- large read-along text for the operator
    -- ("cue words"). Always reflect the last SUCCESSFULLY fired cue and
    -- what's after it, same as the small status-bar Next Cue field.
    local notesY = 162 + 54 + 12
    local notesH = 90
    local notesHalfW = (W - 2 * M - 12) / 2
    card(M, notesY, notesHalfW, notesH, "CURRENT CUE NOTES")
    textBoxBg(M + 14, notesY + 22, notesHalfW - 28, notesH - 36)
    layout["CurrentCueNotesText"] = { PrettyName = "Current Cue Notes", Style = "TextBox", TextBoxStyle = "NoBackground", Color = T.Text, Position = { M + 14, notesY + 22 }, Size = { notesHalfW - 28, notesH - 36 } }
    local notes2X = M + notesHalfW + 12
    card(notes2X, notesY, notesHalfW, notesH, "NEXT CUE NOTES")
    textBoxBg(notes2X + 14, notesY + 22, notesHalfW - 28, notesH - 36)
    layout["NextCueNotesText"] = { PrettyName = "Next Cue Notes", Style = "TextBox", TextBoxStyle = "NoBackground", Color = T.Text, Position = { notes2X + 14, notesY + 22 }, Size = { notesHalfW - 28, notesH - 36 } }

    -- Cue grid (quick-fire) + activity log side-by-side ------------------------
    local gridCols = 6
    local cellW, cellH, gap = 100, 40, 6
    local gridRows = math.ceil(maxCues / gridCols)
    local gridInnerW = gridCols * cellW + (gridCols - 1) * gap
    local gridInnerH = gridRows * cellH + (gridRows - 1) * gap
    local gridCardX, gridCardY = M, notesY + notesH + 12
    local gridCardW = gridInnerW + 28
    local gridCardH = gridInnerH + 44
    card(gridCardX, gridCardY, gridCardW, gridCardH, "CUES  (tap to fire)")
    local gridX, gridY = gridCardX + 14, gridCardY + 30
    for i = 1, maxCues do
      local col = (i - 1) % gridCols
      local row = math.floor((i - 1) / gridCols)
      layout[key("CueButton", maxCues, i)] = {
        PrettyName = string.format("Cue %d~Fire", i),
        Style = "Button", ButtonStyle = "Trigger",
        Legend = tostring(i),
        Color = T.CueIdle,
        CornerRadius = 6,
        Position = { gridX + col * (cellW + gap), gridY + row * (cellH + gap) },
        Size = { cellW, cellH },
      }
    end

    local logCardX = gridCardX + gridCardW + 12
    local logCardW = W - M - logCardX
    card(logCardX, gridCardY, logCardW, gridCardH, "ACTIVITY LOG")
    textBoxBg(logCardX + 14, gridCardY + 30, logCardW - 28, gridCardH - 44)
    layout["CueLogText"] = { PrettyName = "Cue Fire Log", Style = "TextBox", TextBoxStyle = "NoBackground", Color = T.Text, Position = { logCardX + 14, gridCardY + 30 }, Size = { logCardW - 28, gridCardH - 44 } }

    local pageH = gridCardY + gridCardH + M
    pageBackground(W, pageH)

  elseif currentPage == "Devices" then
    ------------------------------------------------------------------------
    -- Page 2: setup -- curated component "Devices" and UDP targets. This is
    -- where you pick from the FULL list of Q-SYS components in the design;
    -- the Show Editor only ever sees the friendly names defined here.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Devices", M, 6, 600)
    local y = 30

    local devH = maxDevices > 0 and (maxDevices * 22 + 34) or 40
    card(M, y, W - 2 * M, devH, "COMPONENTS / DEVICES  (curated -- only these appear as Targets in the Show Editor)")
    if maxDevices > 0 then
      for i = 1, maxDevices do
        local ry = y + 24 + (i - 1) * 22
        textBoxBg(28, ry, 220, 18)
        layout[key("DeviceName", maxDevices, i)] = { PrettyName = string.format("Device %d~Friendly Name", i), Style = "Text", Color = T.Text, Position = { 28, ry }, Size = { 220, 18 } }
        textBoxBg(256, ry, 320, 18)
        layout[key("DeviceComponent", maxDevices, i)] = { PrettyName = string.format("Device %d~Q-SYS Component", i), Style = "ComboBox", Color = T.Text, Position = { 256, ry }, Size = { 320, 18 } }
      end
    else
      graphics[#graphics + 1] = { Type = "Text", Text = "No device slots configured (set the 'Max Devices' Property to add some).", FontSize = 9, Position = { 28, y + 18 }, Size = { 500, 16 } }
    end
    y = y + devH + 12

    local udpH = numUdp > 0 and (numUdp * 22 + 34) or 40
    card(M, y, W - 2 * M, udpH, "UDP TARGETS")
    if numUdp > 0 then
      for i = 1, numUdp do
        local ry = y + 24 + (i - 1) * 22
        textBoxBg(28, ry, 140, 18)
        layout[key("UdpTargetName", numUdp, i)] = { PrettyName = string.format("UDP Target %d~Name", i), Style = "Text", Color = T.Text, Position = { 28, ry }, Size = { 140, 18 } }
        textBoxBg(176, ry, 120, 18)
        layout[key("UdpTargetIp", numUdp, i)] = { PrettyName = string.format("UDP Target %d~IP", i), Style = "Text", Color = T.Text, Position = { 176, ry }, Size = { 120, 18 } }
        layout[key("UdpTargetPort", numUdp, i)] = { PrettyName = string.format("UDP Target %d~Port", i), Style = "TextBox", TextBoxStyle = "Meter", Position = { 304, ry }, Size = { 80, 18 } }
        textBoxBg(392, ry, 200, 18)
        layout[key("UdpTargetStatus", numUdp, i)] = { PrettyName = string.format("UDP Target %d~Status", i), Style = "Text", Color = T.Text, Position = { 392, ry }, Size = { 200, 18 } }
      end
    else
      graphics[#graphics + 1] = { Type = "Text", Text = "No UDP targets configured (set the 'UDP Targets' Property to add some).", FontSize = 9, Position = { 28, y + 18 }, Size = { 500, 16 } }
    end
    y = y + udpH + M

    pageBackground(W, y)

  elseif currentPage == "Action Groups" then
    ------------------------------------------------------------------------
    -- Page 3: reusable, freely-named bundles of actions (e.g. "Gain Reset",
    -- "Mute All") that any cue can invoke via a "group" action (Target =
    -- the group's name here). Same select-one-and-edit pattern as the Show
    -- Editor's cues, with its own action-editor bank -- editing a group
    -- never touches or shares controls with any cue's own actions.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Action Groups", M, 6, 600)
    local y = 30
    graphics[#graphics + 1] = {
      Type = "Text",
      Text = "Define a reusable bundle of actions here, then invoke it from any cue with a 'group' action (Target = the group's name below). Groups can reference other groups too (circular references are rejected at fire time).",
      Color = T.Text, FontSize = 9, Position = { M, y }, Size = { W - 2 * M, 16 },
    }
    y = y + 20

    if maxActionGroups > 0 then
      local rowH = 24
      local editorH = 104 + maxActions * rowH
      card(M, y, W - 2 * M, editorH, "GROUP EDITOR")
      layout["SelectedGroup"] = { PrettyName = "Select Group", Style = "ComboBox", Position = { 28, y + 18 }, Size = { 240, 20 } }
      layout["GroupEditName"] = { PrettyName = "Rename Group", Style = "Text", Position = { 280, y + 18 }, Size = { W - 2 * M - 280 - 14, 20 } }

      graphics[#graphics + 1] = { Type = "Text", Text = "#", FontSize = 8, Position = { 28, y + 46 }, Size = { 20, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Type", FontSize = 8, Position = { 52, y + 46 }, Size = { 98, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Target (device / UDP target / group)", FontSize = 8, Position = { 154, y + 46 }, Size = { 148, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Control", FontSize = 8, Position = { 306, y + 46 }, Size = { 128, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Value (toggle if Boolean; wait = seconds)", FontSize = 8, Position = { 438, y + 46 }, Size = { 140, 12 } }

      local rowsY = y + 60
      for a = 1, maxActions do
        local ry = rowsY + (a - 1) * rowH
        graphics[#graphics + 1] = { Type = "Text", Text = tostring(a) .. ".", FontSize = 9, HTextAlign = "Right", Position = { 28, ry }, Size = { 20, 20 } }
        layout[key("GroupActionType", maxActions, a)] = { PrettyName = string.format("Group Action %d~Type", a), Style = "ComboBox", Position = { 52, ry }, Size = { 98, 20 } }
        layout[key("GroupActionTarget", maxActions, a)] = { PrettyName = string.format("Group Action %d~Target", a), Style = "ComboBox", Position = { 154, ry }, Size = { 148, 20 } }
        layout[key("GroupActionControl", maxActions, a)] = { PrettyName = string.format("Group Action %d~Control", a), Style = "ComboBox", Position = { 306, ry }, Size = { 128, 20 } }
        layout[key("GroupActionValue", maxActions, a)] = { PrettyName = string.format("Group Action %d~Value", a), Style = "Text", Position = { 438, ry }, Size = { 140, 20 } }
        layout[key("GroupActionValueBool", maxActions, a)] = { PrettyName = string.format("Group Action %d~Value (Boolean)", a), Style = "Button", ButtonStyle = "Toggle", Legend = "FALSE", Color = Success, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 438, ry }, Size = { 140, 20 } }
        layout[key("GroupActionMoveUp", maxActions, a)] = { PrettyName = string.format("Group Action %d~Move Up", a), Style = "Button", ButtonStyle = "Trigger", Legend = "^", CornerRadius = 4, Position = { 582, ry }, Size = { 26, 20 } }
        layout[key("GroupActionMoveDown", maxActions, a)] = { PrettyName = string.format("Group Action %d~Move Down", a), Style = "Button", ButtonStyle = "Trigger", Legend = "v", CornerRadius = 4, Position = { 610, ry }, Size = { 26, 20 } }
        layout[key("GroupActionRemove", maxActions, a)] = { PrettyName = string.format("Group Action %d~Remove", a), Style = "Button", ButtonStyle = "Trigger", Legend = "X", Color = Danger, CornerRadius = 4, Position = { 640, ry }, Size = { 26, 20 } }
      end
      layout["AddGroupActionButton"] = { PrettyName = "Add Action to Group", Style = "Button", ButtonStyle = "Trigger", Legend = "+ Add Action", Color = Accent, CornerRadius = 4, Position = { 28, rowsY + maxActions * rowH + 8 }, Size = { 130, 22 } }

      y = y + editorH + M
    else
      graphics[#graphics + 1] = { Type = "Text", Text = "No action group slots configured (set the 'Max Action Groups' Property to add some).", Color = T.Text, FontSize = 9, Position = { M, y }, Size = { 500, 16 } }
      y = y + 40 + M
    end

    pageBackground(W, y)

  elseif currentPage == "Show Editor" then
    ------------------------------------------------------------------------
    -- Page 3: pick a cue from a dropdown, edit only that cue. Actions are
    -- revealed one at a time via "+ Add Action" rather than showing every
    -- action slot for every cue at once.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Show Editor", M, 6, 600)
    local y = 30

    -- Panic / stop settings + optional Global Condition ---------------------------
    -- The Global Condition is optional (off by default) and applies to EVERY
    -- cue in addition to any per-cue condition below -- e.g. a single "show
    -- is live" toggle that must be on before anything can fire.
    card(M, y, W - 2 * M, 82, "GLOBAL SETTINGS (STOP ALL / E-STOP)")
    layout["GlobalStopControlName"] = { PrettyName = "Player Stop Control Name", Style = "Text", Position = { 28, y + 18 }, Size = { 300, 26 } }
    layout["PanicUdpPayload"] = { PrettyName = "E-Stop UDP Payload", Style = "Text", Position = { 344, y + 18 }, Size = { 300, 26 } }
    layout["GlobalConditionEnable"] = { PrettyName = "Global Condition~Enable", Style = "Button", ButtonStyle = "Toggle", Legend = "Global Condition", Color = Accent, CornerRadius = 4, Position = { 28, y + 50 }, Size = { 140, 22 } }
    layout["GlobalConditionTarget"] = { PrettyName = "Global Condition~Target (device)", Style = "ComboBox", Position = { 172, y + 50 }, Size = { 150, 22 } }
    layout["GlobalConditionControl"] = { PrettyName = "Global Condition~Control", Style = "ComboBox", Position = { 326, y + 50 }, Size = { 150, 22 } }
    layout["GlobalConditionRequired"] = { PrettyName = "Global Condition~Required State", Style = "Button", ButtonStyle = "Toggle", Legend = "Must be ON", Color = Success, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 480, y + 50 }, Size = { 110, 22 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Applies to every cue, on top of any per-cue condition below.", FontSize = 8, Position = { 600, y + 53 }, Size = { W - 2 * M - 600 + M, 16 } }
    y = y + 82 + 12

    -- Export / Import -------------------------------------------------------------
    card(M, y, W - 2 * M, 172, "EXPORT / IMPORT SHOW (copy-paste JSON)")
    layout["ExportButton"] = { PrettyName = "Export Show", Style = "Button", ButtonStyle = "Trigger", Legend = "Export", Color = Accent, CornerRadius = 4, Position = { 28, y + 18 }, Size = { 100, 22 } }
    textBoxBg(28, y + 46, 320, 100)
    layout["ExportData"] = { PrettyName = "Export JSON (copy this)", Style = "TextBox", TextBoxStyle = "NoBackground", Color = T.Text, Position = { 28, y + 46 }, Size = { 320, 100 } }
    layout["ImportButton"] = { PrettyName = "Import Show", Style = "Button", ButtonStyle = "Trigger", Legend = "Import", Color = Accent, CornerRadius = 4, Position = { 364, y + 18 }, Size = { 100, 22 } }
    textBoxBg(364, y + 46, 320, 100)
    layout["ImportData"] = { PrettyName = "Import JSON (paste here)", Style = "TextBox", TextBoxStyle = "NoBackground", Color = T.Text, Position = { 364, y + 46 }, Size = { 320, 100 } }
    layout["ImportErrorText"] = { PrettyName = "Import Error", Style = "Text", Position = { 364, y + 150 }, Size = { 320, 18 } }
    graphics[#graphics + 1] = {
      Type = "Text",
      Text = "Export first to see the exact JSON shape. A rejected import never partially overwrites the live show.",
      FontSize = 9, Position = { 700, y + 46 }, Size = { W - 2 * M - 700 + M, 60 },
    }
    y = y + 172 + 12

    -- Cue editor: ONE selected cue at a time -------------------------------------
    -- Action rows can now run up to HARD_MAX_ACTIONS (25) tall. There is no
    -- dedicated "scrollable list" control in the Q-SYS Lua layout API -- like
    -- any component whose canvas is taller than the visible pane, Designer's
    -- own Properties/Schematic panel scrolls it natively, the same mechanism
    -- this page already relied on before. The card is sized to fit every row
    -- so nothing is clipped; scrolling to reach lower rows is expected once
    -- Max Actions Per Cue is set much above the default.
    local rowH = 24
    local editorH = 160 + maxActions * rowH
    card(M, y, W - 2 * M, editorH, "CUE EDITOR  (scrolls with the page once Max Actions Per Cue is large)")
    layout["SelectedCue"] = { PrettyName = "Select Cue", Style = "ComboBox", Position = { 28, y + 18 }, Size = { 240, 20 } }
    layout["CueEditColor"] = { PrettyName = "Cue Color (#RRGGBB)", Style = "Text", Position = { 280, y + 18 }, Size = { 80, 20 } }
    layout["CueEditArm"] = { PrettyName = "Armed", Style = "Button", ButtonStyle = "Toggle", Legend = "Arm", Color = Success, CornerRadius = 4, Position = { 368, y + 18 }, Size = { 56, 20 } }
    layout["CueEditConfirm"] = { PrettyName = "Confirm Before Fire", Style = "Button", ButtonStyle = "Toggle", Legend = "Confirm", Color = Warning, CornerRadius = 4, Position = { 432, y + 18 }, Size = { 74, 20 } }

    layout["CueEditName"] = { PrettyName = "Rename Cue", Style = "Text", Position = { 28, y + 46 }, Size = { 300, 20 } }
    layout["CueEditNotes"] = { PrettyName = "Notes (run sheet)", Style = "Text", Position = { 336, y + 46 }, Size = { W - 2 * M - 336 - 14, 20 } }

    -- Optional per-cue fire condition -- OFF by default; this cue always
    -- fires unless you turn it on. Target/Control/Required only matter (and
    -- are only shown) once Condition is enabled.
    layout["CueConditionEnable"] = { PrettyName = "Cue Condition~Enable", Style = "Button", ButtonStyle = "Toggle", Legend = "Condition", Color = Accent, CornerRadius = 4, Position = { 28, y + 74 }, Size = { 90, 20 } }
    layout["CueConditionTarget"] = { PrettyName = "Cue Condition~Target (device)", Style = "ComboBox", Position = { 122, y + 74 }, Size = { 150, 20 } }
    layout["CueConditionControl"] = { PrettyName = "Cue Condition~Control", Style = "ComboBox", Position = { 276, y + 74 }, Size = { 150, 20 } }
    layout["CueConditionRequired"] = { PrettyName = "Cue Condition~Required State", Style = "Button", ButtonStyle = "Toggle", Legend = "Must be ON", Color = Success, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 430, y + 74 }, Size = { 110, 20 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Optional -- leave Condition off to always allow this cue to fire.", FontSize = 8, Position = { 544, y + 76 }, Size = { W - 2 * M - 544 + M, 16 } }

    graphics[#graphics + 1] = { Type = "Text", Text = "#", FontSize = 8, Position = { 28, y + 102 }, Size = { 20, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Type", FontSize = 8, Position = { 52, y + 102 }, Size = { 98, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Target (device / UDP target)", FontSize = 8, Position = { 154, y + 102 }, Size = { 148, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Control", FontSize = 8, Position = { 306, y + 102 }, Size = { 128, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Value (toggle if Boolean; wait = seconds)", FontSize = 8, Position = { 438, y + 102 }, Size = { 140, 12 } }

    local rowsY = y + 116
    for a = 1, maxActions do
      local ry = rowsY + (a - 1) * rowH
      -- "#" is the action's firing order (1st, 2nd, ...) -- also its array
      -- position, which the Move Up/Down buttons swap directly.
      graphics[#graphics + 1] = { Type = "Text", Text = tostring(a) .. ".", FontSize = 9, HTextAlign = "Right", Position = { 28, ry }, Size = { 20, 20 } }
      layout[key("ActionType", maxActions, a)] = { PrettyName = string.format("Action %d~Type", a), Style = "ComboBox", Position = { 52, ry }, Size = { 98, 20 } }
      layout[key("ActionTarget", maxActions, a)] = { PrettyName = string.format("Action %d~Target", a), Style = "ComboBox", Position = { 154, ry }, Size = { 148, 20 } }
      layout[key("ActionControl", maxActions, a)] = { PrettyName = string.format("Action %d~Control", a), Style = "ComboBox", Position = { 306, ry }, Size = { 128, 20 } }
      -- ActionValue (free text) and ActionValueBool (toggle) occupy the exact
      -- same rect -- only one is ever visible at a time (runtime picks based
      -- on the selected control's discovered Type), so they swap seamlessly.
      layout[key("ActionValue", maxActions, a)] = { PrettyName = string.format("Action %d~Value", a), Style = "Text", Position = { 438, ry }, Size = { 140, 20 } }
      layout[key("ActionValueBool", maxActions, a)] = { PrettyName = string.format("Action %d~Value (Boolean)", a), Style = "Button", ButtonStyle = "Toggle", Legend = "FALSE", Color = Success, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 438, ry }, Size = { 140, 20 } }
      layout[key("ActionMoveUp", maxActions, a)] = { PrettyName = string.format("Action %d~Move Up", a), Style = "Button", ButtonStyle = "Trigger", Legend = "^", CornerRadius = 4, Position = { 582, ry }, Size = { 26, 20 } }
      layout[key("ActionMoveDown", maxActions, a)] = { PrettyName = string.format("Action %d~Move Down", a), Style = "Button", ButtonStyle = "Trigger", Legend = "v", CornerRadius = 4, Position = { 610, ry }, Size = { 26, 20 } }
      layout[key("ActionRemove", maxActions, a)] = { PrettyName = string.format("Action %d~Remove", a), Style = "Button", ButtonStyle = "Trigger", Legend = "X", Color = Danger, CornerRadius = 4, Position = { 640, ry }, Size = { 26, 20 } }
    end
    layout["AddActionButton"] = { PrettyName = "Add Action", Style = "Button", ButtonStyle = "Trigger", Legend = "+ Add Action", Color = Accent, CornerRadius = 4, Position = { 28, rowsY + maxActions * rowH + 8 }, Size = { 130, 22 } }

    y = y + editorH + M
    pageBackground(W, y)

  elseif currentPage == "Timecode Show" then
    ------------------------------------------------------------------------
    -- Page 5: a SECOND, independent show driven by timecode instead of GO/
    -- the cue grid -- still reads the same Devices and Action Groups as the
    -- Live Show. This is a soft-sync clock (Timer-driven tick counting, or
    -- whatever arrives on the TC Input pin) -- not frame-accurate, and only
    -- non-drop 24/25/30fps are offered. See README's "Timecode Show"
    -- section before relying on this for anything frame-critical.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Timecode Show", M, 6, 600)
    local y = 30

    card(M, y, W - 2 * M, 80, "TC TRANSPORT  (soft-sync -- see README before relying on this for anything frame-critical)")
    layout["TcCurrentText"] = { PrettyName = "Current TC", Style = "Text", Position = { 28, y + 18 }, Size = { 180, 26 } }
    layout["TcFrameRate"] = { PrettyName = "Frame Rate (non-drop)", Style = "ComboBox", Position = { 220, y + 18 }, Size = { 80, 26 } }
    layout["TcSourceToggle"] = { PrettyName = "TC Source (off=Internal, on=External pin)", Style = "Button", ButtonStyle = "Toggle", Legend = "EXTERNAL", Color = Accent, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 312, y + 18 }, Size = { 110, 26 } }
    layout["TcRunToggle"] = { PrettyName = "Run (Internal clock only)", Style = "Button", ButtonStyle = "Toggle", Legend = "RUN", Color = Success, CornerRadius = 4, Position = { 434, y + 18 }, Size = { 90, 26 } }
    layout["TcResetClockButton"] = { PrettyName = "Reset Clock to Zero", Style = "Button", ButtonStyle = "Trigger", Legend = "RESET CLOCK", Color = { 90, 98, 112 }, CornerRadius = 4, Position = { 536, y + 18 }, Size = { 120, 26 } }
    layout["TcRearmButton"] = { PrettyName = "Rearm All TC Cues", Style = "Button", ButtonStyle = "Trigger", Legend = "REARM CUES", Color = { 90, 98, 112 }, CornerRadius = 4, Position = { 666, y + 18 }, Size = { 120, 26 } }
    layout["TcStatusText"] = { PrettyName = "TC Status", Style = "Text", Position = { 28, y + 50 }, Size = { W - 2 * M - 28 - 14, 20 } }
    y = y + 80 + 12

    if maxTcCues > 0 then
      local gridCols = 6
      local cellW, cellH, gap = 100, 40, 6
      local gridRows = math.ceil(maxTcCues / gridCols)
      local gridInnerW = gridCols * cellW + (gridCols - 1) * gap
      local gridInnerH = gridRows * cellH + (gridRows - 1) * gap
      local gridCardX, gridCardY = M, y
      local gridCardW = gridInnerW + 28
      local gridCardH = gridInnerH + 44
      card(gridCardX, gridCardY, gridCardW, gridCardH, "TC CUES  (target time; tap to test-fire)")
      local gridX, gridY = gridCardX + 14, gridCardY + 30
      for i = 1, maxTcCues do
        local col = (i - 1) % gridCols
        local row = math.floor((i - 1) / gridCols)
        layout[key("TcCueButton", maxTcCues, i)] = {
          PrettyName = string.format("TC Cue %d~Test Fire", i),
          Style = "Button", ButtonStyle = "Trigger",
          Legend = tostring(i),
          Color = T.CueIdle,
          CornerRadius = 6,
          Position = { gridX + col * (cellW + gap), gridY + row * (cellH + gap) },
          Size = { cellW, cellH },
        }
      end

      local logCardX = gridCardX + gridCardW + 12
      local logCardW = W - M - logCardX
      card(logCardX, gridCardY, logCardW, gridCardH, "TC ACTIVITY LOG")
      textBoxBg(logCardX + 14, gridCardY + 30, logCardW - 28, gridCardH - 44)
      layout["TcCueLogText"] = { PrettyName = "TC Cue Fire Log", Style = "TextBox", TextBoxStyle = "NoBackground", Color = T.Text, Position = { logCardX + 14, gridCardY + 30 }, Size = { logCardW - 28, gridCardH - 44 } }

      y = y + gridCardH + 12

      local rowH = 24
      local editorH = 104 + maxActions * rowH
      card(M, y, W - 2 * M, editorH, "TC CUE EDITOR")
      layout["SelectedTcCue"] = { PrettyName = "Select TC Cue", Style = "ComboBox", Position = { 28, y + 18 }, Size = { 220, 20 } }
      layout["TcCueEditName"] = { PrettyName = "Rename TC Cue", Style = "Text", Position = { 256, y + 18 }, Size = { 220, 20 } }
      layout["TcCueEditTime"] = { PrettyName = "Target Time (HH:MM:SS:FF)", Style = "Text", Position = { 484, y + 18 }, Size = { 110, 20 } }
      layout["TcCueEditEnabled"] = { PrettyName = "Enabled (auto-fires at its time)", Style = "Button", ButtonStyle = "Toggle", Legend = "Enabled", Color = Success, CornerRadius = 4, Position = { 602, y + 18 }, Size = { 90, 20 } }

      graphics[#graphics + 1] = { Type = "Text", Text = "#", FontSize = 8, Position = { 28, y + 46 }, Size = { 20, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Type", FontSize = 8, Position = { 52, y + 46 }, Size = { 98, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Target (device / UDP target / group)", FontSize = 8, Position = { 154, y + 46 }, Size = { 148, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Control", FontSize = 8, Position = { 306, y + 46 }, Size = { 128, 12 } }
      graphics[#graphics + 1] = { Type = "Text", Text = "Value (toggle if Boolean; wait = seconds)", FontSize = 8, Position = { 438, y + 46 }, Size = { 140, 12 } }

      local rowsY = y + 60
      for a = 1, maxActions do
        local ry = rowsY + (a - 1) * rowH
        graphics[#graphics + 1] = { Type = "Text", Text = tostring(a) .. ".", FontSize = 9, HTextAlign = "Right", Position = { 28, ry }, Size = { 20, 20 } }
        layout[key("TcActionType", maxActions, a)] = { PrettyName = string.format("TC Action %d~Type", a), Style = "ComboBox", Position = { 52, ry }, Size = { 98, 20 } }
        layout[key("TcActionTarget", maxActions, a)] = { PrettyName = string.format("TC Action %d~Target", a), Style = "ComboBox", Position = { 154, ry }, Size = { 148, 20 } }
        layout[key("TcActionControl", maxActions, a)] = { PrettyName = string.format("TC Action %d~Control", a), Style = "ComboBox", Position = { 306, ry }, Size = { 128, 20 } }
        layout[key("TcActionValue", maxActions, a)] = { PrettyName = string.format("TC Action %d~Value", a), Style = "Text", Position = { 438, ry }, Size = { 140, 20 } }
        layout[key("TcActionValueBool", maxActions, a)] = { PrettyName = string.format("TC Action %d~Value (Boolean)", a), Style = "Button", ButtonStyle = "Toggle", Legend = "FALSE", Color = Success, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 438, ry }, Size = { 140, 20 } }
        layout[key("TcActionMoveUp", maxActions, a)] = { PrettyName = string.format("TC Action %d~Move Up", a), Style = "Button", ButtonStyle = "Trigger", Legend = "^", CornerRadius = 4, Position = { 582, ry }, Size = { 26, 20 } }
        layout[key("TcActionMoveDown", maxActions, a)] = { PrettyName = string.format("TC Action %d~Move Down", a), Style = "Button", ButtonStyle = "Trigger", Legend = "v", CornerRadius = 4, Position = { 610, ry }, Size = { 26, 20 } }
        layout[key("TcActionRemove", maxActions, a)] = { PrettyName = string.format("TC Action %d~Remove", a), Style = "Button", ButtonStyle = "Trigger", Legend = "X", Color = Danger, CornerRadius = 4, Position = { 640, ry }, Size = { 26, 20 } }
      end
      layout["AddTcActionButton"] = { PrettyName = "Add Action to TC Cue", Style = "Button", ButtonStyle = "Trigger", Legend = "+ Add Action", Color = Accent, CornerRadius = 4, Position = { 28, rowsY + maxActions * rowH + 8 }, Size = { 130, 22 } }

      y = y + editorH + M
    else
      graphics[#graphics + 1] = { Type = "Text", Text = "No TC Cue slots configured (set the 'Max TC Cues' Property to add some).", Color = T.Text, FontSize = 9, Position = { M, y }, Size = { 500, 16 } }
      y = y + 40 + M
    end

    pageBackground(W, y)
  end

  -- Optional logo, top-right corner of every page. Q-SYS plugin graphics
  -- are baked in once by GetControlLayout at design time -- there is no
  -- runtime API for the running plugin to redraw them -- so this is a
  -- fixed image set once in Designer's Properties panel, not something an
  -- operator can change live during a show. Paste raw base64 of the SVG's
  -- XML (no "data:image/svg+xml;base64," prefix). See README for details.
  local logoValue = props["Logo SVG (base64, optional)"] and props["Logo SVG (base64, optional)"].Value or ""
  if logoValue ~= "" then
    graphics[#graphics + 1] = { Type = "Svg", Image = logoValue, Position = { 920 - 16 - 120, 4 }, Size = { 120, 24 } }
  end

  return layout, graphics
end

--=============================================================================
-- Runtime
-- Design-time editing (Designer canvas open, no live Controls table) must
-- never execute runtime logic -- everything below is guarded by `if Controls`.
--=============================================================================
if Controls then

local rapidjson = require("rapidjson")

local MaxCues = Properties["Max Cues"].Value
local MaxActions = Properties["Max Actions Per Cue"].Value
local MaxDevices = Properties["Max Devices"].Value
local MaxActionGroups = Properties["Max Action Groups"].Value
local NumUdp = Properties["UDP Targets"].Value
local DebugOn = Properties["Show Debug"].Value
local MaxTcCues = Properties["Max TC Cues"].Value

local ActionTypes = { "none", "player_trigger", "udp_send", "named_control_set", "wait", "group" }
local ActionTypeSet = {}
for _, t in ipairs(ActionTypes) do ActionTypeSet[t] = true end

-- Derived from the SAME ThemeLight RGB triplets GetControlLayout uses (see
-- the Theme section near the top of this file) via RgbToHex, so there's one
-- set of numbers behind both design-time and runtime colors. The Dark Mode
-- palette below is a deliberately DIMMED version of these (not ThemeDark,
-- which only covers the page background -- see ThemeDark's own comment for
-- why the background needs a separate, design-time-only switch). Light/Dark
-- Mode (see ApplyColorMode below) mutates StateColors' VALUES in place at
-- runtime -- every function below reads through this same table, so nothing
-- needs to be re-wired when the mode changes.
local function DimHex(hex, factor)
  local r = tonumber(hex:sub(2, 3), 16)
  local g = tonumber(hex:sub(4, 5), 16)
  local b = tonumber(hex:sub(6, 7), 16)
  return string.format("#%02X%02X%02X", math.floor(r * factor), math.floor(g * factor), math.floor(b * factor))
end

local LightStateColors = {
  armed = RgbToHex(ThemeLight.Accent),
  firing = RgbToHex(ThemeLight.Warning),
  error = RgbToHex(ThemeLight.Danger),
  ready = RgbToHex(ThemeLight.Success),
  neutral = RgbToHex(ThemeLight.StatusNeutral),
  active = RgbToHex(ThemeLight.Success), -- the one cue currently "live" (persists until another cue fires)
  played = RgbToHex(ThemeLight.Played),  -- a previously-active cue, dimmed well below idle (#465261) so it reads as "done"
}
local DarkStateColors = {}
for k, v in pairs(LightStateColors) do
  DarkStateColors[k] = (k == "played") and v or DimHex(v, 0.55) -- "played" is already near-black
end

local StateColors = {}
for k, v in pairs(LightStateColors) do StateColors[k] = v end

-- The transport buttons' idle faces aren't state-driven like StateColors,
-- so they get their own light/dark pair. E-Stop stays vivid red regardless
-- of mode -- an emergency control should never be dimmed.
local LightButtonColors = {
  GoButton = RgbToHex(ThemeLight.Success),
  StopAllButton = RgbToHex(ThemeLight.Warning),
  ResetShowButton = RgbToHex(ThemeLight.Neutral),
  ResetPanicButton = RgbToHex(ThemeLight.Neutral),
}
local DarkButtonColors = {}
for k, v in pairs(LightButtonColors) do DarkButtonColors[k] = DimHex(v, 0.55) end

-- ----------------------------------------------------------------------------
-- Forward-declared locals so all runtime functions can freely reference each
-- other regardless of definition order.
-- ----------------------------------------------------------------------------
local dbg, MarkDirty, SaveShowData, LoadShowData, ApplyShowTable, BuildShowTable, ValidateShowTable
local ClampActionType, PushUdpTargetToControls
local GetComponent, RebuildComponentCache, AllComponentNameList, DeviceNameList, UdpTargetNameList
local ResolveDeviceComponent, FindControlDescriptor
local RefreshActionTargetChoices, RefreshActionControlChoices, RefreshVisibleActionChoices, RefreshActionValueEditor
local RefreshCueButtonColor, RefreshSelectedCueChoices, RefreshActionRowVisibility
local SelectCue, PushSelectedCueToEditor
local DoPlayerTrigger, DoNamedControlSet, DoUdpSend, DispatchAction, ParseValueSpec
local FindUdpTargetByName, OpenUdpSocket
local SetStatusMessage, SetError, UpdateStatus, LogCueFire
local FireCueNow, OnCueButtonPressed, StopAllPlayers, StartPingHeartbeat, CallAfter
local DispatchCueActions, FinishCueFire, CancelAllPendingWaits, BuildExpandedActionList
local MoveActionUp, MoveActionDown
local FindActionGroupByName, ActionGroupNameList, SelectGroup, PushSelectedGroupToEditor
local RefreshSelectedGroupChoices, RefreshGroupActionRowVisibility
local GroupRefreshActionTargetChoices, GroupRefreshActionControlChoices, GroupRefreshActionValueEditor
local GroupMoveActionUp, GroupMoveActionDown
local EvaluateCondition, CheckCueConditions, PopulateConditionControlChoices
local RefreshConditionEditorVisibility, RefreshGlobalConditionVisibility, PushGlobalConditionToControls
local RefreshCueNotesDisplays, ResetPlaybackState, ResetShow
local ApplyColorMode, EngagePanic, ClearPanic
-- Timecode Show (see the "Timecode Show" page): an independent, TC-driven
-- show sharing Devices/Action Groups with the Live Show but never touching
-- Cues/ActiveCueIndex/etc -- same "own parallel set of functions" approach
-- already used for Action Groups, so nothing here can cross-contaminate the
-- Live Show's state machine.
local TcFramesToString, TcStringToFrames, TcRecomputeAllTargets
local TcApplyFrameRate, TcSetSource, TcSetRunning, TcResetClock, TcRearmAllCues
local TcTickHandler, EvaluateTcCues, RefreshTcCueButtonColor, LogTcCueFire
local TcFireCueNow, TcDispatchCueActions, TcFinishCueFire, TcCancelAllPendingWaits
local TcRefreshActionTargetChoices, TcRefreshActionControlChoices, TcRefreshVisibleActionChoices, TcRefreshActionValueEditor
local TcRefreshSelectedCueChoices, TcRefreshActionRowVisibility, TcMoveActionUp, TcMoveActionDown
local SelectTcCue, PushSelectedTcCueToEditor
local Init

-- ----------------------------------------------------------------------------
-- State
-- ----------------------------------------------------------------------------
local Cues = {}          -- 1..MaxCues -> { name, notes, color, armed, confirm, state, activeActions, actions = {1..MaxActions}, condition }
local Devices = {}       -- 1..MaxDevices -> { name, component } (friendly name -> real Q-SYS component name)
local ActionGroups = {}  -- 1..MaxActionGroups -> { name, activeActions, actions = {1..MaxActions} } (same shape as a cue's own actions)
local SelectedGroupIndex = 1
-- Optional fire conditions: { enabled, target = <device name>, control = <control name>, required = <bool> }.
-- A cue only fires if ALL enabled conditions (Global, then its own) currently
-- read as `required`. Disabled (enabled=false) conditions are always satisfied.
local GlobalCondition = { enabled = false, target = "", control = "", required = true }
local UdpTargets = {}    -- 1..NumUdp  -> { name, ip, port }
local UdpSockets = {}    -- 1..NumUdp  -> UdpSocket object (or nil if never opened / failed)
local ComponentCache = {}-- real component name -> Component handle, or false if resolution failed
local LastFireTime = {}  -- cue index -> os.clock() of last accepted fire (debounce)
local PendingConfirm = {}-- cue index -> os.clock() of first press awaiting confirmation
local CueLog = {}        -- most-recent-first array of log line strings
local SelectedCueIndex = 1
local CurrentCueIndex = 0
local NextCueIndex = 1
local ActiveCueIndex = nil -- the cue whose state=="active"; only advances on a SUCCESSFUL fire
local LastTelemetryUpdate = 0.0
local Loading = true     -- true while Init()/ApplyShowTable()/SelectCue() are pushing data into
                          -- Controls programmatically, so those writes don't re-trigger edit handlers.
local PanicEngaged = false -- true once E-Stop has latched; only ClearPanic() may clear it
-- Runtime Light/Dark Mode preference, persisted with the show. Defaults to
-- match the "Dark Background (design-time)" Property so a fresh boot (no
-- saved show yet) starts visually consistent -- a persisted show's own
-- darkMode value (see ApplyShowTable) always overrides this default.
local DarkMode = Properties["Dark Background (design-time)"] and Properties["Dark Background (design-time)"].Value and true or false
local CurrentStatusKind = "ready" -- "ready"|"firing"|"error"; tracks what StatusLed should show
                                    -- under whichever palette is active, so ApplyColorMode can
                                    -- refresh it without re-deriving current show state
local ErrorActive = false -- tracks what ErrorLed should show (StateColors.error vs .neutral)

-- Timecode Show state. TcCues[i] = { name, targetString ("HH:MM:SS:FF"),
-- targetFrames (number, recomputed whenever TcFrameRate changes), enabled,
-- fired, state, activeActions, actions = {1..MaxActions}, firing, pendingTimer }.
-- Deliberately separate from Cues/ActiveCueIndex -- see the comment above
-- the Tc* forward-declares.
local TcCues = {}
local SelectedTcCueIndex = 1
local TcCueLog = {}
local TcFrameRate = 30      -- fps; only 24/25/30 offered -- no drop-frame (see README)
local TcRunning = false     -- Internal clock running (ignored when TcExternalSource)
local TcExternalSource = false -- false = Internal (Timer-driven), true = TcInput pin drives it
local TcFrameCounter = 0    -- current TC, in total frames since 00:00:00:00
local TcTimer = nil         -- the Timer object driving the internal tick (only :Start()'d while running+internal)

local CONFIRM_WINDOW_MS = 2000
local DEBOUNCE_MS = 150
local TELEMETRY_THROTTLE_MS = 100 -- caps UDP RX status updates at ~10/sec
local CUE_LOG_MAX = 25

--=============================================================================
-- Small helpers
--=============================================================================
dbg = function(fmt, ...)
  if DebugOn then
    print(string.format("[CueEngine] " .. fmt, ...))
  end
end

-- One-shot timer helper built on the confirmed Timer.New()/.EventHandler/:Start()/:Stop()
-- pattern (there is no separate Timer.CallAfter used here, to avoid relying on an
-- unverified API surface). Returns the Timer object so a caller can cancel a
-- pending callback early (e.g. a "wait" action's continuation) via :Stop().
CallAfter = function(fn, seconds)
  local t = Timer.New()
  t.EventHandler = function()
    t:Stop()
    fn()
  end
  t:Start(seconds)
  return t
end

ClampActionType = function(t)
  if ActionTypeSet[t] then return t end
  return "none"
end

ParseValueSpec = function(spec)
  -- named_control_set value syntax: "V:<num>"=.Value  "P:<num>"=.Position (0..1)
  -- "S:<text>"=.String  "B:true"/"B:false"=.Boolean (written by the auto Value
  -- toggle -- see RefreshActionValueEditor)  "T" / "" / anything unrecognized
  -- = :Trigger()
  if spec == nil or spec == "" then return "trigger", nil end
  local upper = spec:upper()
  if upper == "T" or upper == "TRIGGER" then return "trigger", nil end
  local mode, data = spec:match("^([VPSB]):(.*)$")
  if mode == "V" then return "value", tonumber(data)
  elseif mode == "P" then return "position", tonumber(data)
  elseif mode == "S" then return "string", data
  elseif mode == "B" then return "boolean", (data == "true")
  end
  return "trigger", nil
end

--=============================================================================
-- Component / Device resolution
--
-- Devices[] is the curated friendly-name -> real-component-name mapping
-- configured on the Devices page. Actions reference a Device name; this is
-- resolved to a real Q-SYS component name here, then to a live Component
-- handle via GetComponent() -- resolved & cached once, never looked up in
-- the cue-fire path itself.
--=============================================================================
GetComponent = function(name)
  if name == nil or name == "" then return nil end
  if ComponentCache[name] == nil then
    local ok, comp = pcall(Component.New, name)
    ComponentCache[name] = ok and comp or false
  end
  if ComponentCache[name] == false then return nil end
  return ComponentCache[name]
end

ResolveDeviceComponent = function(deviceName)
  for i = 1, MaxDevices do
    if Devices[i].name == deviceName then return Devices[i].component end
  end
  return nil
end

RebuildComponentCache = function()
  local seen = {}
  local function scan(actions, count)
    for a = 1, count do
      local act = actions[a]
      if act.type == "player_trigger" or act.type == "named_control_set" then
        local compName = ResolveDeviceComponent(act.target)
        if compName and compName ~= "" then seen[compName] = true end
      end
    end
  end
  for i = 1, MaxCues do scan(Cues[i].actions, MaxActions) end
  for i = 1, MaxActionGroups do scan(ActionGroups[i].actions, MaxActions) end
  for name, _ in pairs(seen) do
    GetComponent(name)
  end
end

-- The FULL, raw list of every component in the design. Used ONLY to populate
-- the Devices page's "Q-SYS Component" picker -- never surfaced directly in
-- the Show Editor, which only ever sees the curated Devices[] list below.
AllComponentNameList = function()
  local names = {}
  local ok, comps = pcall(Component.GetComponents)
  if ok and type(comps) == "table" then
    for _, c in pairs(comps) do
      if c.Name then table.insert(names, c.Name) end
    end
    table.sort(names)
  end
  return names
end

DeviceNameList = function()
  local names = {}
  for i = 1, MaxDevices do
    if Devices[i].name ~= "" then table.insert(names, Devices[i].name) end
  end
  return names
end

UdpTargetNameList = function()
  local names = {}
  for i = 1, NumUdp do table.insert(names, UdpTargets[i].name) end
  return names
end

FindActionGroupByName = function(name)
  for i = 1, MaxActionGroups do
    if ActionGroups[i].name == name then return ActionGroups[i] end
  end
  return nil
end

ActionGroupNameList = function()
  local names = {}
  for i = 1, MaxActionGroups do
    if ActionGroups[i].name ~= "" then table.insert(names, ActionGroups[i].name) end
  end
  return names
end

RefreshActionTargetChoices = function(a)
  local t = Cues[SelectedCueIndex].actions[a].type
  pcall(function()
    if t == "udp_send" then
      Controls.ActionTarget[a].Choices = UdpTargetNameList()
    elseif t == "player_trigger" or t == "named_control_set" then
      Controls.ActionTarget[a].Choices = DeviceNameList()
    elseif t == "group" then
      Controls.ActionTarget[a].Choices = ActionGroupNameList()
    else
      Controls.ActionTarget[a].Choices = {}
    end
  end)
end

-- Auto-populates the Control dropdown from the LIVE component's own controls.
-- FIX: Component.GetControls() requires the actual Component.New() proxy
-- (what GetComponent() returns / caches), NOT the lightweight descriptor
-- table returned by Component.GetComponents() -- passing the latter is why
-- this previously failed to find any controls, including ones exposed via a
-- component's own GetControls()/pin wiring. Still pcall-wrapped: if this
-- ever doesn't populate for a particular component, ActionControl simply
-- stays a free-typed text field, which always works.
RefreshActionControlChoices = function(a)
  local act = Cues[SelectedCueIndex].actions[a]
  if act.type ~= "player_trigger" and act.type ~= "named_control_set" then return end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return end
  local comp = GetComponent(compName)
  if not comp then return end
  pcall(function()
    local names = {}
    for _, ctrl in ipairs(Component.GetControls(comp)) do
      if ctrl.Name then table.insert(names, ctrl.Name) end
    end
    table.sort(names)
    Controls.ActionControl[a].Choices = names
  end)
end

RefreshVisibleActionChoices = function()
  local c = Cues[SelectedCueIndex]
  for a = 1, c.activeActions do
    RefreshActionTargetChoices(a)
  end
end

-- Looks up one control's descriptor (Name/Value/String/Position/Type/
-- Direction/MinValue/MaxValue/...) on a real component via the same
-- Component.GetControls(proxy) call used above. Used to auto-detect whether
-- a named_control_set action's Value editor should be a Boolean toggle or a
-- free-text field.
FindControlDescriptor = function(compName, controlName)
  local comp = GetComponent(compName)
  if not comp then return nil end
  local ok, list = pcall(Component.GetControls, comp)
  if not ok or type(list) ~= "table" then return nil end
  for _, ctrl in ipairs(list) do
    if ctrl.Name == controlName then return ctrl end
  end
  return nil
end

-- Auto-adjusts the Value editor for action slot `a`: a Boolean toggle for
-- Boolean controls, hidden entirely for Trigger controls or player_trigger
-- (which never has a value), and the plain text field otherwise (also used
-- for udp_send's raw payload). ActionValue and ActionValueBool occupy the
-- same on-screen rect, so only one is ever visible at once.
RefreshActionValueEditor = function(a)
  local act = Cues[SelectedCueIndex].actions[a]
  local showText, showBool = false, false
  if act.type == "udp_send" or act.type == "wait" then
    showText = true
  elseif act.type == "named_control_set" then
    local compName = ResolveDeviceComponent(act.target)
    local desc = nil
    if compName and compName ~= "" and act.control ~= "" then
      desc = FindControlDescriptor(compName, act.control)
    end
    if desc and desc.Type == "Boolean" then
      showBool = true
    elseif desc and desc.Type == "Trigger" then
      showText, showBool = false, false
    else
      showText = true
    end
  end
  pcall(function()
    Controls.ActionValue[a].IsInvisible = not showText
    Controls.ActionValueBool[a].IsInvisible = not showBool
    if showBool then
      local mode, data = ParseValueSpec(act.value)
      local boolVal = (mode == "boolean" and data) or false
      Controls.ActionValueBool[a].Boolean = boolVal
      Controls.ActionValueBool[a].Legend = boolVal and "TRUE" or "FALSE"
      -- Commit the toggle's current (possibly still-default/untouched)
      -- position into the stored action value right away. Without this, a
      -- freshly-detected Boolean action left at its default "off" position
      -- keeps act.value == "" (its untouched default), and ParseValueSpec("")
      -- falls through to "trigger" mode -- so firing it would call :Trigger()
      -- instead of actually setting .Boolean = false, unless the operator
      -- happened to interact with the toggle first. Normalizing here makes
      -- the displayed default state authoritative immediately, with no
      -- toggle interaction required.
      local normalized = boolVal and "B:true" or "B:false"
      if act.value ~= normalized then
        act.value = normalized
        if not Loading then MarkDirty(); SaveShowData() end
      end
    end
  end)
end

--=============================================================================
-- Action Groups editor: exact mirror of the RefreshAction*/Cue action-editor
-- functions above, but bound to the currently SELECTED GROUP and its own
-- GroupAction* controls instead of a cue -- kept as separate functions
-- (rather than parameterizing the cue versions) so editing a group can
-- never accidentally touch cue state or vice versa.
--=============================================================================
GroupRefreshActionTargetChoices = function(a)
  local t = ActionGroups[SelectedGroupIndex].actions[a].type
  pcall(function()
    if t == "udp_send" then
      Controls.GroupActionTarget[a].Choices = UdpTargetNameList()
    elseif t == "player_trigger" or t == "named_control_set" then
      Controls.GroupActionTarget[a].Choices = DeviceNameList()
    elseif t == "group" then
      -- A group can invoke another group (composability) -- excluding
      -- itself from the list here is just a UX nicety; the real circular-
      -- reference guard lives in BuildExpandedActionList at fire time,
      -- since indirect cycles (A -> B -> A) can't be caught this way.
      local names = {}
      for _, n in ipairs(ActionGroupNameList()) do
        if n ~= ActionGroups[SelectedGroupIndex].name then table.insert(names, n) end
      end
      Controls.GroupActionTarget[a].Choices = names
    else
      Controls.GroupActionTarget[a].Choices = {}
    end
  end)
end

GroupRefreshActionControlChoices = function(a)
  local act = ActionGroups[SelectedGroupIndex].actions[a]
  if act.type ~= "player_trigger" and act.type ~= "named_control_set" then return end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return end
  local comp = GetComponent(compName)
  if not comp then return end
  pcall(function()
    local names = {}
    for _, ctrl in ipairs(Component.GetControls(comp)) do
      if ctrl.Name then table.insert(names, ctrl.Name) end
    end
    table.sort(names)
    Controls.GroupActionControl[a].Choices = names
  end)
end

GroupRefreshActionValueEditor = function(a)
  local act = ActionGroups[SelectedGroupIndex].actions[a]
  local showText, showBool = false, false
  if act.type == "udp_send" or act.type == "wait" then
    showText = true
  elseif act.type == "named_control_set" then
    local compName = ResolveDeviceComponent(act.target)
    local desc = nil
    if compName and compName ~= "" and act.control ~= "" then
      desc = FindControlDescriptor(compName, act.control)
    end
    if desc and desc.Type == "Boolean" then
      showBool = true
    elseif desc and desc.Type == "Trigger" then
      showText, showBool = false, false
    else
      showText = true
    end
  end
  pcall(function()
    Controls.GroupActionValue[a].IsInvisible = not showText
    Controls.GroupActionValueBool[a].IsInvisible = not showBool
    if showBool then
      local mode, data = ParseValueSpec(act.value)
      local boolVal = (mode == "boolean" and data) or false
      Controls.GroupActionValueBool[a].Boolean = boolVal
      Controls.GroupActionValueBool[a].Legend = boolVal and "TRUE" or "FALSE"
      local normalized = boolVal and "B:true" or "B:false"
      if act.value ~= normalized then
        act.value = normalized
        if not Loading then MarkDirty(); SaveShowData() end
      end
    end
  end)
end

--=============================================================================
-- Optional fire conditions (Global + per-cue)
--=============================================================================

-- Populates the Target choices (curated Devices, same list used by actions)
-- and, once a Target is picked, the Control choices (auto-discovered from
-- that device's real component via Component.GetControls() -- same fixed
-- lookup used for action Control dropdowns).
PopulateConditionControlChoices = function(targetCtrlName, controlCtrlName, cond)
  pcall(function() Controls[targetCtrlName].Choices = DeviceNameList() end)
  if cond.target == "" then return end
  local compName = ResolveDeviceComponent(cond.target)
  if not compName or compName == "" then return end
  local comp = GetComponent(compName)
  if not comp then return end
  pcall(function()
    local names = {}
    for _, ctrl in ipairs(Component.GetControls(comp)) do
      if ctrl.Name then table.insert(names, ctrl.Name) end
    end
    table.sort(names)
    Controls[controlCtrlName].Choices = names
  end)
end

RefreshGlobalConditionVisibility = function()
  local enabled = GlobalCondition.enabled
  pcall(function()
    Controls.GlobalConditionTarget.IsInvisible = not enabled
    Controls.GlobalConditionControl.IsInvisible = not enabled
    Controls.GlobalConditionRequired.IsInvisible = not enabled
  end)
end

RefreshConditionEditorVisibility = function()
  local enabled = Cues[SelectedCueIndex].condition.enabled
  pcall(function()
    Controls.CueConditionTarget.IsInvisible = not enabled
    Controls.CueConditionControl.IsInvisible = not enabled
    Controls.CueConditionRequired.IsInvisible = not enabled
  end)
end

PushGlobalConditionToControls = function()
  pcall(function()
    Controls.GlobalConditionEnable.Boolean = GlobalCondition.enabled
    Controls.GlobalConditionTarget.String = GlobalCondition.target
    Controls.GlobalConditionControl.String = GlobalCondition.control
    Controls.GlobalConditionRequired.Boolean = GlobalCondition.required
    Controls.GlobalConditionRequired.Legend = GlobalCondition.required and "Must be ON" or "Must be OFF"
  end)
  RefreshGlobalConditionVisibility()
  if GlobalCondition.enabled then
    PopulateConditionControlChoices("GlobalConditionTarget", "GlobalConditionControl", GlobalCondition)
  end
end

-- Reads the CURRENT live state of a condition's referenced control (never
-- the stored show data) and compares it to the required state. A disabled
-- condition always passes. Fully pcall-wrapped: any resolution failure
-- (missing device/component/control) is reported as a specific reason,
-- never a Lua error.
EvaluateCondition = function(cond, label)
  if not cond.enabled then return true, nil end
  if cond.target == "" or cond.control == "" then
    return false, string.format("%s is enabled but not fully configured", label)
  end
  local compName = ResolveDeviceComponent(cond.target)
  if not compName or compName == "" then
    return false, string.format("%s: device not configured: %s", label, cond.target)
  end
  local comp = GetComponent(compName)
  if not comp then
    return false, string.format("%s: component not found: %s", label, compName)
  end
  local ok, val = pcall(function() return comp[cond.control].Boolean end)
  if not ok then
    return false, string.format("%s: could not read %s.%s (%s)", label, compName, cond.control, tostring(val))
  end
  local actual = val and true or false
  if actual ~= cond.required then
    return false, string.format("%s: %s.%s is %s (needs %s)", label, compName, cond.control, tostring(actual), tostring(cond.required))
  end
  return true, nil
end

-- Global condition (if any) must pass, THEN the cue's own condition (if
-- any). Both are optional; a cue with neither configured always fires.
CheckCueConditions = function(i)
  local okG, errG = EvaluateCondition(GlobalCondition, "Global condition")
  if not okG then return false, errG end
  return EvaluateCondition(Cues[i].condition, "Cue condition")
end

--=============================================================================
-- Persistence (rapidjson <-> hidden ShowData string control)
--=============================================================================
BuildShowTable = function()
  local cuesOut = {}
  for i = 1, MaxCues do
    local c = Cues[i]
    local actionsOut = {}
    for a = 1, MaxActions do
      local act = c.actions[a]
      table.insert(actionsOut, { type = act.type, target = act.target, control = act.control, value = act.value })
    end
    table.insert(cuesOut, {
      id = i, name = c.name, notes = c.notes, color = c.color,
      armed = c.armed, confirm = c.confirm, activeActions = c.activeActions,
      actions = actionsOut,
      condition = { enabled = c.condition.enabled, target = c.condition.target, control = c.condition.control, required = c.condition.required },
    })
  end
  local devicesOut = {}
  for i = 1, MaxDevices do
    table.insert(devicesOut, { name = Devices[i].name, component = Devices[i].component })
  end
  local actionGroupsOut = {}
  for i = 1, MaxActionGroups do
    local g = ActionGroups[i]
    local groupActionsOut = {}
    for a = 1, MaxActions do
      local act = g.actions[a]
      table.insert(groupActionsOut, { type = act.type, target = act.target, control = act.control, value = act.value })
    end
    table.insert(actionGroupsOut, { name = g.name, activeActions = g.activeActions, actions = groupActionsOut })
  end
  local udpOut = {}
  for i = 1, NumUdp do
    table.insert(udpOut, { name = UdpTargets[i].name, ip = UdpTargets[i].ip, port = UdpTargets[i].port })
  end
  -- Timecode Show: only AUTHORED content (cue name/time/enabled/actions) and
  -- setup preferences (frame rate, source) persist -- never the running
  -- clock position or fired flags, same "authored vs. playback state"
  -- split as the Live Show (see ResetPlaybackState).
  local tcCuesOut = {}
  for i = 1, MaxTcCues do
    local c = TcCues[i]
    local tcActionsOut = {}
    for a = 1, MaxActions do
      local act = c.actions[a]
      table.insert(tcActionsOut, { type = act.type, target = act.target, control = act.control, value = act.value })
    end
    table.insert(tcCuesOut, { name = c.name, targetString = c.targetString, enabled = c.enabled, activeActions = c.activeActions, actions = tcActionsOut })
  end
  return {
    showName = Controls.ShowNameText.String,
    lastModified = os.date("%Y-%m-%d %H:%M:%S"),
    cues = cuesOut,
    devices = devicesOut,
    actionGroups = actionGroupsOut,
    udpTargets = udpOut,
    globalCondition = { enabled = GlobalCondition.enabled, target = GlobalCondition.target, control = GlobalCondition.control, required = GlobalCondition.required },
    darkMode = DarkMode,
    tc = { frameRate = TcFrameRate, source = (TcExternalSource and "external" or "internal"), cues = tcCuesOut },
  }
end

SaveShowData = function()
  local ok, encoded = pcall(rapidjson.encode, BuildShowTable())
  if ok then
    Controls.ShowData.String = encoded
    pcall(function() Controls.LastModifiedText.String = os.date("%Y-%m-%d %H:%M:%S") end)
  else
    dbg("Failed to encode show data: %s", tostring(encoded))
  end
end

ApplyShowTable = function(data)
  if type(data) ~= "table" then return end
  if data.showName ~= nil then
    pcall(function() Controls.ShowNameText.String = tostring(data.showName) end)
  end
  if type(data.cues) == "table" then
    for i = 1, MaxCues do
      local src = data.cues[i]
      local c = Cues[i]
      if src then
        c.name = tostring(src.name or c.name)
        c.notes = tostring(src.notes or "")
        c.color = tostring(src.color or c.color)
        c.armed = src.armed and true or false
        c.confirm = src.confirm and true or false
        local highestUsed = 0
        for a = 1, MaxActions do
          local srcAct = src.actions and src.actions[a]
          if srcAct then
            c.actions[a] = {
              type = ClampActionType(tostring(srcAct.type or "none")),
              target = tostring(srcAct.target or ""),
              control = tostring(srcAct.control or ""),
              value = tostring(srcAct.value or ""),
            }
          else
            c.actions[a] = { type = "none", target = "", control = "", value = "" }
          end
          if c.actions[a].type ~= "none" then highestUsed = a end
        end
        local aa = tonumber(src.activeActions)
        if aa and aa >= 0 and aa <= MaxActions then
          c.activeActions = math.floor(aa)
        else
          c.activeActions = highestUsed
        end
        if type(src.condition) == "table" then
          c.condition.enabled = src.condition.enabled and true or false
          c.condition.target = tostring(src.condition.target or "")
          c.condition.control = tostring(src.condition.control or "")
          if src.condition.required == nil then
            c.condition.required = true
          else
            c.condition.required = src.condition.required and true or false
          end
        else
          c.condition = { enabled = false, target = "", control = "", required = true }
        end
      end
    end
  end
  if type(data.devices) == "table" then
    for i = 1, MaxDevices do
      local src = data.devices[i]
      if src then
        Devices[i].name = tostring(src.name or Devices[i].name)
        Devices[i].component = tostring(src.component or "")
      end
      pcall(function()
        Controls.DeviceName[i].String = Devices[i].name
        Controls.DeviceComponent[i].String = Devices[i].component
      end)
    end
  end
  if type(data.actionGroups) == "table" then
    for i = 1, MaxActionGroups do
      local src = data.actionGroups[i]
      local g = ActionGroups[i]
      if src then
        g.name = tostring(src.name or g.name)
        local highestUsed = 0
        for a = 1, MaxActions do
          local srcAct = src.actions and src.actions[a]
          if srcAct then
            g.actions[a] = {
              type = ClampActionType(tostring(srcAct.type or "none")),
              target = tostring(srcAct.target or ""),
              control = tostring(srcAct.control or ""),
              value = tostring(srcAct.value or ""),
            }
          else
            g.actions[a] = { type = "none", target = "", control = "", value = "" }
          end
          if g.actions[a].type ~= "none" then highestUsed = a end
        end
        local gaa = tonumber(src.activeActions)
        if gaa and gaa >= 0 and gaa <= MaxActions then
          g.activeActions = math.floor(gaa)
        else
          g.activeActions = highestUsed
        end
      end
    end
  end
  if type(data.udpTargets) == "table" then
    for i = 1, NumUdp do
      local src = data.udpTargets[i]
      if src then
        UdpTargets[i].name = tostring(src.name or UdpTargets[i].name)
        UdpTargets[i].ip = tostring(src.ip or "")
        UdpTargets[i].port = tonumber(src.port) or 0
      end
      PushUdpTargetToControls(i)
    end
  end
  if type(data.globalCondition) == "table" then
    local gc = data.globalCondition
    GlobalCondition.enabled = gc.enabled and true or false
    GlobalCondition.target = tostring(gc.target or "")
    GlobalCondition.control = tostring(gc.control or "")
    if gc.required == nil then
      GlobalCondition.required = true
    else
      GlobalCondition.required = gc.required and true or false
    end
  end

  -- Timecode Show: only authored cue content + setup preferences (frame
  -- rate, source) come from here -- the running clock position and fired
  -- flags are never restored (see BuildShowTable's comment; TcResetClock/
  -- TcRearmAllCues below always start a loaded show at a clean 00:00:00:00).
  local tcFrameRate, tcSource = 30, false
  if type(data.tc) == "table" then
    local tc = data.tc
    if type(tc.cues) == "table" then
      for i = 1, MaxTcCues do
        local src = tc.cues[i]
        local c = TcCues[i]
        if src then
          c.name = tostring(src.name or c.name)
          c.targetString = tostring(src.targetString or c.targetString)
          c.enabled = src.enabled and true or false
          local highestUsed = 0
          for a = 1, MaxActions do
            local srcAct = src.actions and src.actions[a]
            if srcAct then
              c.actions[a] = {
                type = ClampActionType(tostring(srcAct.type or "none")),
                target = tostring(srcAct.target or ""),
                control = tostring(srcAct.control or ""),
                value = tostring(srcAct.value or ""),
              }
            else
              c.actions[a] = { type = "none", target = "", control = "", value = "" }
            end
            if c.actions[a].type ~= "none" then highestUsed = a end
          end
          local taa = tonumber(src.activeActions)
          if taa and taa >= 0 and taa <= MaxActions then
            c.activeActions = math.floor(taa)
          else
            c.activeActions = highestUsed
          end
        end
      end
    end
    local fr = tonumber(tc.frameRate)
    if fr == 24 or fr == 25 or fr == 30 then tcFrameRate = fr end
    tcSource = (tc.source == "external")
  end

  local wasLoading = Loading
  Loading = true
  PushGlobalConditionToControls()
  -- Reset playback position too: an imported/reloaded show shouldn't carry
  -- over stale active/played highlighting or current/next pointers from
  -- whatever was showing before.
  ResetPlaybackState()
  RefreshSelectedCueChoices()
  SelectedCueIndex = 1
  PushSelectedCueToEditor()
  RefreshSelectedGroupChoices()
  SelectedGroupIndex = 1
  PushSelectedGroupToEditor()
  local dm = data.darkMode and true or false
  pcall(function() Controls.DarkModeToggle.Boolean = dm end)
  ApplyColorMode(dm)

  TcApplyFrameRate(tcFrameRate) -- also recomputes every TC cue's targetFrames/targetString
  TcSetSource(tcSource)
  pcall(function()
    Controls.TcFrameRate.String = tostring(TcFrameRate)
    Controls.TcSourceToggle.Boolean = TcExternalSource
    Controls.TcRunToggle.Boolean = false
  end)
  TcResetClock()
  TcRearmAllCues()
  TcRefreshSelectedCueChoices()
  SelectedTcCueIndex = 1
  PushSelectedTcCueToEditor()

  Loading = wasLoading
end

LoadShowData = function()
  local raw = Controls.ShowData.String
  if raw ~= nil and raw ~= "" then
    local ok, data = pcall(rapidjson.decode, raw)
    if ok and type(data) == "table" then
      ApplyShowTable(data)
      dbg("Loaded show data from persisted ShowData control")
      return true
    else
      dbg("Failed to decode persisted ShowData: %s", tostring(data))
    end
  end
  return false
end

-- Strict validation used only for operator-triggered Import (never for the
-- boot-time load above, which trusts its own previously-saved data). Rejects
-- with a clear message and commits nothing on any invalid input.
ValidateShowTable = function(data)
  if type(data) ~= "table" then return false, "Import data is not a JSON object" end
  if data.cues ~= nil then
    if type(data.cues) ~= "table" then return false, "'cues' must be an array" end
    if #data.cues > MaxCues then
      return false, string.format("Too many cues: %d (max %d)", #data.cues, MaxCues)
    end
    for i, c in ipairs(data.cues) do
      if type(c) ~= "table" then return false, string.format("Cue %d is not an object", i) end
      if c.activeActions ~= nil then
        local aa = tonumber(c.activeActions)
        if not aa or aa < 0 or aa > MaxActions then
          return false, string.format("Cue %d has invalid activeActions: %s", i, tostring(c.activeActions))
        end
      end
      if c.condition ~= nil and type(c.condition) ~= "table" then
        return false, string.format("Cue %d 'condition' must be an object", i)
      end
      if c.actions ~= nil then
        if type(c.actions) ~= "table" then return false, string.format("Cue %d 'actions' must be an array", i) end
        if #c.actions > MaxActions then
          return false, string.format("Cue %d has too many actions: %d (max %d)", i, #c.actions, MaxActions)
        end
        for j, act in ipairs(c.actions) do
          if type(act) ~= "table" then return false, string.format("Cue %d action %d is not an object", i, j) end
          if act.type ~= nil and not ActionTypeSet[act.type] then
            return false, string.format("Cue %d action %d has invalid type: %s", i, j, tostring(act.type))
          end
        end
      end
    end
  end
  if data.devices ~= nil then
    if type(data.devices) ~= "table" then return false, "'devices' must be an array" end
    if #data.devices > MaxDevices then
      return false, string.format("Too many devices: %d (max %d)", #data.devices, MaxDevices)
    end
    for i, d in ipairs(data.devices) do
      if type(d) ~= "table" then return false, string.format("Device %d is not an object", i) end
    end
  end
  if data.actionGroups ~= nil then
    if type(data.actionGroups) ~= "table" then return false, "'actionGroups' must be an array" end
    if #data.actionGroups > MaxActionGroups then
      return false, string.format("Too many action groups: %d (max %d)", #data.actionGroups, MaxActionGroups)
    end
    for i, g in ipairs(data.actionGroups) do
      if type(g) ~= "table" then return false, string.format("Action group %d is not an object", i) end
      if g.activeActions ~= nil then
        local gaa = tonumber(g.activeActions)
        if not gaa or gaa < 0 or gaa > MaxActions then
          return false, string.format("Action group %d has invalid activeActions: %s", i, tostring(g.activeActions))
        end
      end
      if g.actions ~= nil then
        if type(g.actions) ~= "table" then return false, string.format("Action group %d 'actions' must be an array", i) end
        if #g.actions > MaxActions then
          return false, string.format("Action group %d has too many actions: %d (max %d)", i, #g.actions, MaxActions)
        end
        for j, act in ipairs(g.actions) do
          if type(act) ~= "table" then return false, string.format("Action group %d action %d is not an object", i, j) end
          if act.type ~= nil and not ActionTypeSet[act.type] then
            return false, string.format("Action group %d action %d has invalid type: %s", i, j, tostring(act.type))
          end
        end
      end
    end
  end
  if data.udpTargets ~= nil then
    if type(data.udpTargets) ~= "table" then return false, "'udpTargets' must be an array" end
    if #data.udpTargets > NumUdp then
      return false, string.format("Too many UDP targets: %d (max %d)", #data.udpTargets, NumUdp)
    end
    for i, t in ipairs(data.udpTargets) do
      if type(t) ~= "table" then return false, string.format("UDP target %d is not an object", i) end
      if t.ip ~= nil and t.ip ~= "" and not tostring(t.ip):match("^%d+%.%d+%.%d+%.%d+$") then
        return false, string.format("UDP target %d has invalid IP: %s", i, tostring(t.ip))
      end
      -- Port 0 is the sentinel for "not yet configured" (used by never-set-up
      -- default targets), so it is only validated once an IP is also present.
      if t.port ~= nil and t.ip ~= nil and t.ip ~= "" then
        local p = tonumber(t.port)
        if not p or p < 1 or p > 65535 then
          return false, string.format("UDP target %d has invalid port: %s", i, tostring(t.port))
        end
      end
    end
  end
  if data.globalCondition ~= nil and type(data.globalCondition) ~= "table" then
    return false, "'globalCondition' must be an object"
  end
  return true
end

PushUdpTargetToControls = function(i)
  local t = UdpTargets[i]
  pcall(function()
    Controls.UdpTargetName[i].String = t.name
    Controls.UdpTargetIp[i].String = t.ip
    Controls.UdpTargetPort[i].Value = t.port
  end)
end

--=============================================================================
-- Cue editor: select-one-cue-at-a-time UI
--=============================================================================
RefreshSelectedCueChoices = function()
  local list = {}
  for i = 1, MaxCues do table.insert(list, string.format("%d: %s", i, Cues[i].name)) end
  pcall(function() Controls.SelectedCue.Choices = list end)
end

RefreshActionRowVisibility = function()
  local c = Cues[SelectedCueIndex]
  for a = 1, MaxActions do
    local visible = a <= c.activeActions
    pcall(function()
      Controls.ActionType[a].IsInvisible = not visible
      Controls.ActionTarget[a].IsInvisible = not visible
      Controls.ActionControl[a].IsInvisible = not visible
      Controls.ActionMoveUp[a].IsInvisible = not visible
      Controls.ActionMoveDown[a].IsInvisible = not visible
      Controls.ActionRemove[a].IsInvisible = not visible
    end)
    if visible then
      -- Active row: let RefreshActionValueEditor decide Value vs. Value(Boolean).
      RefreshActionValueEditor(a)
      pcall(function()
        Controls.ActionMoveUp[a].IsDisabled = (a <= 1)
        Controls.ActionMoveDown[a].IsDisabled = (a >= c.activeActions)
      end)
    else
      pcall(function()
        Controls.ActionValue[a].IsInvisible = true
        Controls.ActionValueBool[a].IsInvisible = true
      end)
    end
  end
  pcall(function() Controls.AddActionButton.IsDisabled = (c.activeActions >= MaxActions) end)
end

-- Reorders actions within the SELECTED cue by swapping adjacent slots --
-- array position IS firing order, so this is the entire implementation;
-- persistence/export/import already just walk the actions array in order.
MoveActionUp = function(a)
  if a <= 1 then return end
  local acts = Cues[SelectedCueIndex].actions
  acts[a], acts[a - 1] = acts[a - 1], acts[a]
  PushSelectedCueToEditor()
  MarkDirty(); SaveShowData()
end

MoveActionDown = function(a)
  local c = Cues[SelectedCueIndex]
  if a >= c.activeActions then return end
  local acts = c.actions
  acts[a], acts[a + 1] = acts[a + 1], acts[a]
  PushSelectedCueToEditor()
  MarkDirty(); SaveShowData()
end

PushSelectedCueToEditor = function()
  local c = Cues[SelectedCueIndex]
  pcall(function()
    Controls.SelectedCue.String = string.format("%d: %s", SelectedCueIndex, c.name)
    Controls.CueEditName.String = c.name
    Controls.CueEditNotes.String = c.notes
    Controls.CueEditColor.String = c.color
    Controls.CueEditArm.Boolean = c.armed
    Controls.CueEditConfirm.Boolean = c.confirm
    Controls.CueConditionEnable.Boolean = c.condition.enabled
    Controls.CueConditionTarget.String = c.condition.target
    Controls.CueConditionControl.String = c.condition.control
    Controls.CueConditionRequired.Boolean = c.condition.required
    Controls.CueConditionRequired.Legend = c.condition.required and "Must be ON" or "Must be OFF"
  end)
  RefreshConditionEditorVisibility()
  if c.condition.enabled then
    PopulateConditionControlChoices("CueConditionTarget", "CueConditionControl", c.condition)
  end
  for a = 1, MaxActions do
    local act = c.actions[a]
    pcall(function()
      Controls.ActionType[a].String = act.type
      Controls.ActionTarget[a].String = act.target
      Controls.ActionControl[a].String = act.control
      Controls.ActionValue[a].String = act.value
    end)
    RefreshActionTargetChoices(a)
    RefreshActionControlChoices(a)
  end
  RefreshActionRowVisibility()
end

SelectCue = function(i)
  if i < 1 or i > MaxCues then return end
  SelectedCueIndex = i
  local wasLoading = Loading
  Loading = true
  PushSelectedCueToEditor()
  Loading = wasLoading
end

--=============================================================================
-- Action Groups: select-one-and-edit, exact mirror of the cue editor
-- functions above. Every one of these guards on MaxActionGroups <= 0 and
-- returns immediately, since GetControls only declares the Group* controls
-- when Max Action Groups > 0 -- with it at 0, Controls.SelectedGroup etc.
-- simply don't exist, and this file's usual pcall-per-control-access
-- pattern isn't enough by itself to protect a bare `Controls.X[i]` index
-- done outside a pcall (e.g. in the EventHandler-wiring loops below).
--=============================================================================
RefreshSelectedGroupChoices = function()
  if MaxActionGroups <= 0 then return end
  local list = {}
  for i = 1, MaxActionGroups do table.insert(list, string.format("%d: %s", i, ActionGroups[i].name)) end
  pcall(function() Controls.SelectedGroup.Choices = list end)
end

RefreshGroupActionRowVisibility = function()
  if MaxActionGroups <= 0 then return end
  local g = ActionGroups[SelectedGroupIndex]
  for a = 1, MaxActions do
    local visible = a <= g.activeActions
    pcall(function()
      Controls.GroupActionType[a].IsInvisible = not visible
      Controls.GroupActionTarget[a].IsInvisible = not visible
      Controls.GroupActionControl[a].IsInvisible = not visible
      Controls.GroupActionMoveUp[a].IsInvisible = not visible
      Controls.GroupActionMoveDown[a].IsInvisible = not visible
      Controls.GroupActionRemove[a].IsInvisible = not visible
    end)
    if visible then
      GroupRefreshActionValueEditor(a)
      pcall(function()
        Controls.GroupActionMoveUp[a].IsDisabled = (a <= 1)
        Controls.GroupActionMoveDown[a].IsDisabled = (a >= g.activeActions)
      end)
    else
      pcall(function()
        Controls.GroupActionValue[a].IsInvisible = true
        Controls.GroupActionValueBool[a].IsInvisible = true
      end)
    end
  end
  pcall(function() Controls.AddGroupActionButton.IsDisabled = (g.activeActions >= MaxActions) end)
end

GroupMoveActionUp = function(a)
  if MaxActionGroups <= 0 or a <= 1 then return end
  local acts = ActionGroups[SelectedGroupIndex].actions
  acts[a], acts[a - 1] = acts[a - 1], acts[a]
  PushSelectedGroupToEditor()
  MarkDirty(); SaveShowData()
end

GroupMoveActionDown = function(a)
  if MaxActionGroups <= 0 then return end
  local g = ActionGroups[SelectedGroupIndex]
  if a >= g.activeActions then return end
  local acts = g.actions
  acts[a], acts[a + 1] = acts[a + 1], acts[a]
  PushSelectedGroupToEditor()
  MarkDirty(); SaveShowData()
end

PushSelectedGroupToEditor = function()
  if MaxActionGroups <= 0 then return end
  local g = ActionGroups[SelectedGroupIndex]
  pcall(function()
    Controls.SelectedGroup.String = string.format("%d: %s", SelectedGroupIndex, g.name)
    Controls.GroupEditName.String = g.name
  end)
  for a = 1, MaxActions do
    local act = g.actions[a]
    pcall(function()
      Controls.GroupActionType[a].String = act.type
      Controls.GroupActionTarget[a].String = act.target
      Controls.GroupActionControl[a].String = act.control
      Controls.GroupActionValue[a].String = act.value
    end)
    GroupRefreshActionTargetChoices(a)
    GroupRefreshActionControlChoices(a)
  end
  RefreshGroupActionRowVisibility()
end

SelectGroup = function(i)
  if MaxActionGroups <= 0 then return end
  if i < 1 or i > MaxActionGroups then return end
  SelectedGroupIndex = i
  local wasLoading = Loading
  Loading = true
  PushSelectedGroupToEditor()
  Loading = wasLoading
end

--=============================================================================
-- UI feedback
--=============================================================================
-- Color precedence: a transient "firing" flash beats everything; a failed
-- fire's "error" red persists until the next attempt on that cue; the one
-- "active" cue (the last cue to successfully fire -- there is only ever one)
-- gets a distinct highlight; a cue that WAS active but has since been
-- superseded shows greyed out as "played"; an as-yet-unplayed Armed cue
-- shows its arm color; anything else uses its own idle color.
RefreshCueButtonColor = function(i)
  local c = Cues[i]
  local color = c.color
  if c.state == "firing" then color = StateColors.firing
  elseif c.state == "error" then color = StateColors.error
  elseif c.state == "active" then color = StateColors.active
  elseif c.state == "played" then color = StateColors.played
  elseif c.armed then color = StateColors.armed
  end
  pcall(function()
    Controls.CueButton[i].Color = color
    local label = (c.name ~= nil and c.name ~= "") and c.name or ("Cue " .. i)
    if c.condition.enabled then label = label .. " *" end -- "*" marks a conditional cue
    Controls.CueButton[i].Legend = string.format("%d: %s", i, label)
  end)
end

MarkDirty = function()
  pcall(function() Controls.UnsavedLed.Color = "#FFA500" end)
  -- There is no Lua-accessible signal for Designer's "Save to Core" action, so this
  -- indicator is a one-way reminder once any edit happens this session -- see README.
end

SetStatusMessage = function(msg)
  CurrentStatusKind = "ready"
  pcall(function()
    Controls.StatusStateText.String = "Ready"
    Controls.StatusLed.Color = StateColors.ready
  end)
end

SetError = function(msg)
  CurrentStatusKind = "error"
  ErrorActive = true
  pcall(function()
    Controls.ErrorText.String = msg
    Controls.ErrorLed.Color = StateColors.error
    Controls.StatusStateText.String = "Error"
    Controls.StatusLed.Color = StateColors.error
  end)
  if DebugOn then print("[CueEngine][ERROR] " .. tostring(msg)) end
end

-- The two big Live Show "cue words" text views always reflect CurrentCueIndex
-- / NextCueIndex (the last SUCCESSFULLY fired cue and what's after it) --
-- never the just-attempted cue, so a failed fire doesn't blank out or
-- overwrite what the operator is currently reading off the previous cue.
RefreshCueNotesDisplays = function()
  pcall(function()
    if CurrentCueIndex >= 1 and CurrentCueIndex <= MaxCues then
      Controls.CurrentCueNotesText.String = Cues[CurrentCueIndex].notes
    else
      Controls.CurrentCueNotesText.String = ""
    end
    if NextCueIndex >= 1 and NextCueIndex <= MaxCues then
      Controls.NextCueNotesText.String = Cues[NextCueIndex].notes
    else
      Controls.NextCueNotesText.String = ""
    end
  end)
end

UpdateStatus = function(i)
  pcall(function()
    Controls.StatusText.String = string.format("Cue %d: %s", i, Cues[i].name)
    if NextCueIndex <= MaxCues and NextCueIndex ~= i then
      Controls.NextCueText.String = string.format("Next: %d: %s", NextCueIndex, Cues[NextCueIndex].name)
    else
      Controls.NextCueText.String = "Next: End of Show"
    end
  end)
  RefreshCueNotesDisplays()
end

LogCueFire = function(i, success, statusLabel)
  local label = statusLabel or (success and "OK" or "ERROR")
  local line = string.format("%s  Cue %d: %s  %s", os.date("%H:%M:%S"), i, Cues[i].name, label)
  table.insert(CueLog, 1, line)
  while #CueLog > CUE_LOG_MAX do table.remove(CueLog) end
  pcall(function() Controls.CueLogText.String = table.concat(CueLog, "\n") end)
  if DebugOn then print("[CueEngine] " .. line) end
end

-- Cancels any cue currently mid-fire on a "wait" delay -- stops its pending
-- Timer so the queued remainder of its actions never dispatches, and marks
-- it CANCELLED in the log rather than leaving it silently stuck showing
-- "Firing". Used by STOP ALL, PANIC, and Reset Show, none of which should
-- let a delayed action sneak out after the operator has told the show to
-- stop or start over.
CancelAllPendingWaits = function()
  for idx = 1, MaxCues do
    local c = Cues[idx]
    if c.firing then
      if c.pendingTimer then
        pcall(function() c.pendingTimer:Stop() end)
      end
      c.pendingTimer = nil
      c.firing = false
      c.state = "idle"
      RefreshCueButtonColor(idx)
      LogCueFire(idx, false, "CANCELLED")
    end
  end
end

-- Rewinds playback POSITION (which cue is active/played, current/next
-- pointers, status bar) without touching the authored show itself (cues,
-- actions, devices, UDP targets are all untouched). Shared by Init/Import
-- (silent) and the explicit Reset Show button (which also logs it).
ResetPlaybackState = function()
  CancelAllPendingWaits()
  for i = 1, MaxCues do
    Cues[i].state = "idle"
    RefreshCueButtonColor(i)
  end
  ActiveCueIndex = nil
  CurrentCueIndex = 0
  NextCueIndex = 1
  PendingConfirm = {}
  CurrentStatusKind = "ready"
  ErrorActive = false
  pcall(function()
    Controls.StatusStateText.String = "Ready"
    Controls.StatusText.String = "No cue fired yet"
    Controls.StatusLed.Color = StateColors.ready
    Controls.ErrorText.String = ""
    Controls.ErrorLed.Color = StateColors.neutral
    if MaxCues >= 1 then
      Controls.NextCueText.String = string.format("Next: %d: %s", NextCueIndex, Cues[NextCueIndex].name)
    end
  end)
  RefreshCueNotesDisplays()
end

-- The operator-facing "Reset Show" button: rewind playback to the top, same
-- as ResetPlaybackState, plus a marker in the activity log so the reset is
-- visible in the show's history rather than silently disappearing.
ResetShow = function()
  ResetPlaybackState()
  table.insert(CueLog, 1, string.format("%s  --- Show Reset ---", os.date("%H:%M:%S")))
  while #CueLog > CUE_LOG_MAX do table.remove(CueLog) end
  pcall(function() Controls.CueLogText.String = table.concat(CueLog, "\n") end)
  if DebugOn then print("[CueEngine] Show reset") end
end

--=============================================================================
-- E-Stop (latching panic): engaged by PanicButton going true (from the UI
-- OR its schematic input pin), and -- deliberately -- can only be cleared
-- by ResetPanicButton. Neither the UI nor the pin can clear it directly;
-- see the PanicButton EventHandler below, which forces the control back to
-- true if anything but ClearPanic() tries to drop it.
--=============================================================================
EngagePanic = function()
  PanicEngaged = true
  local errs = StopAllPlayers()
  local payload = Controls.PanicUdpPayload.String
  if payload ~= "" then
    for i = 1, NumUdp do
      if UdpSockets[i] then
        local ok, err = pcall(function() UdpSockets[i]:Send(UdpTargets[i].ip, UdpTargets[i].port, payload) end)
        if not ok then table.insert(errs, string.format("UDP %s: %s", UdpTargets[i].name, tostring(err))) end
      end
    end
  end
  -- Same "halt in place, don't rewind" semantics as the old momentary Panic
  -- button: clears active/played highlighting but leaves Current/NextCueIndex
  -- untouched. Also stops any cue currently mid-"wait" so nothing queued
  -- fires late -- Live Show and Timecode Show alike.
  CancelAllPendingWaits()
  TcCancelAllPendingWaits()
  for i = 1, MaxCues do
    Cues[i].state = "idle"
    RefreshCueButtonColor(i)
  end
  ActiveCueIndex = nil
  local wasLoading = Loading
  Loading = true
  pcall(function() Controls.PanicButton.Boolean = true end)
  Loading = wasLoading
  if #errs > 0 then
    SetError("E-STOP errors: " .. table.concat(errs, " | "))
  else
    SetError("E-STOP engaged - safe state sent. Use CLEAR E-STOP to resume.")
  end
end

ClearPanic = function()
  if not PanicEngaged then return end
  PanicEngaged = false
  local wasLoading = Loading
  Loading = true
  pcall(function() Controls.PanicButton.Boolean = false end)
  Loading = wasLoading
  SetStatusMessage("E-Stop cleared")
  pcall(function() Controls.ErrorText.String = "" end)
  ErrorActive = false
  pcall(function() Controls.ErrorLed.Color = StateColors.neutral end)
end

--=============================================================================
-- Light/Dark Mode (runtime)
-- Q-SYS plugin graphics (card/page backgrounds, borders) are baked in once
-- by GetControlLayout at design time -- there is no documented runtime API
-- to redraw them. So this genuinely re-skins every real Control (transport
-- buttons, the cue grid, status/error LEDs) but cannot repaint the card or
-- page backgrounds themselves. See README for the exact scope.
--=============================================================================
ApplyColorMode = function(isDark)
  DarkMode = isDark and true or false
  local stateSrc = DarkMode and DarkStateColors or LightStateColors
  for k, v in pairs(stateSrc) do StateColors[k] = v end
  local btnSrc = DarkMode and DarkButtonColors or LightButtonColors
  pcall(function()
    Controls.GoButton.Color = btnSrc.GoButton
    Controls.StopAllButton.Color = btnSrc.StopAllButton
    Controls.ResetShowButton.Color = btnSrc.ResetShowButton
    Controls.ResetPanicButton.Color = btnSrc.ResetPanicButton
  end)
  for i = 1, MaxCues do RefreshCueButtonColor(i) end
  pcall(function()
    Controls.StatusLed.Color = StateColors[CurrentStatusKind] or StateColors.ready
    Controls.ErrorLed.Color = ErrorActive and StateColors.error or StateColors.neutral
  end)
end

--=============================================================================
-- Timecode Show: frame math
-- Deliberately lenient rather than rejecting on out-of-range minutes/
-- seconds/frames (e.g. after a frame-rate change makes a previously-valid
-- frame number too high) -- clamps into range and re-normalizes, instead of
-- leaving a cue with a target time that can now never be parsed. Only a
-- genuinely malformed string (wrong shape entirely) is rejected (nil).
-- No drop-frame support -- see README.
--=============================================================================
TcStringToFrames = function(str, fps)
  if type(str) ~= "string" then return nil end
  local h, m, s, f = str:match("^%s*(%d+):(%d+):(%d+):(%d+)%s*$")
  if not h then return nil end
  h, m, s, f = tonumber(h), tonumber(m), tonumber(s), tonumber(f)
  if m > 59 then m = 59 end
  if s > 59 then s = 59 end
  if f > fps - 1 then f = fps - 1 end
  return ((h * 3600 + m * 60 + s) * fps) + f
end

TcFramesToString = function(totalFrames, fps)
  if not totalFrames or totalFrames < 0 then totalFrames = 0 end
  totalFrames = math.floor(totalFrames)
  local f = totalFrames % fps
  local totalSeconds = math.floor(totalFrames / fps)
  local s = totalSeconds % 60
  local totalMinutes = math.floor(totalSeconds / 60)
  local m = totalMinutes % 60
  local h = math.floor(totalMinutes / 60)
  return string.format("%02d:%02d:%02d:%02d", h, m, s, f)
end

-- Re-derives every TC cue's targetFrames from its stored targetString under
-- the CURRENT TcFrameRate -- called whenever the frame rate changes, since
-- frame counts aren't comparable across rates.
TcRecomputeAllTargets = function()
  for i = 1, MaxTcCues do
    local c = TcCues[i]
    local frames = TcStringToFrames(c.targetString, TcFrameRate)
    if frames then
      c.targetFrames = frames
      c.targetString = TcFramesToString(frames, TcFrameRate)
    else
      c.targetFrames = 0
      c.targetString = "00:00:00:00"
    end
    RefreshTcCueButtonColor(i)
  end
end

--=============================================================================
-- Timecode Show: the clock itself
-- SOFT-SYNC ONLY -- see README's "Timecode Show" section. Internal mode
-- counts Timer ticks (1 tick = 1 frame); it is not locked to any external
-- reference and will drift over a long show. External mode just relays
-- whatever arrives on the TcInput pin -- this plugin cannot decode real
-- LTC/MTC itself (that needs DSP, not Lua), so accuracy there is entirely
-- the upstream device's.
--=============================================================================
TcTickHandler = function()
  TcFrameCounter = TcFrameCounter + 1
  local s = TcFramesToString(TcFrameCounter, TcFrameRate)
  pcall(function()
    Controls.TcCurrentText.String = s
    Controls.TcOutput.String = s
  end)
  EvaluateTcCues()
end

TcApplyFrameRate = function(fps)
  if fps ~= 24 and fps ~= 25 and fps ~= 30 then fps = 30 end
  local wasTicking = TcRunning and not TcExternalSource
  if wasTicking then pcall(function() TcTimer:Stop() end) end
  TcFrameRate = fps
  TcRecomputeAllTargets()
  pcall(function() Controls.TcCurrentText.String = TcFramesToString(TcFrameCounter, TcFrameRate) end)
  if wasTicking then pcall(function() TcTimer:Start(1 / TcFrameRate) end) end
end

-- Keeps TcStatusText in sync; called after any change to source/running.
local function TcRefreshStatusText()
  pcall(function()
    Controls.TcStatusText.String = TcExternalSource and "External (TC Input pin)" or (TcRunning and "Running (Internal)" or "Stopped (Internal)")
  end)
end

TcSetRunning = function(running)
  TcRunning = running and true or false
  if TcTimer then
    if TcRunning and not TcExternalSource then
      pcall(function() TcTimer:Start(1 / TcFrameRate) end)
    else
      pcall(function() TcTimer:Stop() end)
    end
  end
  TcRefreshStatusText()
end

TcSetSource = function(external)
  TcExternalSource = external and true or false
  if TcTimer then
    if TcExternalSource then
      pcall(function() TcTimer:Stop() end)
    elseif TcRunning then
      pcall(function() TcTimer:Start(1 / TcFrameRate) end)
    end
  end
  TcRefreshStatusText()
end

TcResetClock = function()
  TcFrameCounter = 0
  local s = TcFramesToString(0, TcFrameRate)
  pcall(function()
    Controls.TcCurrentText.String = s
    Controls.TcOutput.String = s
  end)
  EvaluateTcCues() -- re-arms anything whose target is now ahead of 0 again
end

TcRearmAllCues = function()
  for i = 1, MaxTcCues do
    local c = TcCues[i]
    c.fired = false
    if c.state == "fired" or c.state == "error" then c.state = "idle" end
    RefreshTcCueButtonColor(i)
  end
end

--=============================================================================
-- Timecode Show: cue evaluation, coloring, logging
--=============================================================================
-- A ">=" threshold check, not exact equality -- a cue's target can never be
-- silently skipped even if TcFrameCounter jumps past it in one tick (a lag
-- spike), only fired late. If TC moves backward past a cue's target (an
-- external rewind, or a manual Reset Clock), it re-arms automatically so it
-- fires again next time TC passes it -- see README for why this, not exact
-- frame matching, is what makes this reliable enough to use despite jitter.
EvaluateTcCues = function()
  for i = 1, MaxTcCues do
    local c = TcCues[i]
    if c.enabled then
      if TcFrameCounter < c.targetFrames then
        if c.fired then
          c.fired = false
          if c.state == "fired" then c.state = "idle" end
          RefreshTcCueButtonColor(i)
        end
      elseif not c.fired and not c.firing then
        TcFireCueNow(i)
      end
    end
  end
end

RefreshTcCueButtonColor = function(i)
  local c = TcCues[i]
  local color = StateColors.neutral
  if c.state == "firing" then color = StateColors.firing
  elseif c.state == "error" then color = StateColors.error
  elseif c.state == "fired" then color = StateColors.played
  elseif c.enabled then color = StateColors.armed
  end
  pcall(function()
    Controls.TcCueButton[i].Color = color
    Controls.TcCueButton[i].Legend = (c.targetString ~= "" and c.targetString) or "--:--:--:--"
  end)
end

LogTcCueFire = function(i, success, statusLabel)
  local c = TcCues[i]
  local label = statusLabel or (success and "OK" or "ERROR")
  local line = string.format("%s  TC %s  Cue %d: %s  %s", os.date("%H:%M:%S"), c.targetString or "", i, c.name, label)
  table.insert(TcCueLog, 1, line)
  while #TcCueLog > CUE_LOG_MAX do table.remove(TcCueLog) end
  pcall(function() Controls.TcCueLogText.String = table.concat(TcCueLog, "\n") end)
  if DebugOn then print("[CueEngine][TC] " .. line) end
end

-- Mirrors CancelAllPendingWaits for the TC show -- stops any TC cue
-- currently mid-"wait" (its queued remainder never fires) without touching
-- its already-fired flag, so it isn't silently retried this same pass.
-- Called from STOP ALL / E-Stop alongside the Live Show's own version.
TcCancelAllPendingWaits = function()
  for idx = 1, MaxTcCues do
    local c = TcCues[idx]
    if c.firing then
      if c.pendingTimer then pcall(function() c.pendingTimer:Stop() end) end
      c.pendingTimer = nil
      c.firing = false
      c.state = "idle"
      RefreshTcCueButtonColor(idx)
      LogTcCueFire(idx, false, "CANCELLED")
    end
  end
end

--=============================================================================
-- Timecode Show: firing (parallel to DispatchCueActions/FinishCueFire/
-- FireCueNow -- kept separate rather than parameterizing the Live Show
-- versions, same reasoning as Action Groups: a TC cue firing can never
-- accidentally touch Cues/ActiveCueIndex or vice versa). Reuses
-- BuildExpandedActionList/DispatchAction/CallAfter as-is -- those already
-- take a plain actions array and don't reference Cues at all.
--=============================================================================
TcFinishCueFire = function(i, errors)
  local c = TcCues[i]
  c.firing = false
  c.pendingTimer = nil
  if #errors > 0 then
    c.state = "error"
    SetError(string.format("TC Cue %d (%s): %s", i, c.name, table.concat(errors, " | ")))
  else
    c.state = "fired"
  end
  RefreshTcCueButtonColor(i)
  LogTcCueFire(i, #errors == 0)
end

TcDispatchCueActions = function(i, expanded, startIndex, errors)
  for idx = startIndex, #expanded do
    local act = expanded[idx]
    if act.type == "wait" then
      local seconds = tonumber(act.value) or 0
      if seconds > 0 then
        TcCues[i].pendingTimer = CallAfter(function()
          TcDispatchCueActions(i, expanded, idx + 1, errors)
        end, seconds)
        return
      end
    elseif act.type == "error_marker" then
      table.insert(errors, act.message)
    else
      local ok, err = DispatchAction(act)
      if not ok then
        table.insert(errors, string.format("%s (%s): %s", act.sourceLabel or "Action", act.type, tostring(err)))
      end
    end
  end
  TcFinishCueFire(i, errors)
end

-- Called both by EvaluateTcCues (automatic, TC-driven) and by TcCueButton
-- (manual test-fire, which deliberately ignores `enabled` -- see README --
-- so a disabled TC cue can still be tested on the bench). E-Stop blocks
-- both paths identically and without marking the cue fired, so an
-- auto-triggered cue blocked by E-Stop retries on the very next tick once
-- E-Stop clears, instead of being silently skipped.
TcFireCueNow = function(i)
  if PanicEngaged then return end
  local c = TcCues[i]
  if c.firing then return end
  c.firing = true
  c.fired = true
  c.state = "firing"
  RefreshTcCueButtonColor(i)
  local expanded = BuildExpandedActionList(c.actions, MaxActions, "TC Action ", {}, 0)
  TcDispatchCueActions(i, expanded, 1, {})
end

--=============================================================================
-- Timecode Show: TC Cue editor -- select-one-and-edit, exact mirror of the
-- Action Groups editor functions above (own Tc* controls, own state, never
-- shares controls with a cue's or a group's editor). Every one of these
-- guards on MaxTcCues <= 0 and returns immediately, since GetControls only
-- declares the Tc* editor controls when Max TC Cues > 0.
--=============================================================================
TcRefreshActionTargetChoices = function(a)
  if MaxTcCues <= 0 then return end
  local t = TcCues[SelectedTcCueIndex].actions[a].type
  pcall(function()
    if t == "udp_send" then
      Controls.TcActionTarget[a].Choices = UdpTargetNameList()
    elseif t == "player_trigger" or t == "named_control_set" then
      Controls.TcActionTarget[a].Choices = DeviceNameList()
    elseif t == "group" then
      Controls.TcActionTarget[a].Choices = ActionGroupNameList()
    else
      Controls.TcActionTarget[a].Choices = {}
    end
  end)
end

TcRefreshActionControlChoices = function(a)
  if MaxTcCues <= 0 then return end
  local act = TcCues[SelectedTcCueIndex].actions[a]
  if act.type ~= "player_trigger" and act.type ~= "named_control_set" then return end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return end
  local comp = GetComponent(compName)
  if not comp then return end
  pcall(function()
    local names = {}
    for _, ctrl in ipairs(Component.GetControls(comp)) do
      if ctrl.Name then table.insert(names, ctrl.Name) end
    end
    table.sort(names)
    Controls.TcActionControl[a].Choices = names
  end)
end

TcRefreshVisibleActionChoices = function()
  if MaxTcCues <= 0 then return end
  local c = TcCues[SelectedTcCueIndex]
  for a = 1, c.activeActions do
    TcRefreshActionTargetChoices(a)
  end
end

TcRefreshActionValueEditor = function(a)
  if MaxTcCues <= 0 then return end
  local act = TcCues[SelectedTcCueIndex].actions[a]
  local showText, showBool = false, false
  if act.type == "udp_send" or act.type == "wait" then
    showText = true
  elseif act.type == "named_control_set" then
    local compName = ResolveDeviceComponent(act.target)
    local desc = nil
    if compName and compName ~= "" and act.control ~= "" then
      desc = FindControlDescriptor(compName, act.control)
    end
    if desc and desc.Type == "Boolean" then
      showBool = true
    elseif desc and desc.Type == "Trigger" then
      showText, showBool = false, false
    else
      showText = true
    end
  end
  pcall(function()
    Controls.TcActionValue[a].IsInvisible = not showText
    Controls.TcActionValueBool[a].IsInvisible = not showBool
    if showBool then
      local mode, data = ParseValueSpec(act.value)
      local boolVal = (mode == "boolean" and data) or false
      Controls.TcActionValueBool[a].Boolean = boolVal
      Controls.TcActionValueBool[a].Legend = boolVal and "TRUE" or "FALSE"
      local normalized = boolVal and "B:true" or "B:false"
      if act.value ~= normalized then
        act.value = normalized
        if not Loading then MarkDirty(); SaveShowData() end
      end
    end
  end)
end

TcRefreshSelectedCueChoices = function()
  if MaxTcCues <= 0 then return end
  local list = {}
  for i = 1, MaxTcCues do table.insert(list, string.format("%d: %s", i, TcCues[i].name)) end
  pcall(function() Controls.SelectedTcCue.Choices = list end)
end

TcRefreshActionRowVisibility = function()
  if MaxTcCues <= 0 then return end
  local c = TcCues[SelectedTcCueIndex]
  for a = 1, MaxActions do
    local visible = a <= c.activeActions
    pcall(function()
      Controls.TcActionType[a].IsInvisible = not visible
      Controls.TcActionTarget[a].IsInvisible = not visible
      Controls.TcActionControl[a].IsInvisible = not visible
      Controls.TcActionMoveUp[a].IsInvisible = not visible
      Controls.TcActionMoveDown[a].IsInvisible = not visible
      Controls.TcActionRemove[a].IsInvisible = not visible
    end)
    if visible then
      TcRefreshActionValueEditor(a)
      pcall(function()
        Controls.TcActionMoveUp[a].IsDisabled = (a <= 1)
        Controls.TcActionMoveDown[a].IsDisabled = (a >= c.activeActions)
      end)
    else
      pcall(function()
        Controls.TcActionValue[a].IsInvisible = true
        Controls.TcActionValueBool[a].IsInvisible = true
      end)
    end
  end
  pcall(function() Controls.AddTcActionButton.IsDisabled = (c.activeActions >= MaxActions) end)
end

TcMoveActionUp = function(a)
  if MaxTcCues <= 0 or a <= 1 then return end
  local acts = TcCues[SelectedTcCueIndex].actions
  acts[a], acts[a - 1] = acts[a - 1], acts[a]
  PushSelectedTcCueToEditor()
  MarkDirty(); SaveShowData()
end

TcMoveActionDown = function(a)
  if MaxTcCues <= 0 then return end
  local c = TcCues[SelectedTcCueIndex]
  if a >= c.activeActions then return end
  local acts = c.actions
  acts[a], acts[a + 1] = acts[a + 1], acts[a]
  PushSelectedTcCueToEditor()
  MarkDirty(); SaveShowData()
end

PushSelectedTcCueToEditor = function()
  if MaxTcCues <= 0 then return end
  local c = TcCues[SelectedTcCueIndex]
  pcall(function()
    Controls.SelectedTcCue.String = string.format("%d: %s", SelectedTcCueIndex, c.name)
    Controls.TcCueEditName.String = c.name
    Controls.TcCueEditTime.String = c.targetString
    Controls.TcCueEditEnabled.Boolean = c.enabled
  end)
  for a = 1, MaxActions do
    local act = c.actions[a]
    pcall(function()
      Controls.TcActionType[a].String = act.type
      Controls.TcActionTarget[a].String = act.target
      Controls.TcActionControl[a].String = act.control
      Controls.TcActionValue[a].String = act.value
    end)
    TcRefreshActionTargetChoices(a)
    TcRefreshActionControlChoices(a)
  end
  TcRefreshActionRowVisibility()
end

SelectTcCue = function(i)
  if MaxTcCues <= 0 then return end
  if i < 1 or i > MaxTcCues then return end
  SelectedTcCueIndex = i
  local wasLoading = Loading
  Loading = true
  PushSelectedTcCueToEditor()
  Loading = wasLoading
end

--=============================================================================
-- UDP
--=============================================================================
FindUdpTargetByName = function(name)
  for i = 1, NumUdp do
    if UdpTargets[i].name == name then return i end
  end
  return nil
end

-- One shared UdpSocket per configured target slot, opened once here at init
-- and never re-opened on a per-fire basis. Sockets are keyed by the fixed
-- 1..NumUdp slot index rather than by the (operator-editable) target name,
-- since the name can be renamed live at runtime -- the slot index is the
-- stable identity. Destination IP/Port are read fresh from UdpTargets[i] on
-- every Send(), so editing a target's IP/Port live never requires reopening
-- its socket.
OpenUdpSocket = function(i)
  local ok, sockOrErr = pcall(function()
    local s = UdpSocket.New()
    s.EventHandler = function(sockObj, packet)
      local now = os.clock()
      if (now - LastTelemetryUpdate) * 1000 < TELEMETRY_THROTTLE_MS then return end
      LastTelemetryUpdate = now
      pcall(function()
        Controls.UdpTargetStatus[i].String = string.format("RX %s: %s", tostring(packet.Address), tostring(packet.Data))
      end)
    end
    s:Open(nil, 0)
    return s
  end)
  if ok then
    UdpSockets[i] = sockOrErr
    pcall(function() Controls.UdpTargetStatus[i].String = "Open" end)
  else
    UdpSockets[i] = nil
    pcall(function() Controls.UdpTargetStatus[i].String = "Error: " .. tostring(sockOrErr) end)
    dbg("Failed to open UDP socket for target %d: %s", i, tostring(sockOrErr))
  end
end

--=============================================================================
-- Action dispatch
-- Each Do* function is fully pcall-wrapped internally and returns (ok, err)
-- rather than throwing, so one failing action in a cue never blocks the
-- other simultaneous actions in that same cue.
--=============================================================================

-- ASSUMPTION (flagged per deliverable requirement): the exact set of control
-- names exposed by a Media/Stream Player component (e.g. "play"/"stop"/
-- "cue"/"select.1") depends on the specific Player component type, which was
-- not specified for this build. player_trigger therefore never hardcodes a
-- control name -- the operator enters/selects it per action (auto-suggested
-- from the live component's own controls where possible via
-- RefreshActionControlChoices), and this simply :Trigger()s whatever control
-- name was given.
DoPlayerTrigger = function(act)
  if act.target == "" or act.control == "" then
    return false, "player_trigger missing target/control"
  end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return false, "Device not configured: " .. act.target end
  local comp = GetComponent(compName)
  if not comp then return false, string.format("Component not found: %s (device '%s')", compName, act.target) end
  local ok, err = pcall(function() comp[act.control]:Trigger() end)
  if not ok then return false, string.format("Component not found: %s (device '%s') (%s)", compName, act.target, tostring(err)) end
  return true
end

DoNamedControlSet = function(act)
  if act.target == "" or act.control == "" then
    return false, "named_control_set missing target/control"
  end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return false, "Device not configured: " .. act.target end
  local comp = GetComponent(compName)
  if not comp then return false, string.format("Component not found: %s (device '%s')", compName, act.target) end
  local mode, data = ParseValueSpec(act.value)
  local ok, err = pcall(function()
    local ctrl = comp[act.control]
    if mode == "value" then ctrl.Value = data
    elseif mode == "position" then ctrl.Position = data
    elseif mode == "string" then ctrl.String = data
    elseif mode == "boolean" then ctrl.Boolean = data
    else ctrl:Trigger()
    end
  end)
  if not ok then return false, string.format("Component not found: %s (device '%s') (%s)", compName, act.target, tostring(err)) end
  return true
end

-- ASSUMPTION (flagged per deliverable requirement): UDP payload format is
-- raw ASCII with no automatically-appended line terminator -- whatever the
-- operator types into the Value field (Action~Value) is sent byte-for-byte.
-- If a target device needs a terminator (CR, LF, CRLF), the operator should
-- type it explicitly using Lua escapes when authoring via JSON import, e.g.
-- "PLAY\r\n" in the imported JSON string.
DoUdpSend = function(act)
  local targetIdx = FindUdpTargetByName(act.target)
  if not targetIdx then return false, "UDP target not found: " .. tostring(act.target) end
  local sock = UdpSockets[targetIdx]
  if not sock then return false, "UDP socket not open: " .. tostring(act.target) end
  local tgt = UdpTargets[targetIdx]
  local ok, err = pcall(function() sock:Send(tgt.ip, tgt.port, act.value or "") end)
  if not ok then return false, string.format("UDP send failed: %s (%s)", act.target, tostring(err)) end
  return true
end

DispatchAction = function(act)
  if act.type == "player_trigger" then return DoPlayerTrigger(act)
  elseif act.type == "udp_send" then return DoUdpSend(act)
  elseif act.type == "named_control_set" then return DoNamedControlSet(act)
  else return true
  end
end

--=============================================================================
-- Cue firing
--=============================================================================
-- Finalizes a cue fire once every action (including anything after the last
-- "wait") has been dispatched -- was FireCueNow's tail before actions could
-- span real time.
FinishCueFire = function(i, errors)
  local cue = Cues[i]
  cue.firing = false
  cue.pendingTimer = nil

  if #errors > 0 then
    -- A failed fire never becomes the new active cue -- the show stays
    -- sitting on whichever cue last succeeded, and Current/NextCueIndex
    -- (and the GO target) are left untouched so a retry re-targets the
    -- same cue rather than silently skipping past it.
    cue.state = "error"
    SetError(string.format("Cue %d: %s", i, table.concat(errors, " | ")))
  else
    -- There is only ever ONE active cue: demote whatever was active before
    -- (if anything) to "played" (greyed out) now that this one has taken
    -- over.
    if ActiveCueIndex and ActiveCueIndex ~= i and Cues[ActiveCueIndex].state == "active" then
      Cues[ActiveCueIndex].state = "played"
      RefreshCueButtonColor(ActiveCueIndex)
    end
    ActiveCueIndex = i
    cue.state = "active"
    CurrentCueIndex = i
    NextCueIndex = math.min(i + 1, MaxCues)
    SetStatusMessage(string.format("Fired cue %d: %s", i, cue.name))
  end
  RefreshCueButtonColor(i)
  UpdateStatus(i)
  LogCueFire(i, #errors == 0)
end

-- Expands a flat actions array (a cue's own, or a group's) into a single
-- ordered list, inlining any "group" actions' own actions recursively --
-- right where the group action sat, in order -- so a group can itself
-- contain "wait" actions or reference further groups. `visitedGroups`
-- guards against a group directly or indirectly (A -> B -> A) referencing
-- itself; `depth` is a hard recursion backstop. Each expanded entry keeps
-- a human-readable sourceLabel for error messages, since a flat position
-- no longer maps 1:1 to the original cue's own action slots once groups
-- have been inlined. Reused for both a cue's top-level actions and every
-- nested group's own actions -- same function, just fed a different array.
BuildExpandedActionList = function(actions, count, labelPrefix, visitedGroups, depth)
  local expanded = {}
  if depth > 8 then
    table.insert(expanded, { type = "error_marker", message = labelPrefix .. ": group nesting too deep (likely a circular reference)" })
    return expanded
  end
  for a = 1, count do
    local act = actions[a]
    local label = string.format("%s%d", labelPrefix, a)
    if act.type == "group" then
      local group = FindActionGroupByName(act.target)
      if not group then
        table.insert(expanded, { type = "error_marker", message = string.format("%s: action group not found: %s", label, tostring(act.target)) })
      elseif visitedGroups[act.target] then
        table.insert(expanded, { type = "error_marker", message = string.format("%s: circular action group reference: %s", label, act.target) })
      else
        visitedGroups[act.target] = true
        local sub = BuildExpandedActionList(group.actions, MaxActions, string.format("[%s]#", group.name), visitedGroups, depth + 1)
        for _, subAct in ipairs(sub) do table.insert(expanded, subAct) end
        visitedGroups[act.target] = nil -- a later, unrelated action can still reference the same group
      end
    elseif act.type ~= "none" then
      table.insert(expanded, { type = act.type, target = act.target, control = act.control, value = act.value, sourceLabel = label })
    end
  end
  return expanded
end

-- Dispatches an already-expanded (group references inlined) action list IN
-- ORDER starting at `startIndex`. A "wait" action pauses the sequence for
-- its Value (seconds) via a cancellable Timer and resumes with the
-- remaining actions once it fires -- everything before a wait has already
-- happened by the time it's reached, and nothing after it happens until
-- the delay elapses. Reaching the end (or an empty list) finalizes the
-- fire via FinishCueFire.
DispatchCueActions = function(i, expanded, startIndex, errors)
  for idx = startIndex, #expanded do
    local act = expanded[idx]
    if act.type == "wait" then
      local seconds = tonumber(act.value) or 0
      if seconds > 0 then
        Cues[i].pendingTimer = CallAfter(function()
          DispatchCueActions(i, expanded, idx + 1, errors)
        end, seconds)
        return -- resume later; do not fall through to FinishCueFire yet
      end
      -- seconds <= 0 (unset/invalid): treat as a no-op, continue immediately
    elseif act.type == "error_marker" then
      table.insert(errors, act.message)
    else
      local ok, err = DispatchAction(act)
      if not ok then
        table.insert(errors, string.format("%s (%s): %s", act.sourceLabel or "Action", act.type, tostring(err)))
      end
    end
  end
  FinishCueFire(i, errors)
end

FireCueNow = function(i)
  local now = os.clock()
  if LastFireTime[i] and (now - LastFireTime[i]) * 1000 < DEBOUNCE_MS then
    dbg("Debounced re-fire of cue %d", i)
    return
  end
  local cue = Cues[i]
  if cue.firing then
    dbg("Cue %d is still running (a 'wait' is pending); ignoring re-fire", i)
    return
  end
  LastFireTime[i] = now

  cue.firing = true
  cue.state = "firing"
  RefreshCueButtonColor(i)
  CurrentStatusKind = "firing"
  pcall(function()
    Controls.StatusStateText.String = "Firing"
    Controls.StatusLed.Color = StateColors.firing
  end)

  local expanded = BuildExpandedActionList(cue.actions, MaxActions, "Action ", {}, 0)
  DispatchCueActions(i, expanded, 1, {})
end

OnCueButtonPressed = function(i)
  if PanicEngaged then
    SetError(string.format("Cue %d blocked: E-Stop engaged", i))
    LogCueFire(i, false, "E-STOP")
    return
  end
  local condOk, condReason = CheckCueConditions(i)
  if not condOk then
    SetError(string.format("Cue %d blocked: %s", i, condReason))
    LogCueFire(i, false, "BLOCKED")
    return
  end
  local cue = Cues[i]
  if not cue.confirm then
    FireCueNow(i)
    return
  end
  local now = os.clock()
  if PendingConfirm[i] and (now - PendingConfirm[i]) * 1000 <= CONFIRM_WINDOW_MS then
    PendingConfirm[i] = nil
    FireCueNow(i)
  else
    PendingConfirm[i] = now
    pcall(function()
      Controls.CueButton[i].Legend = string.format("%d: CONFIRM?", i)
      Controls.CueButton[i].Color = StateColors.error
    end)
    CallAfter(function()
      if PendingConfirm[i] == now then
        PendingConfirm[i] = nil
        RefreshCueButtonColor(i)
      end
    end, CONFIRM_WINDOW_MS / 1000)
  end
end

StopAllPlayers = function()
  local stopCtrl = Controls.GlobalStopControlName.String
  if stopCtrl == "" then stopCtrl = "stop" end
  local errors = {}
  for name, comp in pairs(ComponentCache) do
    if comp then
      local ok, err = pcall(function() comp[stopCtrl]:Trigger() end)
      if not ok then table.insert(errors, string.format("%s: %s", name, tostring(err))) end
    end
  end
  return errors
end

--=============================================================================
-- Optional: UDP target heartbeat via the Ping extension. This is a "nice to
-- have" per spec ("do not sacrifice reliability for these") so the whole
-- thing is pcall-wrapped and simply disables itself on any error.
--
-- ASSUMPTION (flagged per deliverable requirement): the exact Ping method
-- signature (Ping.New/:start/:setPingInterval/.EventHandler/.ErrorHandler,
-- including casing) could not be verified with full certainty for every
-- Designer version. Verify against the installed Designer's own Ping
-- documentation and adjust if this silently fails to populate target status.
--=============================================================================
StartPingHeartbeat = function()
  if NumUdp <= 0 then return end
  local pingTimer = Timer.New()
  local checkIdx = 1
  pingTimer.EventHandler = function()
    local i = checkIdx
    checkIdx = checkIdx + 1
    if checkIdx > NumUdp then checkIdx = 1 end
    local tgt = UdpTargets[i]
    if tgt.ip ~= "" then
      pcall(function()
        local p = Ping.New(tgt.ip)
        p.EventHandler = function()
          pcall(function() Controls.UdpTargetStatus[i].String = "Reachable" end)
        end
        p.ErrorHandler = function()
          pcall(function() Controls.UdpTargetStatus[i].String = "Unreachable" end)
        end
        p:start(true)
      end)
    end
  end
  pingTimer:Start(5)
end

--=============================================================================
-- Wire up EventHandlers
--=============================================================================
Controls.GoButton.EventHandler = function()
  OnCueButtonPressed(NextCueIndex)
end

Controls.StopAllButton.EventHandler = function()
  local errs = StopAllPlayers()
  CancelAllPendingWaits()
  TcCancelAllPendingWaits()
  if #errs > 0 then
    SetError("Stop-all errors: " .. table.concat(errs, " | "))
  else
    SetStatusMessage("All players stopped")
  end
end

-- Fires on ANY change to PanicButton.Boolean -- a UI click, or its schematic
-- input pin being driven externally. Going true engages E-Stop; going false
-- is only honored when it's ClearPanic() making that change (guarded by
-- Loading there) -- any other attempt to clear it (UI or pin) is rejected
-- and the control is forced straight back to true.
Controls.PanicButton.EventHandler = function(ctl)
  if Loading then return end
  if ctl.Boolean then
    EngagePanic()
  elseif PanicEngaged then
    local wasLoading = Loading
    Loading = true
    pcall(function() Controls.PanicButton.Boolean = true end)
    Loading = wasLoading
    SetError("E-Stop is latched - use CLEAR E-STOP to resume.")
  end
end

Controls.ResetPanicButton.EventHandler = function()
  ClearPanic()
end

Controls.ResetShowButton.EventHandler = function()
  ResetShow()
end

Controls.DarkModeToggle.EventHandler = function(ctl)
  if Loading then return end
  ApplyColorMode(ctl.Boolean)
  MarkDirty()
  SaveShowData()
end

Controls.LockToggle.EventHandler = function() end -- pure UI state; read directly where needed

Controls.ExportButton.EventHandler = function()
  local ok, encoded = pcall(rapidjson.encode, BuildShowTable())
  if ok then
    Controls.ExportData.String = encoded
  else
    Controls.ExportData.String = ""
    SetError("Export failed: " .. tostring(encoded))
  end
end

Controls.ImportButton.EventHandler = function()
  local raw = Controls.ImportData.String
  if raw == nil or raw == "" then
    Controls.ImportErrorText.String = "Import data is empty"
    return
  end
  local ok, data = pcall(rapidjson.decode, raw)
  if not ok then
    Controls.ImportErrorText.String = "Invalid JSON: " .. tostring(data)
    return
  end
  local valid, verr = ValidateShowTable(data)
  if not valid then
    Controls.ImportErrorText.String = "Import rejected: " .. tostring(verr)
    return
  end
  ApplyShowTable(data)
  Controls.ImportErrorText.String = ""
  MarkDirty()
  SaveShowData()
  RebuildComponentCache()
  dbg("Show imported successfully")
end

Controls.SelectedCue.EventHandler = function(ctl)
  if Loading then return end
  local numStr = ctl.String:match("^(%d+):")
  local i = tonumber(numStr)
  if i then SelectCue(i) end
end

Controls.CueEditName.EventHandler = function(ctl)
  if Loading then return end
  if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].name; return end
  Cues[SelectedCueIndex].name = ctl.String
  RefreshCueButtonColor(SelectedCueIndex)
  RefreshSelectedCueChoices()
  pcall(function() Controls.SelectedCue.String = string.format("%d: %s", SelectedCueIndex, ctl.String) end)
  MarkDirty(); SaveShowData()
end

