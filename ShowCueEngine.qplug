--[[
  Show Control ~ Cue Engine
  ---------------------------------------------------------------------------
  A live-show cue engine for Q-SYS Designer. Up to 30 operator-programmable
  cues, each firing multiple simultaneous actions:
    - player_trigger      : invoke a control (e.g. Play/Stop/Cue) on a named
                             Media/Stream Player (or any) component
    - udp_send             : send an ASCII payload to a configured UDP target
    - named_control_set    : set .Value / .Position / .String or :Trigger()
                             on any Named Control of any component

  Three pages:
    - Live Show   : status bar, transport, quick-fire cue grid, activity log
    - Devices     : curated list of Q-SYS components ("Devices") and UDP
                    targets -- the ONLY things offered in the Show Editor's
                    action Target dropdowns (instead of every component in
                    the whole design)
    - Show Editor : pick one cue from a dropdown and edit it -- name/notes/
                    color/armed/confirm plus its actions, added one at a
                    time via "+ Add Action" -- rather than showing all
                    cues x actions on screen at once

  Only documented Q-SYS Lua extensions are used: UdpSocket, Component,
  Controls, Timer, rapidjson, Ping. See README.md for install/config notes
  and a list of flagged assumptions (search this file for "ASSUMPTION").
---------------------------------------------------------------------------]]

PluginInfo = {
  Name = "Show Control~CueEngine",
  Version = "1.1.0",
  Id = "com.yourcompany.showcontrol.cueengine",
  Description = "Live-show cue engine: up to 30 cues, each firing multiple simultaneous actions (player triggers, UDP, named controls).",
  ShowDebug = true,
}

-- Hard ceilings so a mis-typed Property can never blow the control set up
-- to an unreasonable size.
local HARD_MAX_CUES = 30
local HARD_MAX_ACTIONS = 25
local HARD_MAX_DEVICES = 24
local HARD_MAX_UDP = 12

--=============================================================================
-- Design time: Properties
--=============================================================================
function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "Max Cues",
    Type = "integer",
    Min = 1,
    Max = HARD_MAX_CUES,
    Value = HARD_MAX_CUES,
  })
  table.insert(props, {
    Name = "Max Actions Per Cue",
    Type = "integer",
    Min = 1,
    Max = HARD_MAX_ACTIONS,
    Value = 4,
  })
  table.insert(props, {
    Name = "Max Devices",
    Type = "integer",
    Min = 0,
    Max = HARD_MAX_DEVICES,
    Value = 12,
  })
  table.insert(props, {
    Name = "UDP Targets",
    Type = "integer",
    Min = 0,
    Max = HARD_MAX_UDP,
    Value = 6,
  })
  table.insert(props, {
    Name = "Show Debug",
    Type = "boolean",
    Value = false,
  })
  return props
end

--=============================================================================
-- Design time: Controls
--
-- This is a STATIC, fixed-size control set sized only from the Properties
-- above. It never changes at runtime. Note there is no longer a MaxCues x
-- MaxActions grid of action controls -- the Show Editor now has ONE bank of
-- MaxActions action rows that gets repointed at whichever cue is selected,
-- so the control count no longer explodes with cue count.
--=============================================================================
function GetControls(props)
  local maxCues = props["Max Cues"].Value
  local maxActions = props["Max Actions Per Cue"].Value
  local maxDevices = props["Max Devices"].Value
  local numUdp = props["UDP Targets"].Value

  local ctrls = {}
  local function add(t) table.insert(ctrls, t) end

  -- Transport / global status -------------------------------------------------
  add({ Name = "GoButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "StopAllButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "PanicButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })

  add({ Name = "StatusLed", ControlType = "Indicator", IndicatorType = "Status", Count = 1 })
  add({ Name = "StatusText", ControlType = "Text", Count = 1 })
  add({ Name = "StatusStateText", ControlType = "Text", Count = 1 })
  add({ Name = "NextCueText", ControlType = "Text", Count = 1 })
  add({ Name = "ErrorLed", ControlType = "Indicator", IndicatorType = "Status", Count = 1 })
  add({ Name = "ErrorText", ControlType = "Text", Count = 1 })

  add({ Name = "ShowNameText", ControlType = "Text", Count = 1 })
  add({ Name = "LastModifiedText", ControlType = "Text", Count = 1 })
  add({ Name = "UnsavedLed", ControlType = "Indicator", IndicatorType = "Status", Count = 1 })
  add({ Name = "LockToggle", ControlType = "Button", ButtonType = "Toggle", Count = 1 })

  add({ Name = "GlobalStopControlName", ControlType = "Text", Count = 1 })
  add({ Name = "PanicUdpPayload", ControlType = "Text", Count = 1 })

  -- Hidden persistence control (never placed in GetControlLayout) -------------
  add({ Name = "ShowData", ControlType = "Text", Count = 1 })

  -- Export / Import / Log ------------------------------------------------------
  add({ Name = "ExportData", ControlType = "Text", Count = 1 })
  add({ Name = "ExportButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "ImportData", ControlType = "Text", Count = 1 })
  add({ Name = "ImportButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
  add({ Name = "ImportErrorText", ControlType = "Text", Count = 1 })
  add({ Name = "CueLogText", ControlType = "Text", Count = 1 })

  -- Devices page: curated component references + UDP targets. These are the
  -- ONLY entries offered in the Show Editor's action Target dropdowns.
  if maxDevices > 0 then
    add({ Name = "DeviceName", ControlType = "Text", Count = maxDevices })
    add({ Name = "DeviceComponent", ControlType = "Text", Count = maxDevices })
  end
  if numUdp > 0 then
    add({ Name = "UdpTargetName", ControlType = "Text", Count = numUdp })
    add({ Name = "UdpTargetIp", ControlType = "Text", Count = numUdp })
    add({ Name = "UdpTargetPort", ControlType = "Knob", ControlUnit = "Integer", Min = 1, Max = 65535, Count = numUdp })
    add({ Name = "UdpTargetStatus", ControlType = "Text", Count = numUdp })
  end

  -- Cue quick-fire grid (Live Show page) ---------------------------------------
  add({ Name = "CueButton", ControlType = "Button", ButtonType = "Trigger", Count = maxCues })

  -- Show Editor: single "currently selected cue" authoring bank ---------------
  add({ Name = "SelectedCue", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditName", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditNotes", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditColor", ControlType = "Text", Count = 1 })
  add({ Name = "CueEditArm", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "CueEditConfirm", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
  add({ Name = "AddActionButton", ControlType = "Button", ButtonType = "Trigger", Count = 1 })

  add({ Name = "ActionType", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionTarget", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionControl", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionValue", ControlType = "Text", Count = maxActions })
  add({ Name = "ActionValueBool", ControlType = "Button", ButtonType = "Toggle", Count = maxActions })
  add({ Name = "ActionRemove", ControlType = "Button", ButtonType = "Trigger", Count = maxActions })

  return ctrls
end

--=============================================================================
-- Design time: Pages, icon color/name, and Layout
--=============================================================================
local PageNames = { "Live Show", "Devices", "Show Editor" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetColor(props)
  return { 41, 98, 255 } -- accent blue, shown on the component's schematic icon
end

function GetPrettyName(props)
  return string.format("Show Cue Engine (%d cues)", props["Max Cues"].Value)
end

function GetControlLayout(props)
  local maxCues = props["Max Cues"].Value
  local maxActions = props["Max Actions Per Cue"].Value
  local maxDevices = props["Max Devices"].Value
  local numUdp = props["UDP Targets"].Value
  local currentPage = PageNames[props["page_index"].Value]

  local layout = {}
  local graphics = {}

  -- Q-SYS addresses arrayed controls in the layout table as "Name" (Count==1)
  -- or "Name N" (Count>1, 1-based, space-separated) -- NOT "Name[N]".
  local function key(name, count, i)
    if count <= 1 then return name end
    return name .. " " .. i
  end

  -- Shared palette -----------------------------------------------------------
  local PageBg  = { 235, 238, 242 }
  local Card    = { 255, 255, 255 }
  local Border  = { 213, 219, 226 }
  local Muted   = { 226, 230, 235 } -- subtle row banding
  local Accent  = { 41, 98, 255 }
  local Success = { 24, 160, 90 }
  local Warning = { 214, 140, 20 }
  local Danger  = { 206, 42, 51 }

  local function pageBackground(w, h)
    graphics[#graphics + 1] = { Type = "GroupBox", Fill = PageBg, StrokeColor = PageBg, StrokeWidth = 0, CornerRadius = 0, Position = { 0, 0 }, Size = { w, h } }
  end

  local function title(text, x, y, w)
    graphics[#graphics + 1] = { Type = "Header", Text = text, HTextAlign = "Left", Position = { x, y }, Size = { w, 18 } }
  end

  local function card(x, y, w, h, heading)
    graphics[#graphics + 1] = {
      Type = "GroupBox", Text = heading or "", HTextAlign = "Left",
      Fill = Card, StrokeColor = Border, StrokeWidth = 1, CornerRadius = 8,
      Position = { x, y }, Size = { w, h },
    }
  end

  if currentPage == "Live Show" then
    ------------------------------------------------------------------------
    -- Page 1: compact operator view -- status, transport, quick-fire grid.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Live", M, 6, 500)

    -- Show strip ------------------------------------------------------------
    card(M, 30, W - 2 * M, 52, "SHOW")
    layout["ShowNameText"] = { PrettyName = "Show Name", Style = "Text", Position = { 28, 48 }, Size = { 260, 20 } }
    layout["LastModifiedText"] = { PrettyName = "Last Modified", Style = "Text", Position = { 300, 48 }, Size = { 170, 20 } }
    layout["UnsavedLed"] = { PrettyName = "Unsaved Changes", Style = "Indicator", Position = { 482, 50 }, Size = { 16, 16 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Unsaved", FontSize = 9, Position = { 502, 48 }, Size = { 64, 20 } }
    layout["LockToggle"] = {
      PrettyName = "Lock Edits", Style = "Button", ButtonStyle = "Toggle", Legend = "LOCK",
      Color = Warning, CornerRadius = 4, Position = { 800, 46 }, Size = { 88, 24 },
    }

    -- Status ------------------------------------------------------------------
    card(M, 94, W - 2 * M, 56, "STATUS")
    layout["StatusLed"] = { PrettyName = "Status", Style = "Indicator", Position = { 28, 112 }, Size = { 20, 20 } }
    layout["StatusText"] = { PrettyName = "Status Text (Cue N: Name)", Style = "Text", Position = { 54, 114 }, Size = { 230, 18 } }
    layout["StatusStateText"] = { PrettyName = "Status State (Ready/Firing/Error)", Style = "Text", Position = { 294, 114 }, Size = { 110, 18 } }
    layout["NextCueText"] = { PrettyName = "Next Cue", Style = "Text", Position = { 414, 114 }, Size = { 220, 18 } }
    layout["ErrorLed"] = { PrettyName = "Error", Style = "Indicator", Position = { 644, 112 }, Size = { 20, 20 } }
    layout["ErrorText"] = { PrettyName = "Error Text", Style = "Text", Position = { 670, 114 }, Size = { 218, 18 } }

    -- Transport -----------------------------------------------------------------
    card(M, 162, W - 2 * M, 54, "TRANSPORT")
    layout["GoButton"] = { PrettyName = "Go", Style = "Button", ButtonStyle = "Trigger", Legend = "GO", Color = Success, CornerRadius = 6, Position = { 28, 178 }, Size = { 120, 30 } }
    layout["StopAllButton"] = { PrettyName = "Stop All", Style = "Button", ButtonStyle = "Trigger", Legend = "STOP ALL", Color = Warning, CornerRadius = 6, Position = { 160, 178 }, Size = { 140, 30 } }
    layout["PanicButton"] = { PrettyName = "Panic", Style = "Button", ButtonStyle = "Trigger", Legend = "PANIC", Color = Danger, CornerRadius = 6, Position = { 312, 178 }, Size = { 140, 30 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Panic uses the Player Stop Control Name and Panic UDP Payload configured on the Show Editor page.", FontSize = 8, Position = { 470, 186 }, Size = { 420, 14 } }

    -- Cue grid (quick-fire) + activity log side-by-side ------------------------
    local gridCols = 6
    local cellW, cellH, gap = 100, 40, 6
    local gridRows = math.ceil(maxCues / gridCols)
    local gridInnerW = gridCols * cellW + (gridCols - 1) * gap
    local gridInnerH = gridRows * cellH + (gridRows - 1) * gap
    local gridCardX, gridCardY = M, 230
    local gridCardW = gridInnerW + 28
    local gridCardH = gridInnerH + 44
    card(gridCardX, gridCardY, gridCardW, gridCardH, "CUES  (tap to fire)")
    local gridX, gridY = gridCardX + 14, gridCardY + 30
    for i = 1, maxCues do
      local col = (i - 1) % gridCols
      local row = math.floor((i - 1) / gridCols)
      layout[key("CueButton", maxCues, i)] = {
        PrettyName = string.format("Cue %d~Fire", i),
        Style = "Button", ButtonStyle = "Trigger",
        Legend = tostring(i),
        Color = { 70, 82, 97 },
        CornerRadius = 6,
        Position = { gridX + col * (cellW + gap), gridY + row * (cellH + gap) },
        Size = { cellW, cellH },
      }
    end

    local logCardX = gridCardX + gridCardW + 12
    local logCardW = W - M - logCardX
    card(logCardX, gridCardY, logCardW, gridCardH, "ACTIVITY LOG")
    layout["CueLogText"] = { PrettyName = "Cue Fire Log", Style = "TextBox", Position = { logCardX + 14, gridCardY + 30 }, Size = { logCardW - 28, gridCardH - 44 } }

    local pageH = gridCardY + gridCardH + M
    pageBackground(W, pageH)

  elseif currentPage == "Devices" then
    ------------------------------------------------------------------------
    -- Page 2: setup -- curated component "Devices" and UDP targets. This is
    -- where you pick from the FULL list of Q-SYS components in the design;
    -- the Show Editor only ever sees the friendly names defined here.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Devices", M, 6, 600)
    local y = 30

    local devH = maxDevices > 0 and (maxDevices * 22 + 34) or 40
    card(M, y, W - 2 * M, devH, "COMPONENTS / DEVICES  (curated -- only these appear as Targets in the Show Editor)")
    if maxDevices > 0 then
      for i = 1, maxDevices do
        local ry = y + 24 + (i - 1) * 22
        layout[key("DeviceName", maxDevices, i)] = { PrettyName = string.format("Device %d~Friendly Name", i), Style = "Text", Position = { 28, ry }, Size = { 220, 18 } }
        layout[key("DeviceComponent", maxDevices, i)] = { PrettyName = string.format("Device %d~Q-SYS Component", i), Style = "ComboBox", Position = { 256, ry }, Size = { 320, 18 } }
      end
    else
      graphics[#graphics + 1] = { Type = "Text", Text = "No device slots configured (set the 'Max Devices' Property to add some).", FontSize = 9, Position = { 28, y + 18 }, Size = { 500, 16 } }
    end
    y = y + devH + 12

    local udpH = numUdp > 0 and (numUdp * 22 + 34) or 40
    card(M, y, W - 2 * M, udpH, "UDP TARGETS")
    if numUdp > 0 then
      for i = 1, numUdp do
        local ry = y + 24 + (i - 1) * 22
        layout[key("UdpTargetName", numUdp, i)] = { PrettyName = string.format("UDP Target %d~Name", i), Style = "Text", Position = { 28, ry }, Size = { 140, 18 } }
        layout[key("UdpTargetIp", numUdp, i)] = { PrettyName = string.format("UDP Target %d~IP", i), Style = "Text", Position = { 176, ry }, Size = { 120, 18 } }
        layout[key("UdpTargetPort", numUdp, i)] = { PrettyName = string.format("UDP Target %d~Port", i), Style = "TextBox", TextBoxStyle = "Meter", Position = { 304, ry }, Size = { 80, 18 } }
        layout[key("UdpTargetStatus", numUdp, i)] = { PrettyName = string.format("UDP Target %d~Status", i), Style = "Text", Position = { 392, ry }, Size = { 200, 18 } }
      end
    else
      graphics[#graphics + 1] = { Type = "Text", Text = "No UDP targets configured (set the 'UDP Targets' Property to add some).", FontSize = 9, Position = { 28, y + 18 }, Size = { 500, 16 } }
    end
    y = y + udpH + M

    pageBackground(W, y)

  elseif currentPage == "Show Editor" then
    ------------------------------------------------------------------------
    -- Page 3: pick a cue from a dropdown, edit only that cue. Actions are
    -- revealed one at a time via "+ Add Action" rather than showing every
    -- action slot for every cue at once.
    ------------------------------------------------------------------------
    local W = 920
    local M = 16

    title("SHOW CUE ENGINE  ~  Show Editor", M, 6, 600)
    local y = 30

    -- Panic / stop settings -----------------------------------------------------
    card(M, y, W - 2 * M, 54, "GLOBAL STOP / PANIC SETTINGS")
    layout["GlobalStopControlName"] = { PrettyName = "Player Stop Control Name", Style = "Text", Position = { 28, y + 18 }, Size = { 300, 26 } }
    layout["PanicUdpPayload"] = { PrettyName = "Panic UDP Payload", Style = "Text", Position = { 344, y + 18 }, Size = { 300, 26 } }
    y = y + 54 + 12

    -- Export / Import -------------------------------------------------------------
    card(M, y, W - 2 * M, 172, "EXPORT / IMPORT SHOW (copy-paste JSON)")
    layout["ExportButton"] = { PrettyName = "Export Show", Style = "Button", ButtonStyle = "Trigger", Legend = "Export", Color = Accent, CornerRadius = 4, Position = { 28, y + 18 }, Size = { 100, 22 } }
    layout["ExportData"] = { PrettyName = "Export JSON (copy this)", Style = "TextBox", Position = { 28, y + 46 }, Size = { 320, 100 } }
    layout["ImportButton"] = { PrettyName = "Import Show", Style = "Button", ButtonStyle = "Trigger", Legend = "Import", Color = Accent, CornerRadius = 4, Position = { 364, y + 18 }, Size = { 100, 22 } }
    layout["ImportData"] = { PrettyName = "Import JSON (paste here)", Style = "TextBox", Position = { 364, y + 46 }, Size = { 320, 100 } }
    layout["ImportErrorText"] = { PrettyName = "Import Error", Style = "Text", Position = { 364, y + 150 }, Size = { 320, 18 } }
    graphics[#graphics + 1] = {
      Type = "Text",
      Text = "Export first to see the exact JSON shape. A rejected import never partially overwrites the live show.",
      FontSize = 9, Position = { 700, y + 46 }, Size = { W - 2 * M - 700 + M, 60 },
    }
    y = y + 172 + 12

    -- Cue editor: ONE selected cue at a time -------------------------------------
    -- Action rows can now run up to HARD_MAX_ACTIONS (25) tall. There is no
    -- dedicated "scrollable list" control in the Q-SYS Lua layout API -- like
    -- any component whose canvas is taller than the visible pane, Designer's
    -- own Properties/Schematic panel scrolls it natively, the same mechanism
    -- this page already relied on before. The card is sized to fit every row
    -- so nothing is clipped; scrolling to reach lower rows is expected once
    -- Max Actions Per Cue is set much above the default.
    local rowH = 24
    local editorH = 132 + maxActions * rowH
    card(M, y, W - 2 * M, editorH, "CUE EDITOR  (scrolls with the page once Max Actions Per Cue is large)")
    layout["SelectedCue"] = { PrettyName = "Select Cue", Style = "ComboBox", Position = { 28, y + 18 }, Size = { 240, 20 } }
    layout["CueEditColor"] = { PrettyName = "Cue Color (#RRGGBB)", Style = "Text", Position = { 280, y + 18 }, Size = { 80, 20 } }
    layout["CueEditArm"] = { PrettyName = "Armed", Style = "Button", ButtonStyle = "Toggle", Legend = "Arm", Color = Success, CornerRadius = 4, Position = { 368, y + 18 }, Size = { 56, 20 } }
    layout["CueEditConfirm"] = { PrettyName = "Confirm Before Fire", Style = "Button", ButtonStyle = "Toggle", Legend = "Confirm", Color = Warning, CornerRadius = 4, Position = { 432, y + 18 }, Size = { 74, 20 } }

    layout["CueEditName"] = { PrettyName = "Rename Cue", Style = "Text", Position = { 28, y + 46 }, Size = { 300, 20 } }
    layout["CueEditNotes"] = { PrettyName = "Notes (run sheet)", Style = "Text", Position = { 336, y + 46 }, Size = { W - 2 * M - 336 - 14, 20 } }

    graphics[#graphics + 1] = { Type = "Text", Text = "Type", FontSize = 8, Position = { 28, y + 74 }, Size = { 110, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Target (device / UDP target)", FontSize = 8, Position = { 146, y + 74 }, Size = { 160, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Control", FontSize = 8, Position = { 314, y + 74 }, Size = { 140, 12 } }
    graphics[#graphics + 1] = { Type = "Text", Text = "Value (auto: toggle for Boolean controls, text otherwise)", FontSize = 8, Position = { 462, y + 74 }, Size = { 160, 12 } }

    local rowsY = y + 88
    for a = 1, maxActions do
      local ry = rowsY + (a - 1) * rowH
      layout[key("ActionType", maxActions, a)] = { PrettyName = string.format("Action %d~Type", a), Style = "ComboBox", Position = { 28, ry }, Size = { 110, 20 } }
      layout[key("ActionTarget", maxActions, a)] = { PrettyName = string.format("Action %d~Target", a), Style = "ComboBox", Position = { 146, ry }, Size = { 160, 20 } }
      layout[key("ActionControl", maxActions, a)] = { PrettyName = string.format("Action %d~Control", a), Style = "ComboBox", Position = { 314, ry }, Size = { 140, 20 } }
      -- ActionValue (free text) and ActionValueBool (toggle) occupy the exact
      -- same rect -- only one is ever visible at a time (runtime picks based
      -- on the selected control's discovered Type), so they swap seamlessly.
      layout[key("ActionValue", maxActions, a)] = { PrettyName = string.format("Action %d~Value", a), Style = "Text", Position = { 462, ry }, Size = { 160, 20 } }
      layout[key("ActionValueBool", maxActions, a)] = { PrettyName = string.format("Action %d~Value (Boolean)", a), Style = "Button", ButtonStyle = "Toggle", Legend = "FALSE", Color = Success, OffColor = { 150, 155, 162 }, CornerRadius = 4, Position = { 462, ry }, Size = { 160, 20 } }
      layout[key("ActionRemove", maxActions, a)] = { PrettyName = string.format("Action %d~Remove", a), Style = "Button", ButtonStyle = "Trigger", Legend = "X", Color = Danger, CornerRadius = 4, Position = { 630, ry }, Size = { 30, 20 } }
    end
    layout["AddActionButton"] = { PrettyName = "Add Action", Style = "Button", ButtonStyle = "Trigger", Legend = "+ Add Action", Color = Accent, CornerRadius = 4, Position = { 28, rowsY + maxActions * rowH + 8 }, Size = { 130, 22 } }

    y = y + editorH + M
    pageBackground(W, y)
  end

  return layout, graphics
end

--=============================================================================
-- Runtime
-- Design-time editing (Designer canvas open, no live Controls table) must
-- never execute runtime logic -- everything below is guarded by `if Controls`.
--=============================================================================
if Controls then

local rapidjson = require("rapidjson")

local MaxCues = Properties["Max Cues"].Value
local MaxActions = Properties["Max Actions Per Cue"].Value
local MaxDevices = Properties["Max Devices"].Value
local NumUdp = Properties["UDP Targets"].Value
local DebugOn = Properties["Show Debug"].Value

local ActionTypes = { "none", "player_trigger", "udp_send", "named_control_set" }
local ActionTypeSet = {}
for _, t in ipairs(ActionTypes) do ActionTypeSet[t] = true end

-- Matches the RGB palette used in GetControlLayout (Accent/Warning/Danger/Success).
local StateColors = {
  armed = "#2962FF",
  firing = "#D68C14",
  error = "#CE2A33",
  ready = "#18A05A",
  neutral = "#6E7680",
}

-- ----------------------------------------------------------------------------
-- Forward-declared locals so all runtime functions can freely reference each
-- other regardless of definition order.
-- ----------------------------------------------------------------------------
local dbg, MarkDirty, SaveShowData, LoadShowData, ApplyShowTable, BuildShowTable, ValidateShowTable
local ClampActionType, PushUdpTargetToControls
local GetComponent, RebuildComponentCache, AllComponentNameList, DeviceNameList, UdpTargetNameList
local ResolveDeviceComponent, FindControlDescriptor
local RefreshActionTargetChoices, RefreshActionControlChoices, RefreshVisibleActionChoices, RefreshActionValueEditor
local RefreshCueButtonColor, RefreshSelectedCueChoices, RefreshActionRowVisibility
local SelectCue, PushSelectedCueToEditor
local DoPlayerTrigger, DoNamedControlSet, DoUdpSend, DispatchAction, ParseValueSpec
local FindUdpTargetByName, OpenUdpSocket
local SetStatusMessage, SetError, UpdateStatus, LogCueFire
local FireCueNow, OnCueButtonPressed, StopAllPlayers, StartPingHeartbeat, CallAfter
local Init

-- ----------------------------------------------------------------------------
-- State
-- ----------------------------------------------------------------------------
local Cues = {}          -- 1..MaxCues -> { name, notes, color, armed, confirm, state, activeActions, actions = {1..MaxActions} }
local Devices = {}       -- 1..MaxDevices -> { name, component } (friendly name -> real Q-SYS component name)
local UdpTargets = {}    -- 1..NumUdp  -> { name, ip, port }
local UdpSockets = {}    -- 1..NumUdp  -> UdpSocket object (or nil if never opened / failed)
local ComponentCache = {}-- real component name -> Component handle, or false if resolution failed
local LastFireTime = {}  -- cue index -> os.clock() of last accepted fire (debounce)
local PendingConfirm = {}-- cue index -> os.clock() of first press awaiting confirmation
local CueLog = {}        -- most-recent-first array of log line strings
local SelectedCueIndex = 1
local CurrentCueIndex = 0
local NextCueIndex = 1
local LastTelemetryUpdate = 0.0
local Loading = true     -- true while Init()/ApplyShowTable()/SelectCue() are pushing data into
                          -- Controls programmatically, so those writes don't re-trigger edit handlers.

local CONFIRM_WINDOW_MS = 2000
local DEBOUNCE_MS = 150
local TELEMETRY_THROTTLE_MS = 100 -- caps UDP RX status updates at ~10/sec
local CUE_LOG_MAX = 25

--=============================================================================
-- Small helpers
--=============================================================================
dbg = function(fmt, ...)
  if DebugOn then
    print(string.format("[CueEngine] " .. fmt, ...))
  end
end

-- One-shot timer helper built on the confirmed Timer.New()/.EventHandler/:Start()/:Stop()
-- pattern (there is no separate Timer.CallAfter used here, to avoid relying on an
-- unverified API surface).
CallAfter = function(fn, seconds)
  local t = Timer.New()
  t.EventHandler = function()
    t:Stop()
    fn()
  end
  t:Start(seconds)
end

ClampActionType = function(t)
  if ActionTypeSet[t] then return t end
  return "none"
end

ParseValueSpec = function(spec)
  -- named_control_set value syntax: "V:<num>"=.Value  "P:<num>"=.Position (0..1)
  -- "S:<text>"=.String  "B:true"/"B:false"=.Boolean (written by the auto Value
  -- toggle -- see RefreshActionValueEditor)  "T" / "" / anything unrecognized
  -- = :Trigger()
  if spec == nil or spec == "" then return "trigger", nil end
  local upper = spec:upper()
  if upper == "T" or upper == "TRIGGER" then return "trigger", nil end
  local mode, data = spec:match("^([VPSB]):(.*)$")
  if mode == "V" then return "value", tonumber(data)
  elseif mode == "P" then return "position", tonumber(data)
  elseif mode == "S" then return "string", data
  elseif mode == "B" then return "boolean", (data == "true")
  end
  return "trigger", nil
end

--=============================================================================
-- Component / Device resolution
--
-- Devices[] is the curated friendly-name -> real-component-name mapping
-- configured on the Devices page. Actions reference a Device name; this is
-- resolved to a real Q-SYS component name here, then to a live Component
-- handle via GetComponent() -- resolved & cached once, never looked up in
-- the cue-fire path itself.
--=============================================================================
GetComponent = function(name)
  if name == nil or name == "" then return nil end
  if ComponentCache[name] == nil then
    local ok, comp = pcall(Component.New, name)
    ComponentCache[name] = ok and comp or false
  end
  if ComponentCache[name] == false then return nil end
  return ComponentCache[name]
end

ResolveDeviceComponent = function(deviceName)
  for i = 1, MaxDevices do
    if Devices[i].name == deviceName then return Devices[i].component end
  end
  return nil
end

RebuildComponentCache = function()
  local seen = {}
  for i = 1, MaxCues do
    for a = 1, MaxActions do
      local act = Cues[i].actions[a]
      if act.type == "player_trigger" or act.type == "named_control_set" then
        local compName = ResolveDeviceComponent(act.target)
        if compName and compName ~= "" then seen[compName] = true end
      end
    end
  end
  for name, _ in pairs(seen) do
    GetComponent(name)
  end
end

-- The FULL, raw list of every component in the design. Used ONLY to populate
-- the Devices page's "Q-SYS Component" picker -- never surfaced directly in
-- the Show Editor, which only ever sees the curated Devices[] list below.
AllComponentNameList = function()
  local names = {}
  local ok, comps = pcall(Component.GetComponents)
  if ok and type(comps) == "table" then
    for _, c in pairs(comps) do
      if c.Name then table.insert(names, c.Name) end
    end
    table.sort(names)
  end
  return names
end

DeviceNameList = function()
  local names = {}
  for i = 1, MaxDevices do
    if Devices[i].name ~= "" then table.insert(names, Devices[i].name) end
  end
  return names
end

UdpTargetNameList = function()
  local names = {}
  for i = 1, NumUdp do table.insert(names, UdpTargets[i].name) end
  return names
end

RefreshActionTargetChoices = function(a)
  local t = Cues[SelectedCueIndex].actions[a].type
  pcall(function()
    if t == "udp_send" then
      Controls.ActionTarget[a].Choices = UdpTargetNameList()
    elseif t == "player_trigger" or t == "named_control_set" then
      Controls.ActionTarget[a].Choices = DeviceNameList()
    else
      Controls.ActionTarget[a].Choices = {}
    end
  end)
end

-- Auto-populates the Control dropdown from the LIVE component's own controls.
-- FIX: Component.GetControls() requires the actual Component.New() proxy
-- (what GetComponent() returns / caches), NOT the lightweight descriptor
-- table returned by Component.GetComponents() -- passing the latter is why
-- this previously failed to find any controls, including ones exposed via a
-- component's own GetControls()/pin wiring. Still pcall-wrapped: if this
-- ever doesn't populate for a particular component, ActionControl simply
-- stays a free-typed text field, which always works.
RefreshActionControlChoices = function(a)
  local act = Cues[SelectedCueIndex].actions[a]
  if act.type ~= "player_trigger" and act.type ~= "named_control_set" then return end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return end
  local comp = GetComponent(compName)
  if not comp then return end
  pcall(function()
    local names = {}
    for _, ctrl in ipairs(Component.GetControls(comp)) do
      if ctrl.Name then table.insert(names, ctrl.Name) end
    end
    table.sort(names)
    Controls.ActionControl[a].Choices = names
  end)
end

RefreshVisibleActionChoices = function()
  local c = Cues[SelectedCueIndex]
  for a = 1, c.activeActions do
    RefreshActionTargetChoices(a)
  end
end

-- Looks up one control's descriptor (Name/Value/String/Position/Type/
-- Direction/MinValue/MaxValue/...) on a real component via the same
-- Component.GetControls(proxy) call used above. Used to auto-detect whether
-- a named_control_set action's Value editor should be a Boolean toggle or a
-- free-text field.
FindControlDescriptor = function(compName, controlName)
  local comp = GetComponent(compName)
  if not comp then return nil end
  local ok, list = pcall(Component.GetControls, comp)
  if not ok or type(list) ~= "table" then return nil end
  for _, ctrl in ipairs(list) do
    if ctrl.Name == controlName then return ctrl end
  end
  return nil
end

-- Auto-adjusts the Value editor for action slot `a`: a Boolean toggle for
-- Boolean controls, hidden entirely for Trigger controls or player_trigger
-- (which never has a value), and the plain text field otherwise (also used
-- for udp_send's raw payload). ActionValue and ActionValueBool occupy the
-- same on-screen rect, so only one is ever visible at once.
RefreshActionValueEditor = function(a)
  local act = Cues[SelectedCueIndex].actions[a]
  local showText, showBool = false, false
  if act.type == "udp_send" then
    showText = true
  elseif act.type == "named_control_set" then
    local compName = ResolveDeviceComponent(act.target)
    local desc = nil
    if compName and compName ~= "" and act.control ~= "" then
      desc = FindControlDescriptor(compName, act.control)
    end
    if desc and desc.Type == "Boolean" then
      showBool = true
    elseif desc and desc.Type == "Trigger" then
      showText, showBool = false, false
    else
      showText = true
    end
  end
  pcall(function()
    Controls.ActionValue[a].IsInvisible = not showText
    Controls.ActionValueBool[a].IsInvisible = not showBool
    if showBool then
      local mode, data = ParseValueSpec(act.value)
      local boolVal = (mode == "boolean" and data) or false
      Controls.ActionValueBool[a].Boolean = boolVal
      Controls.ActionValueBool[a].Legend = boolVal and "TRUE" or "FALSE"
    end
  end)
end

--=============================================================================
-- Persistence (rapidjson <-> hidden ShowData string control)
--=============================================================================
BuildShowTable = function()
  local cuesOut = {}
  for i = 1, MaxCues do
    local c = Cues[i]
    local actionsOut = {}
    for a = 1, MaxActions do
      local act = c.actions[a]
      table.insert(actionsOut, { type = act.type, target = act.target, control = act.control, value = act.value })
    end
    table.insert(cuesOut, {
      id = i, name = c.name, notes = c.notes, color = c.color,
      armed = c.armed, confirm = c.confirm, activeActions = c.activeActions,
      actions = actionsOut,
    })
  end
  local devicesOut = {}
  for i = 1, MaxDevices do
    table.insert(devicesOut, { name = Devices[i].name, component = Devices[i].component })
  end
  local udpOut = {}
  for i = 1, NumUdp do
    table.insert(udpOut, { name = UdpTargets[i].name, ip = UdpTargets[i].ip, port = UdpTargets[i].port })
  end
  return {
    showName = Controls.ShowNameText.String,
    lastModified = os.date("%Y-%m-%d %H:%M:%S"),
    cues = cuesOut,
    devices = devicesOut,
    udpTargets = udpOut,
  }
end

SaveShowData = function()
  local ok, encoded = pcall(rapidjson.encode, BuildShowTable())
  if ok then
    Controls.ShowData.String = encoded
    pcall(function() Controls.LastModifiedText.String = os.date("%Y-%m-%d %H:%M:%S") end)
  else
    dbg("Failed to encode show data: %s", tostring(encoded))
  end
end

ApplyShowTable = function(data)
  if type(data) ~= "table" then return end
  if data.showName ~= nil then
    pcall(function() Controls.ShowNameText.String = tostring(data.showName) end)
  end
  if type(data.cues) == "table" then
    for i = 1, MaxCues do
      local src = data.cues[i]
      local c = Cues[i]
      if src then
        c.name = tostring(src.name or c.name)
        c.notes = tostring(src.notes or "")
        c.color = tostring(src.color or c.color)
        c.armed = src.armed and true or false
        c.confirm = src.confirm and true or false
        local highestUsed = 0
        for a = 1, MaxActions do
          local srcAct = src.actions and src.actions[a]
          if srcAct then
            c.actions[a] = {
              type = ClampActionType(tostring(srcAct.type or "none")),
              target = tostring(srcAct.target or ""),
              control = tostring(srcAct.control or ""),
              value = tostring(srcAct.value or ""),
            }
          else
            c.actions[a] = { type = "none", target = "", control = "", value = "" }
          end
          if c.actions[a].type ~= "none" then highestUsed = a end
        end
        local aa = tonumber(src.activeActions)
        if aa and aa >= 0 and aa <= MaxActions then
          c.activeActions = math.floor(aa)
        else
          c.activeActions = highestUsed
        end
      end
    end
  end
  if type(data.devices) == "table" then
    for i = 1, MaxDevices do
      local src = data.devices[i]
      if src then
        Devices[i].name = tostring(src.name or Devices[i].name)
        Devices[i].component = tostring(src.component or "")
      end
      pcall(function()
        Controls.DeviceName[i].String = Devices[i].name
        Controls.DeviceComponent[i].String = Devices[i].component
      end)
    end
  end
  if type(data.udpTargets) == "table" then
    for i = 1, NumUdp do
      local src = data.udpTargets[i]
      if src then
        UdpTargets[i].name = tostring(src.name or UdpTargets[i].name)
        UdpTargets[i].ip = tostring(src.ip or "")
        UdpTargets[i].port = tonumber(src.port) or 0
      end
      PushUdpTargetToControls(i)
    end
  end

  local wasLoading = Loading
  Loading = true
  for i = 1, MaxCues do RefreshCueButtonColor(i) end
  RefreshSelectedCueChoices()
  SelectedCueIndex = 1
  PushSelectedCueToEditor()
  Loading = wasLoading
end

LoadShowData = function()
  local raw = Controls.ShowData.String
  if raw ~= nil and raw ~= "" then
    local ok, data = pcall(rapidjson.decode, raw)
    if ok and type(data) == "table" then
      ApplyShowTable(data)
      dbg("Loaded show data from persisted ShowData control")
      return true
    else
      dbg("Failed to decode persisted ShowData: %s", tostring(data))
    end
  end
  return false
end

-- Strict validation used only for operator-triggered Import (never for the
-- boot-time load above, which trusts its own previously-saved data). Rejects
-- with a clear message and commits nothing on any invalid input.
ValidateShowTable = function(data)
  if type(data) ~= "table" then return false, "Import data is not a JSON object" end
  if data.cues ~= nil then
    if type(data.cues) ~= "table" then return false, "'cues' must be an array" end
    if #data.cues > MaxCues then
      return false, string.format("Too many cues: %d (max %d)", #data.cues, MaxCues)
    end
    for i, c in ipairs(data.cues) do
      if type(c) ~= "table" then return false, string.format("Cue %d is not an object", i) end
      if c.activeActions ~= nil then
        local aa = tonumber(c.activeActions)
        if not aa or aa < 0 or aa > MaxActions then
          return false, string.format("Cue %d has invalid activeActions: %s", i, tostring(c.activeActions))
        end
      end
      if c.actions ~= nil then
        if type(c.actions) ~= "table" then return false, string.format("Cue %d 'actions' must be an array", i) end
        if #c.actions > MaxActions then
          return false, string.format("Cue %d has too many actions: %d (max %d)", i, #c.actions, MaxActions)
        end
        for j, act in ipairs(c.actions) do
          if type(act) ~= "table" then return false, string.format("Cue %d action %d is not an object", i, j) end
          if act.type ~= nil and not ActionTypeSet[act.type] then
            return false, string.format("Cue %d action %d has invalid type: %s", i, j, tostring(act.type))
          end
        end
      end
    end
  end
  if data.devices ~= nil then
    if type(data.devices) ~= "table" then return false, "'devices' must be an array" end
    if #data.devices > MaxDevices then
      return false, string.format("Too many devices: %d (max %d)", #data.devices, MaxDevices)
    end
    for i, d in ipairs(data.devices) do
      if type(d) ~= "table" then return false, string.format("Device %d is not an object", i) end
    end
  end
  if data.udpTargets ~= nil then
    if type(data.udpTargets) ~= "table" then return false, "'udpTargets' must be an array" end
    if #data.udpTargets > NumUdp then
      return false, string.format("Too many UDP targets: %d (max %d)", #data.udpTargets, NumUdp)
    end
    for i, t in ipairs(data.udpTargets) do
      if type(t) ~= "table" then return false, string.format("UDP target %d is not an object", i) end
      if t.ip ~= nil and t.ip ~= "" and not tostring(t.ip):match("^%d+%.%d+%.%d+%.%d+$") then
        return false, string.format("UDP target %d has invalid IP: %s", i, tostring(t.ip))
      end
      -- Port 0 is the sentinel for "not yet configured" (used by never-set-up
      -- default targets), so it is only validated once an IP is also present.
      if t.port ~= nil and t.ip ~= nil and t.ip ~= "" then
        local p = tonumber(t.port)
        if not p or p < 1 or p > 65535 then
          return false, string.format("UDP target %d has invalid port: %s", i, tostring(t.port))
        end
      end
    end
  end
  return true
end

PushUdpTargetToControls = function(i)
  local t = UdpTargets[i]
  pcall(function()
    Controls.UdpTargetName[i].String = t.name
    Controls.UdpTargetIp[i].String = t.ip
    Controls.UdpTargetPort[i].Value = t.port
  end)
end

--=============================================================================
-- Cue editor: select-one-cue-at-a-time UI
--=============================================================================
RefreshSelectedCueChoices = function()
  local list = {}
  for i = 1, MaxCues do table.insert(list, string.format("%d: %s", i, Cues[i].name)) end
  pcall(function() Controls.SelectedCue.Choices = list end)
end

RefreshActionRowVisibility = function()
  local c = Cues[SelectedCueIndex]
  for a = 1, MaxActions do
    local visible = a <= c.activeActions
    pcall(function()
      Controls.ActionType[a].IsInvisible = not visible
      Controls.ActionTarget[a].IsInvisible = not visible
      Controls.ActionControl[a].IsInvisible = not visible
      Controls.ActionRemove[a].IsInvisible = not visible
    end)
    if visible then
      -- Active row: let RefreshActionValueEditor decide Value vs. Value(Boolean).
      RefreshActionValueEditor(a)
    else
      pcall(function()
        Controls.ActionValue[a].IsInvisible = true
        Controls.ActionValueBool[a].IsInvisible = true
      end)
    end
  end
  pcall(function() Controls.AddActionButton.IsDisabled = (c.activeActions >= MaxActions) end)
end

PushSelectedCueToEditor = function()
  local c = Cues[SelectedCueIndex]
  pcall(function()
    Controls.SelectedCue.String = string.format("%d: %s", SelectedCueIndex, c.name)
    Controls.CueEditName.String = c.name
    Controls.CueEditNotes.String = c.notes
    Controls.CueEditColor.String = c.color
    Controls.CueEditArm.Boolean = c.armed
    Controls.CueEditConfirm.Boolean = c.confirm
  end)
  for a = 1, MaxActions do
    local act = c.actions[a]
    pcall(function()
      Controls.ActionType[a].String = act.type
      Controls.ActionTarget[a].String = act.target
      Controls.ActionControl[a].String = act.control
      Controls.ActionValue[a].String = act.value
    end)
    RefreshActionTargetChoices(a)
    RefreshActionControlChoices(a)
  end
  RefreshActionRowVisibility()
end

SelectCue = function(i)
  if i < 1 or i > MaxCues then return end
  SelectedCueIndex = i
  local wasLoading = Loading
  Loading = true
  PushSelectedCueToEditor()
  Loading = wasLoading
end

--=============================================================================
-- UI feedback
--=============================================================================
RefreshCueButtonColor = function(i)
  local c = Cues[i]
  local color = c.color
  if c.state == "firing" then color = StateColors.firing
  elseif c.state == "error" then color = StateColors.error
  elseif c.armed then color = StateColors.armed
  end
  pcall(function()
    Controls.CueButton[i].Color = color
    local label = (c.name ~= nil and c.name ~= "") and c.name or ("Cue " .. i)
    Controls.CueButton[i].Legend = string.format("%d: %s", i, label)
  end)
end

MarkDirty = function()
  pcall(function() Controls.UnsavedLed.Color = "#FFA500" end)
  -- There is no Lua-accessible signal for Designer's "Save to Core" action, so this
  -- indicator is a one-way reminder once any edit happens this session -- see README.
end

SetStatusMessage = function(msg)
  pcall(function()
    Controls.StatusStateText.String = "Ready"
    Controls.StatusLed.Color = StateColors.ready
  end)
end

SetError = function(msg)
  pcall(function()
    Controls.ErrorText.String = msg
    Controls.ErrorLed.Color = StateColors.error
    Controls.StatusStateText.String = "Error"
    Controls.StatusLed.Color = StateColors.error
  end)
  if DebugOn then print("[CueEngine][ERROR] " .. tostring(msg)) end
end

UpdateStatus = function(i)
  pcall(function()
    Controls.StatusText.String = string.format("Cue %d: %s", i, Cues[i].name)
    if NextCueIndex <= MaxCues and NextCueIndex ~= i then
      Controls.NextCueText.String = string.format("Next: %d: %s", NextCueIndex, Cues[NextCueIndex].name)
    else
      Controls.NextCueText.String = "Next: End of Show"
    end
  end)
end

LogCueFire = function(i, success)
  local line = string.format("%s  Cue %d: %s  %s", os.date("%H:%M:%S"), i, Cues[i].name, success and "OK" or "ERROR")
  table.insert(CueLog, 1, line)
  while #CueLog > CUE_LOG_MAX do table.remove(CueLog) end
  pcall(function() Controls.CueLogText.String = table.concat(CueLog, "\n") end)
  if DebugOn then print("[CueEngine] " .. line) end
end

--=============================================================================
-- UDP
--=============================================================================
FindUdpTargetByName = function(name)
  for i = 1, NumUdp do
    if UdpTargets[i].name == name then return i end
  end
  return nil
end

-- One shared UdpSocket per configured target slot, opened once here at init
-- and never re-opened on a per-fire basis. Sockets are keyed by the fixed
-- 1..NumUdp slot index rather than by the (operator-editable) target name,
-- since the name can be renamed live at runtime -- the slot index is the
-- stable identity. Destination IP/Port are read fresh from UdpTargets[i] on
-- every Send(), so editing a target's IP/Port live never requires reopening
-- its socket.
OpenUdpSocket = function(i)
  local ok, sockOrErr = pcall(function()
    local s = UdpSocket.New()
    s.EventHandler = function(sockObj, packet)
      local now = os.clock()
      if (now - LastTelemetryUpdate) * 1000 < TELEMETRY_THROTTLE_MS then return end
      LastTelemetryUpdate = now
      pcall(function()
        Controls.UdpTargetStatus[i].String = string.format("RX %s: %s", tostring(packet.Address), tostring(packet.Data))
      end)
    end
    s:Open(nil, 0)
    return s
  end)
  if ok then
    UdpSockets[i] = sockOrErr
    pcall(function() Controls.UdpTargetStatus[i].String = "Open" end)
  else
    UdpSockets[i] = nil
    pcall(function() Controls.UdpTargetStatus[i].String = "Error: " .. tostring(sockOrErr) end)
    dbg("Failed to open UDP socket for target %d: %s", i, tostring(sockOrErr))
  end
end

--=============================================================================
-- Action dispatch
-- Each Do* function is fully pcall-wrapped internally and returns (ok, err)
-- rather than throwing, so one failing action in a cue never blocks the
-- other simultaneous actions in that same cue.
--=============================================================================

-- ASSUMPTION (flagged per deliverable requirement): the exact set of control
-- names exposed by a Media/Stream Player component (e.g. "play"/"stop"/
-- "cue"/"select.1") depends on the specific Player component type, which was
-- not specified for this build. player_trigger therefore never hardcodes a
-- control name -- the operator enters/selects it per action (auto-suggested
-- from the live component's own controls where possible via
-- RefreshActionControlChoices), and this simply :Trigger()s whatever control
-- name was given.
DoPlayerTrigger = function(act)
  if act.target == "" or act.control == "" then
    return false, "player_trigger missing target/control"
  end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return false, "Device not configured: " .. act.target end
  local comp = GetComponent(compName)
  if not comp then return false, string.format("Component not found: %s (device '%s')", compName, act.target) end
  local ok, err = pcall(function() comp[act.control]:Trigger() end)
  if not ok then return false, string.format("Component not found: %s (device '%s') (%s)", compName, act.target, tostring(err)) end
  return true
end

DoNamedControlSet = function(act)
  if act.target == "" or act.control == "" then
    return false, "named_control_set missing target/control"
  end
  local compName = ResolveDeviceComponent(act.target)
  if not compName or compName == "" then return false, "Device not configured: " .. act.target end
  local comp = GetComponent(compName)
  if not comp then return false, string.format("Component not found: %s (device '%s')", compName, act.target) end
  local mode, data = ParseValueSpec(act.value)
  local ok, err = pcall(function()
    local ctrl = comp[act.control]
    if mode == "value" then ctrl.Value = data
    elseif mode == "position" then ctrl.Position = data
    elseif mode == "string" then ctrl.String = data
    elseif mode == "boolean" then ctrl.Boolean = data
    else ctrl:Trigger()
    end
  end)
  if not ok then return false, string.format("Component not found: %s (device '%s') (%s)", compName, act.target, tostring(err)) end
  return true
end

-- ASSUMPTION (flagged per deliverable requirement): UDP payload format is
-- raw ASCII with no automatically-appended line terminator -- whatever the
-- operator types into the Value field (Action~Value) is sent byte-for-byte.
-- If a target device needs a terminator (CR, LF, CRLF), the operator should
-- type it explicitly using Lua escapes when authoring via JSON import, e.g.
-- "PLAY\r\n" in the imported JSON string.
DoUdpSend = function(act)
  local targetIdx = FindUdpTargetByName(act.target)
  if not targetIdx then return false, "UDP target not found: " .. tostring(act.target) end
  local sock = UdpSockets[targetIdx]
  if not sock then return false, "UDP socket not open: " .. tostring(act.target) end
  local tgt = UdpTargets[targetIdx]
  local ok, err = pcall(function() sock:Send(tgt.ip, tgt.port, act.value or "") end)
  if not ok then return false, string.format("UDP send failed: %s (%s)", act.target, tostring(err)) end
  return true
end

DispatchAction = function(act)
  if act.type == "player_trigger" then return DoPlayerTrigger(act)
  elseif act.type == "udp_send" then return DoUdpSend(act)
  elseif act.type == "named_control_set" then return DoNamedControlSet(act)
  else return true
  end
end

--=============================================================================
-- Cue firing
--=============================================================================
FireCueNow = function(i)
  local now = os.clock()
  if LastFireTime[i] and (now - LastFireTime[i]) * 1000 < DEBOUNCE_MS then
    dbg("Debounced re-fire of cue %d", i)
    return
  end
  LastFireTime[i] = now

  local cue = Cues[i]
  CurrentCueIndex = i
  NextCueIndex = math.min(i + 1, MaxCues)
  cue.state = "firing"
  RefreshCueButtonColor(i)
  pcall(function()
    Controls.StatusStateText.String = "Firing"
    Controls.StatusLed.Color = StateColors.firing
  end)

  local errors = {}
  for a = 1, MaxActions do
    local act = cue.actions[a]
    if act.type ~= "none" then
      local ok, err = DispatchAction(act)
      if not ok then
        table.insert(errors, string.format("Action %d (%s): %s", a, act.type, tostring(err)))
      end
    end
  end

  if #errors > 0 then
    cue.state = "error"
    SetError(string.format("Cue %d: %s", i, table.concat(errors, " | ")))
  else
    cue.state = cue.armed and "armed" or "idle"
    SetStatusMessage(string.format("Fired cue %d: %s", i, cue.name))
  end
  RefreshCueButtonColor(i)
  UpdateStatus(i)
  LogCueFire(i, #errors == 0)
end

OnCueButtonPressed = function(i)
  local cue = Cues[i]
  if not cue.confirm then
    FireCueNow(i)
    return
  end
  local now = os.clock()
  if PendingConfirm[i] and (now - PendingConfirm[i]) * 1000 <= CONFIRM_WINDOW_MS then
    PendingConfirm[i] = nil
    FireCueNow(i)
  else
    PendingConfirm[i] = now
    pcall(function()
      Controls.CueButton[i].Legend = string.format("%d: CONFIRM?", i)
      Controls.CueButton[i].Color = StateColors.error
    end)
    CallAfter(function()
      if PendingConfirm[i] == now then
        PendingConfirm[i] = nil
        RefreshCueButtonColor(i)
      end
    end, CONFIRM_WINDOW_MS / 1000)
  end
end

StopAllPlayers = function()
  local stopCtrl = Controls.GlobalStopControlName.String
  if stopCtrl == "" then stopCtrl = "stop" end
  local errors = {}
  for name, comp in pairs(ComponentCache) do
    if comp then
      local ok, err = pcall(function() comp[stopCtrl]:Trigger() end)
      if not ok then table.insert(errors, string.format("%s: %s", name, tostring(err))) end
    end
  end
  return errors
end

--=============================================================================
-- Optional: UDP target heartbeat via the Ping extension. This is a "nice to
-- have" per spec ("do not sacrifice reliability for these") so the whole
-- thing is pcall-wrapped and simply disables itself on any error.
--
-- ASSUMPTION (flagged per deliverable requirement): the exact Ping method
-- signature (Ping.New/:start/:setPingInterval/.EventHandler/.ErrorHandler,
-- including casing) could not be verified with full certainty for every
-- Designer version. Verify against the installed Designer's own Ping
-- documentation and adjust if this silently fails to populate target status.
--=============================================================================
StartPingHeartbeat = function()
  if NumUdp <= 0 then return end
  local pingTimer = Timer.New()
  local checkIdx = 1
  pingTimer.EventHandler = function()
    local i = checkIdx
    checkIdx = checkIdx + 1
    if checkIdx > NumUdp then checkIdx = 1 end
    local tgt = UdpTargets[i]
    if tgt.ip ~= "" then
      pcall(function()
        local p = Ping.New(tgt.ip)
        p.EventHandler = function()
          pcall(function() Controls.UdpTargetStatus[i].String = "Reachable" end)
        end
        p.ErrorHandler = function()
          pcall(function() Controls.UdpTargetStatus[i].String = "Unreachable" end)
        end
        p:start(true)
      end)
    end
  end
  pingTimer:Start(5)
end

--=============================================================================
-- Wire up EventHandlers
--=============================================================================
Controls.GoButton.EventHandler = function()
  OnCueButtonPressed(NextCueIndex)
end

Controls.StopAllButton.EventHandler = function()
  local errs = StopAllPlayers()
  if #errs > 0 then
    SetError("Stop-all errors: " .. table.concat(errs, " | "))
  else
    SetStatusMessage("All players stopped")
  end
end

Controls.PanicButton.EventHandler = function()
  local errs = StopAllPlayers()
  local payload = Controls.PanicUdpPayload.String
  if payload ~= "" then
    for i = 1, NumUdp do
      if UdpSockets[i] then
        local ok, err = pcall(function() UdpSockets[i]:Send(UdpTargets[i].ip, UdpTargets[i].port, payload) end)
        if not ok then table.insert(errs, string.format("UDP %s: %s", UdpTargets[i].name, tostring(err))) end
      end
    end
  end
  for i = 1, MaxCues do
    Cues[i].state = "idle"
    RefreshCueButtonColor(i)
  end
  if #errs > 0 then
    SetError("PANIC errors: " .. table.concat(errs, " | "))
  else
    SetStatusMessage("PANIC executed - safe state sent")
  end
end

Controls.LockToggle.EventHandler = function() end -- pure UI state; read directly where needed

Controls.ExportButton.EventHandler = function()
  local ok, encoded = pcall(rapidjson.encode, BuildShowTable())
  if ok then
    Controls.ExportData.String = encoded
  else
    Controls.ExportData.String = ""
    SetError("Export failed: " .. tostring(encoded))
  end
end

Controls.ImportButton.EventHandler = function()
  local raw = Controls.ImportData.String
  if raw == nil or raw == "" then
    Controls.ImportErrorText.String = "Import data is empty"
    return
  end
  local ok, data = pcall(rapidjson.decode, raw)
  if not ok then
    Controls.ImportErrorText.String = "Invalid JSON: " .. tostring(data)
    return
  end
  local valid, verr = ValidateShowTable(data)
  if not valid then
    Controls.ImportErrorText.String = "Import rejected: " .. tostring(verr)
    return
  end
  ApplyShowTable(data)
  Controls.ImportErrorText.String = ""
  MarkDirty()
  SaveShowData()
  RebuildComponentCache()
  dbg("Show imported successfully")
end

Controls.SelectedCue.EventHandler = function(ctl)
  if Loading then return end
  local numStr = ctl.String:match("^(%d+):")
  local i = tonumber(numStr)
  if i then SelectCue(i) end
end

Controls.CueEditName.EventHandler = function(ctl)
  if Loading then return end
  if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].name; return end
  Cues[SelectedCueIndex].name = ctl.String
  RefreshCueButtonColor(SelectedCueIndex)
  RefreshSelectedCueChoices()
  pcall(function() Controls.SelectedCue.String = string.format("%d: %s", SelectedCueIndex, ctl.String) end)
  MarkDirty(); SaveShowData()
end

Controls.CueEditNotes.EventHandler = function(ctl)
  if Loading then return end
  if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].notes; return end
  Cues[SelectedCueIndex].notes = ctl.String
  MarkDirty(); SaveShowData()
end

Controls.CueEditColor.EventHandler = function(ctl)
  if Loading then return end
  if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].color; return end
  Cues[SelectedCueIndex].color = ctl.String
  RefreshCueButtonColor(SelectedCueIndex)
  MarkDirty(); SaveShowData()
end

Controls.CueEditArm.EventHandler = function(ctl)
  if Loading then return end
  Cues[SelectedCueIndex].armed = ctl.Boolean
  RefreshCueButtonColor(SelectedCueIndex)
  MarkDirty(); SaveShowData()
end

Controls.CueEditConfirm.EventHandler = function(ctl)
  if Loading then return end
  Cues[SelectedCueIndex].confirm = ctl.Boolean
  MarkDirty(); SaveShowData()
end

Controls.AddActionButton.EventHandler = function()
  if Loading then return end
  if Controls.LockToggle.Boolean then return end
  local c = Cues[SelectedCueIndex]
  if c.activeActions < MaxActions then
    c.activeActions = c.activeActions + 1
    RefreshActionRowVisibility()
    MarkDirty(); SaveShowData()
  end
end

for i = 1, MaxCues do
  Cues[i] = {
    name = "Cue " .. i, notes = "", color = "#465261", armed = false, confirm = false,
    state = "idle", activeActions = 0, actions = {},
  }
  for a = 1, MaxActions do
    Cues[i].actions[a] = { type = "none", target = "", control = "", value = "" }
  end
  Controls.CueButton[i].EventHandler = function()
    OnCueButtonPressed(i)
  end
end

for a = 1, MaxActions do
  local slotIdx = a -- capture per-iteration value for the closures below

  pcall(function() Controls.ActionType[slotIdx].Choices = ActionTypes end)

  Controls.ActionType[slotIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].actions[slotIdx].type; return end
    Cues[SelectedCueIndex].actions[slotIdx].type = ClampActionType(ctl.String)
    RefreshActionTargetChoices(slotIdx)
    RefreshActionValueEditor(slotIdx)
    MarkDirty(); SaveShowData()
  end
  Controls.ActionTarget[slotIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].actions[slotIdx].target; return end
    Cues[SelectedCueIndex].actions[slotIdx].target = ctl.String
    RefreshActionControlChoices(slotIdx)
    RefreshActionValueEditor(slotIdx)
    MarkDirty(); SaveShowData()
  end
  Controls.ActionControl[slotIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].actions[slotIdx].control; return end
    Cues[SelectedCueIndex].actions[slotIdx].control = ctl.String
    RefreshActionValueEditor(slotIdx)
    MarkDirty(); SaveShowData()
  end
  Controls.ActionValue[slotIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = Cues[SelectedCueIndex].actions[slotIdx].value; return end
    Cues[SelectedCueIndex].actions[slotIdx].value = ctl.String
    MarkDirty(); SaveShowData()
  end
  Controls.ActionValueBool[slotIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then
      local mode, data = ParseValueSpec(Cues[SelectedCueIndex].actions[slotIdx].value)
      ctl.Boolean = (mode == "boolean" and data) or false
      return
    end
    Cues[SelectedCueIndex].actions[slotIdx].value = ctl.Boolean and "B:true" or "B:false"
    ctl.Legend = ctl.Boolean and "TRUE" or "FALSE"
    MarkDirty(); SaveShowData()
  end
  Controls.ActionRemove[slotIdx].EventHandler = function()
    if Loading then return end
    if Controls.LockToggle.Boolean then return end
    local c = Cues[SelectedCueIndex]
    for k = slotIdx, MaxActions - 1 do c.actions[k] = c.actions[k + 1] end
    c.actions[MaxActions] = { type = "none", target = "", control = "", value = "" }
    if c.activeActions > 0 then c.activeActions = c.activeActions - 1 end
    PushSelectedCueToEditor()
    MarkDirty(); SaveShowData()
  end
end

for i = 1, MaxDevices do
  Devices[i] = { name = "Device " .. i, component = "" }
  local devIdx = i -- capture

  Controls.DeviceName[devIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = Devices[devIdx].name; return end
    Devices[devIdx].name = ctl.String
    RefreshVisibleActionChoices()
    MarkDirty(); SaveShowData()
  end
  Controls.DeviceComponent[devIdx].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = Devices[devIdx].component; return end
    Devices[devIdx].component = ctl.String
    RebuildComponentCache()
    RefreshVisibleActionChoices()
    MarkDirty(); SaveShowData()
  end
end

for i = 1, NumUdp do
  UdpTargets[i] = { name = "Target " .. i, ip = "", port = 0 }

  Controls.UdpTargetName[i].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = UdpTargets[i].name; return end
    UdpTargets[i].name = ctl.String
    RefreshVisibleActionChoices()
    MarkDirty(); SaveShowData()
  end
  Controls.UdpTargetIp[i].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.String = UdpTargets[i].ip; return end
    UdpTargets[i].ip = ctl.String
    MarkDirty(); SaveShowData()
  end
  Controls.UdpTargetPort[i].EventHandler = function(ctl)
    if Loading then return end
    if Controls.LockToggle.Boolean then ctl.Value = UdpTargets[i].port; return end
    UdpTargets[i].port = math.floor(ctl.Value)
    MarkDirty(); SaveShowData()
  end
end

--=============================================================================
-- Init
--=============================================================================
Init = function()
  Loading = true

  local loaded = LoadShowData()
  if not loaded then
    for i = 1, MaxDevices do
      pcall(function()
        Controls.DeviceName[i].String = Devices[i].name
        Controls.DeviceComponent[i].String = Devices[i].component
      end)
    end
    for i = 1, NumUdp do PushUdpTargetToControls(i) end
    for i = 1, MaxCues do RefreshCueButtonColor(i) end
    RefreshSelectedCueChoices()
    SelectedCueIndex = 1
    PushSelectedCueToEditor()
    SaveShowData()
  end

  for i = 1, MaxDevices do
    pcall(function() Controls.DeviceComponent[i].Choices = AllComponentNameList() end)
  end

  RebuildComponentCache()
  for i = 1, NumUdp do OpenUdpSocket(i) end

  pcall(function()
    Controls.StatusStateText.String = "Ready"
    Controls.StatusText.String = "No cue fired yet"
    Controls.StatusLed.Color = StateColors.ready
    Controls.ErrorLed.Color = StateColors.neutral
    Controls.UnsavedLed.Color = StateColors.neutral
    if MaxCues >= 1 then
      Controls.NextCueText.String = string.format("Next: %d: %s", NextCueIndex, Cues[NextCueIndex].name)
    end
  end)

  StartPingHeartbeat()

  Loading = false
  dbg("Init complete: %d cues, %d actions/cue, %d devices, %d UDP targets", MaxCues, MaxActions, MaxDevices, NumUdp)
end

Init()

end -- if Controls then
