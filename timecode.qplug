-- Plugin for Q-Sys
-- Built in Lua
-- Simple timecode generator with transport controls

PluginInfo = {
    Name = "Q-Sys Community~Timecode Transport (1.0.0)",
    Version = "1.0.0",
    Id = "q-sys.community.timecode-transport.1.0.0",
    Description = "Simple timecode generator with play/stop and skip controls.",
    ShowDebug = false,
    Author = "Solo Works London"
}

local Colors = {
    White = {255, 255, 255},
    Black = {0, 0, 0},
    Red = {255, 0, 0},
    Green = {0, 255, 0}
}

local function hexToDec(hex)
    hex = string.upper(hex)
    local b1 = string.byte(string.sub(hex, 1, 1))
    local b2 = string.byte(string.sub(hex, 2, 2))
    return (b1 <= 57 and b1 - 48 or b1 - 55) * 16 + (b2 <= 57 and b2 - 48 or b2 - 55)
end

local function convertColor(hex)
    local t = {}
    t[1] = hexToDec(string.sub(hex, 2, 3))
    t[2] = hexToDec(string.sub(hex, 4, 5))
    t[3] = hexToDec(string.sub(hex, 6, 7))
    return t
end

local function setButtonLabel(control, label)
    if not control then
        return
    end
    if not pcall(function()
        control.String = label
    end) then
        pcall(function()
            control.Legend = label
        end)
    end
end

function GetProperties()
    local props = {
        {
            Name = "FrameRate",
            Type = "integer",
            Min = 1,
            Max = 60,
            Value = 30
        },
        {
            Name = "DropFrame",
            Type = "boolean",
            Value = false
        }
    }
    return props
end

function RectifyProperties(props)
    return props
end

function GetPrettyName(props)
    return "Timecode Transport (" .. tostring(props.FrameRate.Value) .. " fps)"
end

function GetColor(props)
    return convertColor("#cccccc")
end

