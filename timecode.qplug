function GetPins(props)
    local pins = {}
    table.insert(pins, {
        Name = "Audio Output 1",
        Direction = "output"
    })
    table.insert(pins, {
        Name = "Audio Output 2",
        Direction = "output"
    })
    return pins
end

function GetComponents(props)
    local components = {}
    table.insert(components, {
        Name = "audio_player",
        Type = "audio_player"
    })
    return components
end

function GetWiring(props)
    local wiring = {}
    table.insert(wiring, {"audio_player Output 1", "Audio Output 1"})
    table.insert(wiring, {"audio_player Output 2", "Audio Output 2"})
    return wiring
end

local totalFrames = 0
local framesPerSecond = 30
local dropFrameEnabled = false
local running = false
local tickTimer = nil

local function clampFrames(value)
    if value < 0 then
        return 0
    end
    return value
end

local function formatDropFrame(frames, fps)
    local dropFrames = fps == 60 and 4 or 2
    local framesPerHour = fps * 60 * 60
    local framesPer24Hours = framesPerHour * 24
    local framesPer10Minutes = fps * 60 * 10
    local framesPerMinute = fps * 60

    local frameNumber = frames % framesPer24Hours
    local d = math.floor(frameNumber / framesPer10Minutes)
    local m = frameNumber % framesPer10Minutes
    local dropped = dropFrames * 9 * d
        + dropFrames * math.floor(math.max(0, m - dropFrames) / (framesPerMinute - dropFrames))
    frameNumber = frameNumber + dropped

    local hours = math.floor(frameNumber / framesPerHour) % 24
    local minutes = math.floor((frameNumber % framesPerHour) / framesPerMinute)
    local seconds = math.floor((frameNumber % framesPerMinute) / fps)
    local frame = frameNumber % fps

    return string.format("%02d:%02d:%02d;%02d", hours, minutes, seconds, frame)
end

local function formatTimecode(frames, fps, dropFrame)
    local fpsValue = math.max(1, fps)
    if dropFrame and (fpsValue == 30 or fpsValue == 60) then
        return formatDropFrame(frames, fpsValue)
    end
    local framesPerHour = fpsValue * 3600
    local framesPerMinute = fpsValue * 60

    local hours = math.floor(frames / framesPerHour) % 24
    local minutes = math.floor((frames % framesPerHour) / framesPerMinute)
    local seconds = math.floor((frames % framesPerMinute) / fpsValue)
    local frame = frames % fpsValue

    return string.format("%02d:%02d:%02d:%02d", hours, minutes, seconds, frame)
end

local function pushTimecode()
    local tc = formatTimecode(totalFrames, framesPerSecond, dropFrameEnabled)
    Controls.TimecodeDisplay.String = tc
    Controls.TimecodeOut.String = tc
end

local function getActualFrameRate()
    if dropFrameEnabled and (framesPerSecond == 30 or framesPerSecond == 60) then
        return framesPerSecond * 1000 / 1001
    end
    return framesPerSecond
end

local function getAudioPlayer()
    if not Components then
        return nil
    end
    return Components.audio_player or Components["audio_player"]
end

local function setComponentString(component, name, value)
    if not component or not component.Controls or not component.Controls[name] then
        return
    end
    local ctl = component.Controls[name]
    pcall(function()
        ctl.String = value
    end)
end

local function setComponentNumber(component, name, value)
    if not component or not component.Controls or not component.Controls[name] then
        return
    end
    local ctl = component.Controls[name]
    if not pcall(function()
        ctl.Value = value
    end) then
        pcall(function()
            ctl.Float = value
        end)
    end
end

local function setComponentBoolean(component, name, value)
    if not component or not component.Controls or not component.Controls[name] then
        return
    end
    local ctl = component.Controls[name]
    pcall(function()
        ctl.Boolean = value
    end)
end

local function triggerComponent(component, name)
    if not component or not component.Controls or not component.Controls[name] then
        return
    end
    local ctl = component.Controls[name]
    if ctl.Trigger then
        pcall(function()
            ctl:Trigger()
        end)
        return
    end
    pcall(function()
        ctl.Boolean = true
    end)
end

local function syncAudioToTimecode()
    local player = getAudioPlayer()
    if not player then
        return
    end
    local seconds = totalFrames / getActualFrameRate()
    setComponentNumber(player, "Position", seconds)
    setComponentNumber(player, "Seek", seconds)
end

local function startTimer()
    if tickTimer then
        tickTimer:Stop()
    end
    tickTimer = Timer.New()
    tickTimer.EventHandler = function()
        if running then
            totalFrames = totalFrames + 1
            pushTimecode()
        end
    end
    tickTimer:Start(1 / getActualFrameRate())
end

local function applyFrameRate(newRate)
    framesPerSecond = math.max(1, math.floor(newRate))
    startTimer()
    pushTimecode()
end

local function updatePlayLabel()
    local label = running and "PAUSE" or "PLAY"
    setButtonLabel(Controls.Play, label)
end

local function applyDropFrame(newValue)
    dropFrameEnabled = newValue == true
    startTimer()
    pushTimecode()
end

local function applyAudioSettings()
    local player = getAudioPlayer()
    if not player then
        return
    end
    setComponentString(player, "Root", Controls.Root.String)
    setComponentString(player, "Directory", Controls.Directory.String)
    setComponentString(player, "File", Controls.File.String)
    setComponentNumber(player, "Gain", Controls.Gain.Value)
    setComponentBoolean(player, "Mute", Controls.Mute.Boolean)
end

local function setAudioPlayState(isPlaying)
    local player = getAudioPlayer()
    if not player then
        return
    end
    if isPlaying then
        syncAudioToTimecode()
        triggerComponent(player, "Play")
    else
        if player.Controls and player.Controls["Pause"] then
            triggerComponent(player, "Pause")
        else
            triggerComponent(player, "Stop")
        end
    end
end

if Controls then
    applyFrameRate(Properties.FrameRate.Value)
    applyDropFrame(Properties.DropFrame.Value)
    setButtonLabel(Controls.Stop, "STOP")
    setButtonLabel(Controls.SkipBack30, "-30")
    setButtonLabel(Controls.SkipForward30, "+30")
    setButtonLabel(Controls.Mute, "MUTE")
    updatePlayLabel()
    applyAudioSettings()

    Controls.Play.EventHandler = function(ctrl)
        running = ctrl.Boolean
        if running then
            startTimer()
        end
        updatePlayLabel()
        setAudioPlayState(running)
    end

    Controls.Stop.EventHandler = function()
        running = false
        totalFrames = 0
        Controls.Play.Boolean = false
        updatePlayLabel()
        setAudioPlayState(false)
        syncAudioToTimecode()
        pushTimecode()
    end

    Controls.SkipBack30.EventHandler = function()
        totalFrames = clampFrames(totalFrames - (framesPerSecond * 30))
        syncAudioToTimecode()
        pushTimecode()
    end

    Controls.SkipForward30.EventHandler = function()
        totalFrames = totalFrames + (framesPerSecond * 30)
        syncAudioToTimecode()
        pushTimecode()
    end

    Controls.Root.EventHandler = function(ctrl)
        local player = getAudioPlayer()
        setComponentString(player, "Root", ctrl.String)
    end

    Controls.Directory.EventHandler = function(ctrl)
        local player = getAudioPlayer()
        setComponentString(player, "Directory", ctrl.String)
    end

    Controls.File.EventHandler = function(ctrl)
        local player = getAudioPlayer()
        setComponentString(player, "File", ctrl.String)
        syncAudioToTimecode()
    end

    Controls.Gain.EventHandler = function(ctrl)
        local player = getAudioPlayer()
        setComponentNumber(player, "Gain", ctrl.Value)
    end

    Controls.Mute.EventHandler = function(ctrl)
        local player = getAudioPlayer()
        setComponentBoolean(player, "Mute", ctrl.Boolean)
    end

    Properties.FrameRate.EventHandler = function()
        applyFrameRate(Properties.FrameRate.Value)
    end

    Properties.DropFrame.EventHandler = function()
        applyDropFrame(Properties.DropFrame.Value)
    end

    pushTimecode()
end
